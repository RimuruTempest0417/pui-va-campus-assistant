<view
  class="pv-btn pv-btn--{{type}} pv-btn--{{size}} {{block ? 'is-block' : ''}} {{disabled ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}} {{pressed ? 'is-pressed' : ''}}"
  style="{{customStyle}}"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchEnd"
  bindtap="onTap"
>
  <view wx:if="{{loading}}" class="pv-btn__spinner" />
  <slot />
</view>
