<view
  class="pv-btn pv-btn--{{type}} pv-btn--{{size}} {{block ? 'is-block' : ''}} {{disabled ? 'is-disabled' : ''}} {{loading ? 'is-loading' : ''}}"
  style="{{customStyle}}"
  bindtap="onTap"
  hover-class="is-pressed"
  hover-start-time="0"
  hover-stay-time="90"
>
  <view wx:if="{{loading}}" class="pv-btn__spinner" />
  <slot />
</view>
