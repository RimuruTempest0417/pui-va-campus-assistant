@import "../../styles/tokens.wxss";

.pv-btn {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--pv-r);
  font-weight: 600;
  letter-spacing: -0.2rpx;
  transition: transform var(--pv-dur-fast) var(--pv-ease), opacity var(--pv-dur-fast) var(--pv-ease);
}
/* 尺寸：44pt 是最小可點區域 */
.pv-btn--lg { height: 112rpx; padding: 0 var(--pv-sp-5); font-size: var(--pv-fs-headline); }
.pv-btn--md { height: 88rpx; padding: 0 var(--pv-sp-4); font-size: var(--pv-fs-headline); }
.pv-btn--sm { height: 68rpx; padding: 0 var(--pv-sp-3); font-size: var(--pv-fs-subhead); border-radius: var(--pv-r-sm); }
.is-block { display: flex; width: 100%; }

/* 按下：立刻縮一下（原則 1 即時回饋，不等 release） */
.is-pressed { transform: scale(0.97); opacity: 0.86; }

.pv-btn--filled { background: var(--pv-tint); color: #ffffff; }
.pv-btn--tinted { background: var(--pv-tint-soft); color: var(--pv-tint); }
.pv-btn--plain { background: transparent; color: var(--pv-tint); }
.pv-btn--destructive { background: transparent; color: var(--pv-danger); }

.is-disabled { opacity: 0.35; }
.is-loading { opacity: 0.7; }
.pv-btn__spinner {
  width: 30rpx;
  height: 30rpx;
  margin-right: var(--pv-sp-1);
  border: 4rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: pv-spin 0.7s linear infinite;
}
@keyframes pv-spin { to { transform: rotate(360deg); } }
