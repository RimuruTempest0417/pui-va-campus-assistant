@import "../../styles/tokens.wxss";

.pv-avatar { border-radius: 50%; flex-shrink: 0; }
.pv-avatar--sm { width: 56rpx; height: 56rpx; }
.pv-avatar--md { width: 88rpx; height: 88rpx; }
.pv-avatar--lg { width: 128rpx; height: 128rpx; }
.pv-avatar--text {
  display: flex; align-items: center; justify-content: center;
  background: var(--pv-tint-soft); color: var(--pv-tint);
  font-size: var(--pv-fs-callout); font-weight: 600;
}
