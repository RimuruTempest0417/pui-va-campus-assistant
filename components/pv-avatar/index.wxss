@import "../../styles/tokens.wxss";

.pv-avatar { border-radius: 50%; flex-shrink: 0; }
.pv-avatar--sm { width: 48rpx; height: 48rpx; }
.pv-avatar--md { width: 72rpx; height: 72rpx; }
.pv-avatar--lg { width: 112rpx; height: 112rpx; }
.pv-avatar--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pv-primary-soft);
  color: var(--pv-primary);
  font-size: var(--pv-fs-body);
  font-weight: 600;
}
