@import "../../styles/tokens.wxss";

.pv-sk { display: flex; flex-direction: row; padding: var(--pv-sp-3); }
.pv-sk__avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--pv-fill-2); margin-right: var(--pv-sp-2);
  animation: pv-pulse 1.6s var(--pv-ease) infinite;
}
.pv-sk__lines { flex: 1; display: flex; flex-direction: column; }
.pv-sk__line {
  height: 28rpx; border-radius: var(--pv-r-sm);
  background: var(--pv-fill-2); margin-bottom: var(--pv-sp-2);
  animation: pv-pulse 1.6s var(--pv-ease) infinite;
}
@keyframes pv-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
