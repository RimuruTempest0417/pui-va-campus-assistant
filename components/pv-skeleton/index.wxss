@import "../../styles/tokens.wxss";

.pv-sk { display: flex; flex-direction: row; padding: var(--pv-sp-3); }
.pv-sk__avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #e8efeb; margin-right: var(--pv-sp-2); }
.pv-sk__lines { flex: 1; display: flex; flex-direction: column; }
.pv-sk__line { height: 28rpx; border-radius: 8rpx; background: #e8efeb; margin-bottom: var(--pv-sp-2); }
