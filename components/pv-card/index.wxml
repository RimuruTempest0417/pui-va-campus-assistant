<view class="pv-card {{tapable ? 'is-tapable' : ''}}" bindtap="onTap" hover-class="{{tapable ? 'pv-card--hover' : 'none'}}">
  <view wx:if="{{title || extra}}" class="pv-card__head">
    <text class="pv-card__title">{{title}}</text>
    <text wx:if="{{extra}}" class="pv-card__extra">{{extra}}</text>
  </view>
  <view class="pv-card__body {{padded ? 'is-padded' : ''}}">
    <slot />
  </view>
  <view wx:if="{{title || extra}}" class="pv-card__foot">
    <slot name="footer" />
  </view>
</view>
