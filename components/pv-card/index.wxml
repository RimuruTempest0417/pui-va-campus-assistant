<view class="pv-card">
  <view wx:if="{{title || extra}}" class="pv-card__head">
    <text class="pv-card__title">{{title}}</text>
    <text wx:if="{{extra}}" class="pv-card__extra">{{extra}}</text>
  </view>
  <view class="pv-card__body {{padded ? 'is-padded' : ''}}" bindtap="onTap" hover-class="{{tapable ? 'is-pressed' : 'none'}}" hover-start-time="0">
    <slot />
  </view>
</view>
