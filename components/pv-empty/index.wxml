<view class="pv-empty">
  <view class="pv-empty__mark pv-empty__mark--{{tone || autoTone}}">
    <view class="pv-empty__ring" />
    <view class="pv-empty__notch" />
  </view>
  <text class="pv-empty__title">{{title}}</text>
  <text wx:if="{{desc}}" class="pv-empty__desc">{{desc}}</text>
  <view class="pv-empty__action"><slot /></view>
</view>
