@import "../../styles/tokens.wxss";

/* iOS UISegmentedControl：灰底膠囊 + 白色浮起的選中塊 */
.pv-seg {
  display: flex;
  flex-direction: row;
  background: var(--pv-fill);
  border-radius: var(--pv-r-sm);
  padding: 4rpx;
}
.pv-seg__item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 8rpx;
  font-size: var(--pv-fs-subhead);
  color: var(--pv-label);
  transition: background var(--pv-dur-fast) var(--pv-ease);
}
.pv-seg__item.is-active {
  background: var(--pv-surface);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.pv-seg__item.is-pressed { opacity: 0.7; }
.pv-seg__badge {
  margin-left: 6rpx; min-width: 26rpx; height: 26rpx; border-radius: var(--pv-r-pill);
  background: var(--pv-brand); color: #fff; font-size: 18rpx;
  display: flex; align-items: center; justify-content: center; padding: 0 6rpx;
}
