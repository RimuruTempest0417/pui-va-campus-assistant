/* 共用 UI：列表卡、表單、底部操作列。引用時先 import tokens 再 import 這支 */
.ui-page { min-height: 100vh; background: var(--pv-bg); padding: 0 var(--pv-sp-3); box-sizing: border-box; }
.ui-page--withbar { padding-bottom: 260rpx; }

/* 離線資料橫幅（W-98）：畫面用的是上次成功的資料時一定要出現，
   寫明「上次更新於 X」；不顯示它就等於靜默降級。 */
.ui-offline {
  margin: 0 0 var(--pv-sp-2);
  padding: 12rpx var(--pv-sp-2);
  background: var(--pv-warning-soft);
  color: var(--pv-warning);
  border-radius: var(--pv-r-sm);
  font-size: var(--pv-fs-caption-1);
  letter-spacing: var(--pv-ls-caption);
}

.ui-list { margin-top: var(--pv-sp-2); }

/* inset grouped 清單（v0.57.0 起的標準做法）：整份是「一張卡」，列與列之間用 1rpx 髮絲線分隔，
   不要每一列各一張卡 —— 那是「卡片堆疊」最明顯的來源。
   用法：<view class="ui-list ui-list--grouped"> 內放 <view class="ui-card ui-card--row">，
   最後一列再加 ui-card--last（去掉最後一條線）。 */
.ui-list--grouped { background: var(--pv-surface); border-radius: var(--pv-r-lg); overflow: hidden; }
.ui-list--grouped .ui-card--row { margin: 0; border-radius: 0; background: transparent; box-shadow: none; border-bottom: 1rpx solid var(--pv-sep); }
.ui-list--grouped .ui-card--last { border-bottom: 0; }
.ui-list--grouped .signup-row { padding: 20rpx var(--pv-sp-3); }
.ui-list--grouped .signup-row--last { border-bottom: 0; }
.ui-card {
  background: var(--pv-surface);
  border-radius: var(--pv-r-lg);
  padding: var(--pv-sp-3);
  margin-bottom: var(--pv-sp-2);
  transition: transform var(--pv-dur-release) var(--pv-ease);
}
.ui-card--pressed { transform: scale(0.985); transition-duration: var(--pv-dur-press); }

.ui-row { display: flex; flex-direction: row; align-items: center;   gap: var(--pv-sp-2);
  flex-wrap: wrap;
}
.ui-row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }

/* 資訊列（設定頁、家長頁共用）：標題＋說明在左、箭頭在右。
   原本只寫在 pages/settings/index.wxss，家長頁也用了同一組 class 卻沒有樣式
   （箭頭掉到標題下面、整列看不出可以點）—— 這一組是共用的，只能有一份來源。 */
.set-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: var(--pv-sp-2) 0; }
.set-row__main { flex: 1; min-width: 0; }
.set-row__title { display: block; font-size: var(--pv-fs-callout); color: var(--pv-label); }
.set-row__sub { display: block; margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
.set-row__value { font-size: var(--pv-fs-callout); color: var(--pv-label-2); }
.set-row__chev { font-size: var(--pv-fs-title-3); color: var(--pv-label-4); flex-shrink: 0; }
/* 同一張卡裡的多列：用髮絲線分隔，不要每列一張卡 */
.set-row--sep { border-top: 1rpx solid var(--pv-sep); }
.ui-gap-1 { margin-right: var(--pv-sp-1); }
.ui-gap-2 { margin-right: var(--pv-sp-2); }
.ui-mt-2 { margin-top: var(--pv-sp-2); }
.ui-mt-3 { margin-top: var(--pv-sp-3); }

.ui-title { font-size: var(--pv-fs-callout); font-weight: 600; letter-spacing: var(--pv-ls-body); }
.ui-body { font-size: var(--pv-fs-body); letter-spacing: var(--pv-ls-body); line-height: 1.45; }
.ui-sub { font-size: var(--pv-fs-subhead); color: var(--pv-label-2); }
.ui-meta { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

/* 卡片內的區段標題（iOS section header）：13pt 次級灰 ＋ 微字距。
   和 `.pv-group-title` 同一組規格，只差在「沒有上下 padding」——
   頁面級用 pv-group-title（tokens.wxss），卡片內用這裡，位置由呼叫端用 ui-mt-* 決定。
   字級／顏色／字距只有一份：--pv-fs-footnote／--pv-label-2／--pv-ls-section。 */
.ui-section {
  display: block;
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  letter-spacing: var(--pv-ls-section);
}
/* 會被拿來比大小的數字（統計值、名額、評分、代碼）：等寬數字，小數點與位數才對得齊。
   唯一來源；頁面 wxss 不得再寫 font-variant-numeric（check-project 第 20 條擋）。 */
.ui-num { font-variant-numeric: tabular-nums; }

.ui-thumb {
  width: 132rpx; height: 132rpx; border-radius: var(--pv-r-sm);
  background: var(--pv-fill); flex-shrink: 0;
}
.ui-thumbs { display: flex; flex-direction: row; flex-wrap: wrap; }
.ui-thumb-item { position: relative; margin-right: var(--pv-sp-2); margin-bottom: var(--pv-sp-2); }
.ui-thumb-del {
  position: absolute; top: -8rpx; right: -8rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: var(--pv-overlay); color: var(--pv-on-tint);
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
}
.ui-thumb-add {
  width: 132rpx; height: 132rpx; border-radius: var(--pv-r-sm);
  border: 2rpx dashed var(--pv-sep);
  display: flex; align-items: center; justify-content: center;
  color: var(--pv-label-3); font-size: 40rpx; margin-bottom: var(--pv-sp-2);
}

/* 表單 */
.ui-field { padding: var(--pv-sp-2) 0; border-bottom: 1rpx solid var(--pv-sep); }
.ui-field:last-child { border-bottom: none; }
.ui-field__label { display: block; font-size: var(--pv-fs-footnote); color: var(--pv-label-2); letter-spacing: var(--pv-ls-section); margin-bottom: 6rpx; }
.ui-input {
  font-size: var(--pv-fs-body); color: var(--pv-label);
  min-height: 64rpx; line-height: 64rpx;
}
.ui-textarea { font-size: var(--pv-fs-body); color: var(--pv-label); width: 100%; min-height: 160rpx; line-height: 1.45; }
.ui-placeholder { color: var(--pv-label-3); }

/* 底部固定操作列（含安全區） */
.ui-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: var(--pv-bar);
  border-top: 1rpx solid var(--pv-sep);
  padding: var(--pv-sp-2) var(--pv-sp-3) calc(var(--pv-sp-2) + env(safe-area-inset-bottom));
  display: flex; flex-direction: row; align-items: center;
  z-index: 50;
}
.ui-bar__hint { flex: 1; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
