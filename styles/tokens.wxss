/* ============================================================
   培華校園助手 · design tokens v2（Apple HIG 風格）
   主題色為培華紫 #6D3FC4（互動色）；培華紅 #C8102E 保留給校徽識別與緊急；藍綠僅作校徽紋樣點綴
   字級/間距/圓角對照 Apple Human Interface Guidelines（pt → rpx，1pt ≈ 2rpx）
   規則：頁面與組件只准用這些變數，不要寫死色值
   ============================================================ */
page {
  /* ── 品牌與語意色 ───────────────────────── */
  --pv-tint: #6d3fc4;               /* 培華紫：學校主題色，主要動作與連結（白字對比 6.65:1） */
  --pv-tint-pressed: #5a31a6;
  --pv-tint-soft: #f0eafb;
  --pv-brand: #c8102e;              /* 培華紅：校徽用色，保留給身份識別與緊急 */
  --pv-brand-strong: #a00d24;       /* 培華紅深階：緊急公告／破壞性操作文字（後台統計卡已改中性，W-49） */
  --pv-brand-soft: #fcebec;
  --pv-danger: #d70015;             /* iOS systemRed：破壞性操作 */
  --pv-warning: #b25000;            /* iOS systemOrange（深） */
  --pv-warning-soft: #fff3e0;
  --pv-success: #248a3d;            /* iOS systemGreen（深） */
  --pv-success-soft: #e9f7ec;
  --pv-accent: #e0a100;             /* 星評琥珀：只給評分星形字元，不當文字色（白底 2.6:1） */

  /* ── 文字與中性（iOS label / fill 階層）──── */
  --pv-label: #000000;
  --pv-label-2: rgba(60, 60, 67, 0.6);   /* secondaryLabel */
  --pv-label-3: rgba(60, 60, 67, 0.3);   /* tertiaryLabel */
  --pv-label-4: rgba(60, 60, 67, 0.18);  /* quaternaryLabel：月曆非本月日期 */
  --pv-sep: rgba(60, 60, 67, 0.29);      /* separator */
  --pv-fill: rgba(120, 120, 128, 0.12);  /* systemFill（分段控制底） */
  --pv-fill-2: rgba(120, 120, 128, 0.16);
  --pv-bg: #f2f2f7;                      /* systemGroupedBackground */
  --pv-surface: #ffffff;                 /* secondarySystemGroupedBackground */
  --pv-bar: rgba(249, 249, 249, 0.86);   /* 半透明導航列（近似 material） */

  /* ── 疊加層與前景色（紫／紅底上的白字、遮罩、陰影）── */
  --pv-on-tint: #ffffff;                 /* 紫／紅實心底上的文字與圖示 */
  --pv-on-tint-2: rgba(255, 255, 255, 0.75);   /* 同上但次要（箭頭、圓點） */
  --pv-on-tint-line: rgba(255, 255, 255, 0.45); /* 白字按鈕的轉圈指示環 */
  --pv-scrim: rgba(0, 0, 0, 0.28);       /* 彈層遮罩 */
  --pv-overlay: rgba(0, 0, 0, 0.65);     /* 縮圖刪除鈕等深色圓底 */
  --pv-shadow: rgba(0, 0, 0, 0.12);      /* 分段控制選中項浮起 */
  --pv-shadow-tint: rgba(109, 63, 196, 0.32); /* 懸浮按鈕的紫暈 */

  /* ── 字級（Apple 字階）──────────────────── */
  --pv-fs-large-title: 68rpx; /* 34pt */
  --pv-fs-title-1: 56rpx;     /* 28pt */
  --pv-fs-title-2: 44rpx;     /* 22pt */
  --pv-fs-title-3: 40rpx;     /* 20pt */
  --pv-fs-headline: 34rpx;    /* 17pt semibold */
  --pv-fs-body: 34rpx;        /* 17pt */
  --pv-fs-callout: 32rpx;     /* 16pt */
  --pv-fs-subhead: 30rpx;     /* 15pt */
  --pv-fs-footnote: 26rpx;    /* 13pt */
  --pv-fs-caption-1: 24rpx;   /* 12pt */
  --pv-fs-caption-2: 22rpx;   /* 11pt */

  /* 字距：隨字級變化（大標題收緊、小字放寬） */
  --pv-ls-large-title: -1.2rpx;
  --pv-ls-title: -0.6rpx;
  --pv-ls-body: -0.2rpx;
  --pv-ls-caption: 0.2rpx;
  --pv-ls-section: 0.5rpx;   /* 區段標題（13pt）≈ 0.02em：小字放寬一點才不會擠成一團 */

  /* ── 間距（4pt 網格 → 8rpx 基準）────────── */
  --pv-sp-1: 8rpx;
  --pv-sp-2: 16rpx;
  --pv-sp-3: 24rpx;
  --pv-sp-4: 32rpx;
  --pv-sp-5: 40rpx;
  --pv-sp-6: 56rpx;

  /* ── 圓角（Apple 常用 10/14pt）──────────── */
  --pv-r-sm: 12rpx;
  --pv-r: 20rpx;
  --pv-r-lg: 20rpx;
  --pv-r-pill: 999rpx;

  /* ── 動效（iOS 彈簧曲線的 CSS 近似）──────── */
  --pv-ease: cubic-bezier(0.32, 0.72, 0, 1);
  --pv-ease-out: cubic-bezier(0.2, 0.9, 0.25, 1);
  --pv-dur: 320ms;
  --pv-dur-fast: 140ms;
  --pv-dur-press: 60ms;   /* 按下：要「立刻」看到反應，所以很短 */
  --pv-dur-release: 180ms; /* 放開：帶一點回彈感，但不要拖 */

  background: var(--pv-bg);
  color: var(--pv-label);
  font-family: -apple-system, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--pv-fs-body);
  letter-spacing: var(--pv-ls-body);
  line-height: 1.35;
}

/* ── 通用排版與容器 ─────────────────────── */
.pv-page { min-height: 100vh; background: var(--pv-bg); padding: var(--pv-sp-3) var(--pv-sp-3) var(--pv-sp-6); box-sizing: border-box; }
.pv-large-title { font-size: var(--pv-fs-large-title); font-weight: 700; letter-spacing: var(--pv-ls-large-title); line-height: 1.1; }
.pv-title { font-size: var(--pv-fs-title-2); font-weight: 600; letter-spacing: var(--pv-ls-title); line-height: 1.2; }
.pv-group-title {                     /* iOS 列表的分組標題（頁面級；卡片內用 .ui-section） */
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  padding: var(--pv-sp-3) var(--pv-sp-2) var(--pv-sp-1);
  letter-spacing: var(--pv-ls-section);
}
.pv-footnote { font-size: var(--pv-fs-footnote); color: var(--pv-label-2); line-height: 1.4; }
.pv-caption { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); letter-spacing: var(--pv-ls-caption); }
.pv-row { display: flex; flex-direction: row; align-items: center; }
.pv-row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }

/* 註：WXSS 不支援萬用選擇器 `*`（編譯會報 unexpected token），
   而 @media (prefers-reduced-motion) 在目前版本的 wxss 編譯器行為未確認，
   因此減少動態改在各組件用具體 class 處理，見 docs/04-設計規範.md「已知偏離」。
*/

/* ── 全站滾動容器（Skyline 下用 scroll-view 才穩定，bounces 提供回彈）── */
.page-root { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.page-scroll { flex: 1; min-height: 0; box-sizing: border-box; }

/* ============================================================
   深色模式（W-21）：只在頁面根節點加上 .theme-dark 時覆寫顏色
   由 utils/appearance.js 決定（跟隨系統／淺色／深色），
   因為 Skyline 對 prefers-color-scheme 支援不穩定，用 class 最可靠。
   對比度：白字 on #1c1c1e ≈ 15.8:1；#9d7ce0 on #1c1c1e ≈ 4.9:1
   ============================================================ */
.theme-light,
.theme-dark {
  /* 根節點同時給文字色：沒寫 color 的節點才不會在深色下繼承成黑色（實機發現） */
  color: var(--pv-label);
}

.theme-dark {
  --pv-tint: #9d7ce0;
  --pv-tint-pressed: #b39aeb;
  --pv-tint-soft: rgba(109, 63, 196, 0.24);
  --pv-brand-soft: rgba(200, 16, 46, 0.18);
  --pv-danger: #ff6961;
  --pv-warning: #ffb340;
  --pv-warning-soft: rgba(178, 80, 0, 0.22);
  --pv-success: #4cd964;
  --pv-success-soft: rgba(36, 138, 61, 0.22);

  --pv-label: #ffffff;
  --pv-label-2: rgba(235, 235, 245, 0.62);
  --pv-label-3: rgba(235, 235, 245, 0.52);   /* 3.4→4.8:1：三級文字在深色底也要過 4.5 */
  --pv-label-4: rgba(235, 235, 245, 0.20);
  --pv-sep: rgba(84, 84, 88, 0.65);
  --pv-fill: rgba(120, 120, 128, 0.36);
  --pv-fill-2: rgba(120, 120, 128, 0.46);
  --pv-bg: #000000;
  --pv-surface: #1c1c1e;
  --pv-bar: rgba(28, 28, 30, 0.88);
  --pv-shadow: rgba(0, 0, 0, 0.55);

  /* 疊加層與品牌色（深色下調整亮度，白字仍要清楚） */
  --pv-on-tint: #ffffff;
  --pv-on-tint-2: rgba(255, 255, 255, 0.80);
  --pv-on-tint-line: rgba(255, 255, 255, 0.45);
  --pv-scrim: rgba(0, 0, 0, 0.60);
  --pv-overlay: rgba(0, 0, 0, 0.72);
  --pv-shadow-tint: rgba(109, 63, 196, 0.45);
  --pv-brand: #c8102e;            /* 校徽紅不變：身份識別色不隨外觀漂移 */
  --pv-brand-strong: #a00d24;
  --pv-accent: #e0a100;
}
