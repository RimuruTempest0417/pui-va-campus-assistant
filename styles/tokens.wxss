/* ============================================================
   培華校園助手 · design tokens v2（Apple HIG 風格）
   主題色為培華紫 #6D3FC4（互動色）；培華紅 #C8102E 保留給校徽識別與緊急；藍綠僅作校徽紋樣點綴
   字級/間距/圓角對照 Apple Human Interface Guidelines（pt → rpx，1pt ≈ 2rpx）
   規則：頁面與組件只准用這些變數，不要寫死色值
   ============================================================ */
page {
  /* ── 品牌與語意色 ───────────────────────── */
  --pv-tint: #6d3fc4;               /* 培華紫：學校主題色，主要動作與連結（白字對比 6.65:1） */
  --pv-tint-pressed: #5a31a6;
  --pv-tint-soft: #f0eafb;
  --pv-brand: #c8102e;              /* 培華紅：校徽用色，保留給身份識別與緊急 */
  --pv-brand-soft: #fcebec;
  --pv-danger: #d70015;             /* iOS systemRed：破壞性操作 */
  --pv-warning: #b25000;            /* iOS systemOrange（深） */
  --pv-warning-soft: #fff3e0;
  --pv-success: #248a3d;            /* iOS systemGreen（深） */
  --pv-success-soft: #e9f7ec;

  /* ── 文字與中性（iOS label / fill 階層）──── */
  --pv-label: #000000;
  --pv-label-2: rgba(60, 60, 67, 0.6);   /* secondaryLabel */
  --pv-label-3: rgba(60, 60, 67, 0.3);   /* tertiaryLabel */
  --pv-sep: rgba(60, 60, 67, 0.29);      /* separator */
  --pv-fill: rgba(120, 120, 128, 0.12);  /* systemFill（分段控制底） */
  --pv-fill-2: rgba(120, 120, 128, 0.16);
  --pv-bg: #f2f2f7;                      /* systemGroupedBackground */
  --pv-surface: #ffffff;                 /* secondarySystemGroupedBackground */
  --pv-bar: rgba(249, 249, 249, 0.86);   /* 半透明導航列（近似 material） */

  /* ── 字級（Apple 字階）──────────────────── */
  --pv-fs-large-title: 68rpx; /* 34pt */
  --pv-fs-title-1: 56rpx;     /* 28pt */
  --pv-fs-title-2: 44rpx;     /* 22pt */
  --pv-fs-title-3: 40rpx;     /* 20pt */
  --pv-fs-headline: 34rpx;    /* 17pt semibold */
  --pv-fs-body: 34rpx;        /* 17pt */
  --pv-fs-callout: 32rpx;     /* 16pt */
  --pv-fs-subhead: 30rpx;     /* 15pt */
  --pv-fs-footnote: 26rpx;    /* 13pt */
  --pv-fs-caption-1: 24rpx;   /* 12pt */
  --pv-fs-caption-2: 22rpx;   /* 11pt */

  /* 字距：隨字級變化（大標題收緊、小字放寬） */
  --pv-ls-large-title: -1.2rpx;
  --pv-ls-title: -0.6rpx;
  --pv-ls-body: -0.2rpx;
  --pv-ls-caption: 0.2rpx;

  /* ── 間距（4pt 網格 → 8rpx 基準）────────── */
  --pv-sp-1: 8rpx;
  --pv-sp-2: 16rpx;
  --pv-sp-3: 24rpx;
  --pv-sp-4: 32rpx;
  --pv-sp-5: 40rpx;
  --pv-sp-6: 56rpx;

  /* ── 圓角（Apple 常用 10/14pt）──────────── */
  --pv-r-sm: 12rpx;
  --pv-r: 20rpx;
  --pv-r-lg: 28rpx;
  --pv-r-pill: 999rpx;

  /* ── 動效（iOS 彈簧曲線的 CSS 近似）──────── */
  --pv-ease: cubic-bezier(0.32, 0.72, 0, 1);
  --pv-ease-out: cubic-bezier(0.2, 0.9, 0.25, 1);
  --pv-dur: 320ms;
  --pv-dur-fast: 140ms;
  --pv-dur-press: 60ms;   /* 按下：要「立刻」看到反應，所以很短 */
  --pv-dur-release: 180ms; /* 放開：帶一點回彈感，但不要拖 */

  background: var(--pv-bg);
  color: var(--pv-label);
  font-family: -apple-system, "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--pv-fs-body);
  letter-spacing: var(--pv-ls-body);
  line-height: 1.35;
  -webkit-font-smoothing: antialiased;
}

/* ── 通用排版與容器 ─────────────────────── */
.pv-page { min-height: 100vh; padding: var(--pv-sp-3) var(--pv-sp-3) var(--pv-sp-6); box-sizing: border-box; }
.pv-large-title { font-size: var(--pv-fs-large-title); font-weight: 700; letter-spacing: var(--pv-ls-large-title); line-height: 1.1; }
.pv-title { font-size: var(--pv-fs-title-2); font-weight: 600; letter-spacing: var(--pv-ls-title); line-height: 1.2; }
.pv-group-title {                     /* iOS 列表的分組標題 */
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  text-transform: none;
  padding: var(--pv-sp-3) var(--pv-sp-2) var(--pv-sp-1);
  letter-spacing: var(--pv-ls-caption);
}
.pv-footnote { font-size: var(--pv-fs-footnote); color: var(--pv-label-2); line-height: 1.4; }
.pv-caption { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); letter-spacing: var(--pv-ls-caption); }
.pv-row { display: flex; flex-direction: row; align-items: center; }
.pv-row-between { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }

/* 註：WXSS 不支援萬用選擇器 `*`（編譯會報 unexpected token），
   而 @media (prefers-reduced-motion) 在目前版本的 wxss 編譯器行為未確認，
   因此減少動態改在各組件用具體 class 處理，見 docs/04-設計規範.md「已知偏離」。
*/

/* ── 全站滾動容器（Skyline 下用 scroll-view 才穩定，bounces 提供回彈）── */
.page-root { height: 100vh; display: flex; flex-direction: column; }
.page-scroll { flex: 1; height: 100vh; box-sizing: border-box; }
