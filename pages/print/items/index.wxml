<view class="print-page page-root theme-light">
  <pv-navbar title="{{L.title}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="print-inner">

      <view wx:if="{{!preview}}" class="toolbar">
        <view class="chips">
          <view wx:for="{{statusOptions}}" wx:key="key" class="chip {{status === item.key ? 'chip--on' : ''}}"
                data-key="{{item.key}}" bindtap="pickStatus">{{item.label}}</view>
        </view>
        <view class="toolbar__row">
          <text class="toolbar__meta">{{L.total}} {{rows.length}}{{L.countUnit}} · {{pages.length}}{{L.pageUnit}}</text>
          <view class="toolbar__btns">
            <pv-button size="sm" type="plain" bind:tap="togglePreview">{{L.preview}}</pv-button>
            <pv-button size="sm" type="tinted" bind:tap="copyTsv">{{L.copy}}</pv-button>
          </view>
        </view>
      </view>

      <view wx:if="{{preview}}" class="preview-bar" bindtap="togglePreview">
        <text class="preview-bar__text">{{L.exitPreview}}</text>
      </view>

      <block wx:if="{{loading}}">
        <view class="state-card"><pv-skeleton rows="4" /></view>
      </block>

      <block wx:elif="{{failed}}">
        <pv-empty icon="⚠️" title="{{L.failed}}" desc="{{errorText}}">
          <pv-button size="sm" type="tinted" bind:tap="retry">{{L.retry}}</pv-button>
        </pv-empty>
      </block>

      <block wx:elif="{{!rows.length}}">
        <pv-empty icon="🗒" title="{{L.empty}}" desc="{{L.emptySub}}" />
      </block>

      <block wx:else>
        <view wx:for="{{pages}}" wx:key="index" wx:for-item="pg" wx:for-index="pi" class="sheet"
              style="{{sheetH ? 'height: ' + sheetH + 'px;' : ''}}">
          <view class="sheet__head">
            <text class="sheet__title">{{L.sheetTitle}}</text>
            <text class="sheet__sub">{{statusLabel}}　{{L.printedAt}} {{dateText}}</text>
          </view>

          <view class="sheet__table">
            <view class="trow trow--head">
              <text class="c c--no">{{L.colNo}}</text>
              <text class="c c--item">{{L.colItem}}</text>
              <text class="c c--type">{{L.colType}}</text>
              <text class="c c--place">{{L.colPlace}}</text>
              <text class="c c--date">{{L.colDate}}</text>
              <text class="c c--status">{{L.colStatus}}</text>
            </view>
            <view wx:for="{{pg.rows}}" wx:key="no" wx:for-item="r" class="trow">
              <text class="c c--no">{{r.no}}</text>
              <text class="c c--item">{{r.title}}</text>
              <text class="c c--type">{{r.type}}</text>
              <text class="c c--place">{{r.place}}</text>
              <text class="c c--date">{{r.date}}</text>
              <text class="c c--status">{{r.status}}</text>
            </view>
          </view>

          <view class="sheet__foot">
            <text class="sheet__foot-text">{{L.footNote}}</text>
            <text class="sheet__foot-text">{{pg.index}} / {{pages.length}}</text>
          </view>
        </view>
      </block>

    </view>
  </scroll-view>
</view>
