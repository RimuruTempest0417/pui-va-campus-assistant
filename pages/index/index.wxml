<view class="home page-root">
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="home-inner" style="padding-top: {{navTotal}}px">
  <!-- 狀態列 + 頂部列（自訂導航）-->
  <view class="home__status" />
  <view class="home__top">
    <view class="home__brand">
      <text class="home__brand-name">{{L.brand || '培華校園助手'}}</text>
      <text class="home__brand-sub">PUI VA CAMPUS</text>
    </view>
    <view class="home__right">
      <pv-tag wx:if="{{isDemo}}" text="{{L.demoTag}}" type="tint" plain />
      <view class="home__avatar" bindtap="goAccount" hover-class="home__avatar--pressed" hover-start-time="0">
        <pv-avatar name="{{user.nickname || L.guest}}" size="sm" />
      </view>
    </view>
  </view>

  <!-- 大字問候 -->
  <view class="home__head">
    <text class="home__greeting">{{greeting}}，{{user.nickname || L.student}}</text>
    <text class="home__meta">{{today}} {{weekday}} · {{clock}}{{user.className ? ' · ' + user.className : ''}}</text>
  </view>

  <!-- 載入中 -->
  <block wx:if="{{loading}}">
    <pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card>
    <view class="home__sk-grid">
      <view class="home__sk-cell"><pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card></view>
      <view class="home__sk-cell"><pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card></view>
    </view>
  </block>

  <!-- 失敗 -->
  <pv-card wx:elif="{{failed}}">
    <pv-empty icon="⚠️" title="{{L.failed}}" desc="{{L.failedDesc}}：{{apiBaseText}}">
      <view class="home__retry" bindtap="onRetry">{{L.k01}}</view>
      <view class="home__retry home__retry--plain" bindtap="goDev">{{L.k02}}</view>
    </pv-empty>
  </pv-card>

  <block wx:else>
    <!-- 緊急公告 -->
    <view
      wx:if="{{urgent}}"
      class="urgent {{urgentPressed ? 'urgent--pressed' : ''}}"
      bindtouchstart="onUrgentTouchStart"
      bindtouchend="onUrgentTouchEnd"
      bindtouchcancel="onUrgentTouchEnd"
      bindtap="onTapUrgent"
    >
      <view class="urgent__left">
        <text class="urgent__badge">{{L.urgent}}</text>
        <text class="urgent__title">{{urgent.title}}</text>
      </view>
      <text class="urgent__arrow">›</text>
    </view>

    <!-- 四宮格 -->
    <view class="grid">
      <view
        wx:for="{{modules}}"
        wx:key="key"
        class="grid__cell {{pressedKey === item.key ? 'grid__cell--pressed' : ''}}"
        data-key="{{item.key}}"
        bindtouchstart="onCellTouchStart"
        bindtouchend="onCellTouchEnd"
        bindtouchcancel="onCellTouchEnd"
        bindtap="onTapModule"
      >
        <view class="grid__icon grid__icon--{{item.tone}}"><text>{{item.icon}}</text></view>
        <text class="grid__label">{{item.label}}</text>
        <text class="grid__sub">{{item.sub}}</text>
      </view>
    </view>

    <!-- 今日午餐 -->
    <view class="pv-group-title">{{L.k03}}</view>
    <pv-card>
      <block wx:if="{{lunch && lunch.length}}">
        <view wx:for="{{lunch}}" wx:key="id" class="dish">
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text class="dish__meta">{{item.ratingCount || 0}} 人評分 · 即讚 {{item.liked || 0}}</text>
          </view>
          <view class="dish__score">
            <text class="dish__score-num">{{item.avgScore || '—'}}</text>
            <text class="dish__score-unit">{{L.k04}}</text>
          </view>
        </view>
      </block>
      <pv-empty wx:else icon="🍽" title="{{L.k05}}" desc="{{L.k06}}" />
    </pv-card>

    <!-- 小賣部 -->
    <view wx:if="{{snack && snack.length}}" class="pv-group-title">{{L.k07}}</view>
    <pv-card wx:if="{{snack && snack.length}}">
      <view wx:for="{{snack}}" wx:key="id" class="dish dish--snack">
        <text class="dish__name">{{item.name}}</text>
        <text class="dish__price">MOP {{item.price}}</text>
      </view>
    </pv-card>

    <!-- 家長：我的子女（首頁直接切換，代報名在下一頁）-->
    <block wx:if="{{parentChildren.length}}">
      <view class="pv-group-title">{{L.k08}}</view>
      <pv-card>
        <view class="kids">
          <view
            wx:for="{{parentChildren}}"
            wx:key="studentId"
            class="kids__chip {{parentActiveId === item.studentId ? 'is-active' : ''}}"
            data-id="{{item.studentId}}"
            bindtap="onSwitchKid"
          >{{item.nickname}}</view>
        </view>
        <view class="kids__sum" bindtap="goParent" hover-class="home__entry--pressed" hover-start-time="0">
          <view class="kids__sum-main">
            <text class="kids__sum-line">{{parentSummary.grade}}{{parentSummary.className ? ' · ' + parentSummary.className + '班' : ''}}{{parentSummary ? '' : '正在讀取…'}}</text>
            <text class="kids__sum-meta" wx:if="{{parentSummary}}">{{parentSummary.signupCount}} 個報名 · {{parentSummary.claimCount}} 件認領 · {{parentSummary.unreadNotices}} 則未讀</text>
          </view>
          <text class="kids__go">{{L.k09}}</text>
        </view>
      </pv-card>
    </block>

    <view wx:if="{{showAdmin}}" class="home__entry" bindtap="goAdmin"
          hover-class="home__entry--pressed" hover-start-time="0">
      <view class="home__entry-main">
        <text class="home__entry-title">{{L.k10}}</text>
        <text class="home__entry-sub">{{adminSub}}</text>
      </view>
      <text class="home__entry-go">›</text>
    </view>

    <view class="home__foot" bindtap="{{showData ? 'goDev' : ''}}" hover-class="home__foot--pressed" hover-start-time="0">
      <text>{{updatedAt}}</text>
      <text wx:if="{{isDemo}}"> {{L.k11}}</text>
      <text wx:if="{{showData}}" class="home__foot-link"> {{L.k12}}</text>

    </view>
  </block>

    </view>
  </scroll-view>
</view>
