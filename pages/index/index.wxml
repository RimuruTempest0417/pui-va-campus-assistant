<view class="home">
  <!-- 狀態列 + 頂部列（自訂導航）-->
  <view class="home__status" />
  <view class="home__top">
    <view class="home__brand">
      <text class="home__brand-name">培華校園助手</text>
      <text class="home__brand-sub">PUI VA CAMPUS</text>
    </view>
    <view class="home__right">
      <pv-tag wx:if="{{isDemo}}" text="示範資料" type="tint" plain />
      <pv-avatar name="{{user.nickname || '訪客'}}" size="sm" />
    </view>
  </view>

  <!-- 大字問候 -->
  <view class="home__head">
    <text class="home__greeting">{{greeting}}，{{user.nickname || '同學'}}</text>
    <text class="home__meta">{{today}} {{weekday}} · {{clock}}{{user.className ? ' · ' + user.className : ''}}</text>
  </view>

  <!-- 載入中 -->
  <block wx:if="{{loading}}">
    <pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card>
    <view class="home__sk-grid">
      <pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card>
      <pv-card padded="{{false}}"><pv-skeleton rows="2" /></pv-card>
    </view>
  </block>

  <!-- 失敗 -->
  <pv-card wx:elif="{{failed}}">
    <pv-empty icon="⚠️" title="載入失敗" desc="可能是網路或後端暫時不可用">
      <view class="home__retry" bindtap="onRetry">重新載入</view>
    </pv-empty>
  </pv-card>

  <block wx:else>
    <!-- 緊急公告 -->
    <view wx:if="{{urgent}}" class="urgent" bindtap="onTapUrgent" hover-class="urgent--pressed" hover-start-time="0">
      <view class="urgent__left">
        <text class="urgent__badge">緊急</text>
        <text class="urgent__title">{{urgent.title}}</text>
      </view>
      <text class="urgent__arrow">›</text>
    </view>

    <!-- 四宮格 -->
    <view class="grid">
      <view
        wx:for="{{modules}}"
        wx:key="key"
        class="grid__cell"
        data-key="{{item.key}}"
        bindtap="onTapModule"
        hover-class="grid__cell--pressed"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <view class="grid__icon grid__icon--{{item.tone}}"><text>{{item.icon}}</text></view>
        <text class="grid__label">{{item.label}}</text>
        <text class="grid__sub">{{item.sub}}</text>
      </view>
    </view>

    <!-- 今日午餐 -->
    <view class="pv-group-title">今日午餐</view>
    <pv-card>
      <block wx:if="{{lunch && lunch.length}}">
        <view wx:for="{{lunch}}" wx:key="id" class="dish">
          <view class="dish__main">
            <text class="dish__name">{{item.name}}</text>
            <text class="dish__meta">{{item.ratingCount || 0}} 人評分 · 即讚 {{item.liked || 0}}</text>
          </view>
          <view class="dish__score">
            <text class="dish__score-num">{{item.avgScore || '—'}}</text>
            <text class="dish__score-unit">分</text>
          </view>
        </view>
      </block>
      <pv-empty wx:else icon="🍽" title="今天沒有午餐資料" desc="可能尚未排菜單或今天是假日" />
    </pv-card>

    <!-- 小賣部 -->
    <view wx:if="{{snack && snack.length}}" class="pv-group-title">小賣部</view>
    <pv-card wx:if="{{snack && snack.length}}">
      <view wx:for="{{snack}}" wx:key="id" class="dish dish--snack">
        <text class="dish__name">{{item.name}}</text>
        <text class="dish__price">MOP {{item.price}}</text>
      </view>
    </pv-card>

    <view class="home__foot">
      <text>{{updatedAt}}</text>
      <text wx:if="{{isDemo}}"> · 目前使用示範資料，未連接後端</text>
    </view>
  </block>
</view>
