<view class="{{themeClass}} ui-page ui-page--withbar page-root">
  <pv-navbar title="{{type === 'LOST' ? L.k17 : L.k18}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="create-inner">
  <view class="ui-mt-2">
    <pv-tabs tabs="{{typeTabs}}" current="{{type}}" bind:change="onTypeChange" />
  </view>

  <view class="pv-group-title">{{L.k01}}</view>
  <pv-card>
    <view class="ui-field">
      <text class="ui-field__label">{{L.k02}}</text>
      <input class="ui-input" placeholder="{{L.k03}}" placeholder-class="ui-placeholder"
             value="{{form.title}}" data-key="title" bindinput="onInput" maxlength="80" />
    </view>
    <view class="ui-field">
      <text class="ui-field__label">{{L.k04}}</text>
      <textarea class="ui-textarea" placeholder="{{L.k05}}"
                placeholder-class="ui-placeholder" value="{{form.description}}"
                data-key="description" bindinput="onInput" maxlength="500" auto-height />
    </view>
  </pv-card>

  <view class="pv-group-title">{{L.k06}}</view>
  <pv-card>
    <view class="ui-field" bindtap="openCategory">
      <text class="ui-field__label">{{L.k07}}</text>
      <view class="ui-row-between">
        <text class="ui-input {{form.categoryKey ? '' : 'ui-placeholder'}}">{{categoryName || L.k19}}</text>
        <text class="chev">›</text>
      </view>
    </view>
    <view class="ui-field">
      <text class="ui-field__label">{{L.k08}}</text>
      <input class="ui-input" placeholder="{{L.k09}}" placeholder-class="ui-placeholder"
             value="{{form.place}}" data-key="place" bindinput="onInput" maxlength="120" />
    </view>
    <view class="ui-field">
      <text class="ui-field__label">{{L.k10}}</text>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="ui-row-between"><text class="ui-input">{{form.date}}</text><text class="chev">›</text></view>
      </picker>
    </view>
  </pv-card>

  <view class="pv-group-title">{{L.k11}}</view>
  <pv-card>
    <view class="ui-thumbs">
      <view wx:for="{{form.images}}" wx:key="*this" class="ui-thumb-item">
        <image class="ui-thumb" src="{{item}}" mode="aspectFill" />
        <view class="ui-thumb-del" data-index="{{index}}" catchtap="removeImage">✕</view>
      </view>
      <view wx:if="{{form.images.length < 3}}" class="ui-thumb-add" bindtap="addImage">＋</view>
    </view>
    <text class="ui-meta">{{isDemo ? L.k20 : L.k21}}</text>
  </pv-card>

  <view class="pv-group-title">{{L.k12}}</view>
  <pv-card>
    <view class="ui-field">
      <text class="ui-field__label">{{L.k13}}</text>
      <view class="seg-row">
        <view wx:for="{{contactOptions}}" wx:key="key"
              class="seg-item {{form.contactType === item.key ? 'is-active' : ''}}"
              data-key="{{item.key}}" bindtap="onContactChange">{{item.label}}</view>
      </view>
    </view>
    <view wx:if="{{form.contactType !== 'inApp'}}" class="ui-field">
      <text class="ui-field__label">{{form.contactType === 'phone' ? L.k22 : L.k23}}</text>
      <input class="ui-input" placeholder="{{L.k14}}" placeholder-class="ui-placeholder"
             value="{{form.contactValue}}" data-key="contactValue" bindinput="onInput" maxlength="64" />
    </view>
  </pv-card>

  

  

    </view>
  </scroll-view>
<view class="ui-bar">
    <text class="ui-bar__hint">{{form.images.length}}/3 張圖片</text>
    <pv-button type="filled" bind:tap="submit" loading="{{submitting}}" disabled="{{submitting}}">{{L.k15}}</pv-button>
  </view>
<pv-sheet show="{{categorySheet}}" title="{{L.k16}}" bind:close="closeCategory">
    <view wx:for="{{categories}}" wx:key="key" class="sheet-row" data-key="{{item.key}}" bindtap="pickCategory">
      <text>{{item.icon}} {{item.name}}</text>
    </view>
  </pv-sheet>
</view>
