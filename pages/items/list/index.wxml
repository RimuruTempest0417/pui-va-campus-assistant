<view class="ui-page page-root">
  <pv-navbar title="校園失物招領" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="list-inner">
  <view class="filter">
    <pv-tabs tabs="{{typeTabs}}" current="{{type}}" bind:change="onTypeChange" />
    <view class="chips">
      <view
        wx:for="{{statusChips}}"
        wx:key="key"
        class="chip {{status === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onStatusChange"
      >{{item.label}}</view>
    </view>
    <view class="search">
      <text class="search__icon">🔍</text>
      <input class="search__input" placeholder="搜標題、地點、描述" placeholder-class="ui-placeholder"
             value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
      <text wx:if="{{keyword}}" class="search__clear" bindtap="onClearKeyword">✕</text>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="ui-list">
      <view class="ui-card"><pv-skeleton rows="2" /></view>
      <view class="ui-card"><pv-skeleton rows="2" /></view>
    </view>
  </block>

  <pv-empty wx:elif="{{!items.length}}" icon="🔍"
            title="{{keyword ? '沒有符合的結果' : '這裡還空著'}}"
            desc="{{keyword ? '換個關鍵字，或清除篩選條件' : '第一個發布的人，最有機會找回東西'}}">
    <view class="empty-action" bindtap="goCreate">我要發布</view>
  </pv-empty>

  <view wx:else class="ui-list">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="ui-card {{pressedId === item.id ? 'ui-card--pressed' : ''}}"
      data-id="{{item.id}}"
      bindtouchstart="onItemTouchStart"
      bindtouchend="onItemTouchEnd"
      bindtouchcancel="onItemTouchEnd"
      bindtap="goDetail"
    >
      <view class="card-row">
        <image wx:if="{{item.cover}}" class="ui-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="ui-thumb thumb-ph"><text>{{item.type === 'LOST' ? '🔍' : '📦'}}</text></view>
        <view class="card-main">
          <view class="ui-row-between">
            <text class="ui-title card-title">{{item.title}}</text>
            <pv-tag text="{{item.statusLabel}}" type="{{item.statusTag}}" />
          </view>
          <text class="ui-meta card-meta">{{item.typeLabel}} · {{item.categoryName || '其他'}} · {{item.place}}</text>
          <text class="ui-meta">{{item.timeText}} · {{item.viewCount || 0}} 次查看</text>
        </view>
      </view>
    </view>
    <view class="list-foot">
      <text wx:if="{{loadingMore}}">載入中…</text>
      <text wx:elif="{{!hasMore}}">— 已經到底了 —</text>
    </view>
  </view>

  

    </view>
  </scroll-view>
<view class="fab" bindtap="goCreate">＋ 發布</view>
</view>
