<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="list-inner">
  <view class="filter">
    <pv-tabs tabs="{{typeTabs}}" current="{{type}}" bind:change="onTypeChange" />
    <view class="chips">
      <view
        wx:for="{{statusChips}}"
        wx:key="key"
        class="chip {{status === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onStatusChange"
      >{{item.label}}</view>
    </view>
    <view class="search">
      <pv-icon class="search__icon" name="search" size="28" tone="muted" />
      <input class="search__input" placeholder="{{L.k02}}" placeholder-class="ui-placeholder"
             value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
      <text wx:if="{{keyword}}" class="search__clear" bindtap="onClearKeyword">✕</text>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="ui-list ui-list--grouped">
      <view class="ui-card ui-card--row"><pv-skeleton rows="2" /></view>
      <view class="ui-card ui-card--row ui-card--last"><pv-skeleton rows="2" /></view>
    </view>
  </block>

  <pv-empty wx:elif="{{failed}}" title="{{L.k03}}" desc="{{errorText}}">
    <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k04}}</pv-button>
  </pv-empty>

  <pv-empty wx:elif="{{!items.length}}"
            title="{{keyword ? L.k09 : L.k10}}"
            desc="{{keyword ? L.k11 : L.k12}}">
    <view class="empty-action" bindtap="goCreate">{{L.k05}}</view>
  </pv-empty>

  <view wx:else class="ui-list ui-list--grouped">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="ui-card ui-card--row {{index === items.length - 1 ? 'ui-card--last' : ''}} {{pressedId === item.id ? 'ui-card--pressed' : ''}}"
      data-id="{{item.id}}"
      bindtouchstart="onItemTouchStart"
      bindtouchend="onItemTouchEnd"
      bindtouchcancel="onItemTouchEnd"
      bindtap="goDetail"
    >
      <view class="card-row">
        <image wx:if="{{item.cover}}" class="ui-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="ui-thumb thumb-ph"><text class="thumb-ph__text">{{item.type === 'LOST' ? '失' : '拾'}}</text></view>
        <view class="card-main">
          <view class="ui-row-between">
            <text class="ui-title card-title">{{item.title}}</text>
            <pv-tag text="{{item.statusLabel}}" type="{{item.statusTag}}" />
          </view>
          <text class="ui-meta card-meta">{{item.typeLabel}} · {{item.categoryName || L.k13}} · {{item.place}}</text>
          <text class="ui-meta">{{item.timeText}} · {{item.viewCount || 0}} 次查看</text>
        </view>
      </view>
    </view>
  </view>
  <view class="list-foot">
    <text wx:if="{{loadingMore}}">{{L.k06}}</text>
    <text wx:elif="{{!hasMore}}">{{L.k07}}</text>
  </view>

  

    </view>
  </scroll-view>
<view class="fab" bindtap="goCreate">{{L.k08}}</view>
</view>
