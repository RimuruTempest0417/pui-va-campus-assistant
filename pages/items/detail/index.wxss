@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.gallery { height: 420rpx; background: var(--pv-fill); border-radius: 0 0 var(--pv-r-lg) var(--pv-r-lg); overflow: hidden; }
.gallery__img { width: 100%; height: 420rpx; }
.gallery__placeholder {
  width: 100%; height: 420rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: var(--pv-fill);
}
.gallery__ph-icon { font-size: 88rpx; opacity: 0.4; margin-bottom: var(--pv-sp-1); }

.head { padding: var(--pv-sp-3) 0 var(--pv-sp-1); }
.head__title { font-size: var(--pv-fs-title-2); font-weight: 700; letter-spacing: var(--pv-ls-title); flex: 1; margin-right: var(--pv-sp-2); }
.head__tags { margin-top: var(--pv-sp-1); }
.head__tag { margin-right: var(--pv-sp-1); }

.meta-row { display: flex; flex-direction: row; align-items: flex-start; padding: var(--pv-sp-1) 0; }
.meta-k { width: 96rpx; font-size: var(--pv-fs-subhead); color: var(--pv-label-2); }
.meta-v { flex: 1; font-size: var(--pv-fs-body); }
.author { margin-left: var(--pv-sp-2); display: flex; flex-direction: column; }

.match-hint { display: block; margin-bottom: var(--pv-sp-1); line-height: 1.4; }
.match-row {
  display: flex; flex-direction: row; align-items: center;
  padding: var(--pv-sp-2) 0; border-bottom: 1rpx solid var(--pv-sep);
}
.match-row:last-child { border-bottom: none; }
.match-row--pressed { opacity: 0.6; }
.match-row__main { flex: 1; display: flex; flex-direction: column; }
.match-row__title { flex: 1; font-size: var(--pv-fs-callout); font-weight: 600; }
.match-row__score { font-size: var(--pv-fs-subhead); font-weight: 700; color: var(--pv-warning); }
.match-row__reasons { margin-top: 6rpx; flex-wrap: wrap; }
.match-reason { margin-right: 8rpx; margin-bottom: 4rpx; }
.match-row__go { font-size: 36rpx; color: var(--pv-label-3); margin-left: var(--pv-sp-1); }

.ui-bar__left { flex: 1; display: flex; flex-direction: column; }
.ui-bar__report {
  margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3);
  text-decoration: underline;
}
.report-row {
  padding: var(--pv-sp-3) 0;
  font-size: var(--pv-fs-callout);
  border-bottom: 1rpx solid var(--pv-sep);
}
