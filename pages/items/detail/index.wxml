<view class="{{themeClass}} ui-page ui-page--withbar page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="detail-inner">
  <block wx:if="{{loading}}">
    <view class="ui-card ui-mt-2"><pv-skeleton rows="3" avatar /></view>
  </block>

  <pv-empty wx:elif="{{failed}}" icon="⚠️" title="{{L.k02}}" desc="{{errorText}}">
    <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k03}}</pv-button>
  </pv-empty>

  <pv-empty wx:elif="{{!item}}" icon="🕳" title="{{L.k04}}" desc="{{L.k05}}" />

  <block wx:else>
    <swiper class="gallery" indicator-dots="{{item.images.length > 1}}" indicator-active-color="{{theme.onTint}}">
      <swiper-item wx:for="{{item.images}}" wx:key="*this">
        <image class="gallery__img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
      <swiper-item wx:if="{{!item.images.length}}">
        <view class="gallery__placeholder">
          <text class="gallery__ph-icon">{{item.type === 'LOST' ? '🔍' : '📦'}}</text>
          <text class="ui-meta">{{L.k06}}</text>
        </view>
      </swiper-item>
    </swiper>

    <view class="head">
      <view class="ui-row-between">
        <text class="head__title">{{item.title}}</text>
        <pv-tag text="{{item.statusLabel}}" type="{{item.statusTag}}" />
      </view>
      <view class="ui-row head__tags">
        <pv-tag class="head__tag" text="{{item.typeLabel}}" type="tint" plain />
        <pv-tag class="head__tag" text="{{item.categoryName || '其他'}}" plain />
      </view>
    </view>

    <pv-card>
      <view class="meta-row"><text class="meta-k">{{L.k07}}</text><text class="meta-v">{{item.place}}</text></view>
      <view class="meta-row"><text class="meta-k">{{L.k08}}</text><text class="meta-v">{{item.timeText}} · {{item.happenedAtText}}</text></view>
      <view class="meta-row"><text class="meta-k">{{L.k09}}</text><text class="meta-v">{{item.contactLabel}}</text></view>
      <view class="meta-row"><text class="meta-k">{{L.k10}}</text><text class="meta-v">{{item.viewCount}} 次</text></view>
    </pv-card>

    <view class="pv-group-title">{{L.k11}}</view>
    <pv-card>
      <text class="ui-body">{{item.description || '作者沒有填寫說明'}}</text>
    </pv-card>

    <block wx:if="{{matches.length}}">
      <view class="pv-group-title">{{L.k12}}</view>
      <pv-card>
        <text class="ui-meta match-hint">依分類、地點、時間與描述自動比對，{{matchHint}}</text>
        <view wx:for="{{matches}}" wx:key="id" class="match-row" data-id="{{item.id}}" bindtap="goMatch"
              hover-class="match-row--pressed" hover-start-time="0">
          <view class="match-row__main">
            <view class="ui-row">
              <text class="match-row__title">{{item.title}}</text>
              <text class="match-row__score">{{item.percent}}%</text>
            </view>
            <text class="ui-meta">{{item.typeLabel}} · {{item.place}}</text>
            <view class="ui-row match-row__reasons">
              <pv-tag wx:for="{{item.reasons}}" wx:for-item="r" wx:key="*this" class="match-reason" text="{{r}}" plain />
            </view>
          </view>
          <text class="match-row__go">›</text>
        </view>
      </pv-card>
    </block>

    <view class="pv-group-title">{{L.k13}}</view>
    <pv-card>
      <view class="ui-row">
        <pv-avatar name="{{item.author.nickname}}" size="md" />
        <view class="author">
          <text class="ui-title">{{item.author.nickname}}</text>
          <text class="ui-meta">{{item.timeText}}發布</text>
        </view>
      </view>
    </pv-card>
  </block>

  

    </view>
  </scroll-view>
<view wx:if="{{item}}" class="ui-bar">
    <view class="ui-bar__left">
      <text class="ui-bar__hint">{{barHint}}</text>
      <text class="ui-bar__report" catchtap="openReport">{{L.k14}}</text>
    </view>
    <pv-button type="filled" size="md" disabled="{{barDisabled}}" bind:tap="onPrimaryAction">{{barText}}</pv-button>
  </view>

  <pv-sheet show="{{reportOpen}}" title="{{L.k15}}" bind:close="closeReport">
    <view wx:for="{{reportReasons}}" wx:key="*this" class="report-row"
          data-reason="{{item}}" catchtap="pickReason">{{item}}</view>
  </pv-sheet>
</view>
