<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="detail-inner">
      <block wx:if="{{loading}}">
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row"><pv-skeleton rows="3" /></view>
          <view class="ui-card ui-card--row ui-card--last"><pv-skeleton rows="2" /></view>
        </view>
      </block>

      <pv-empty wx:elif="{{failed}}" title="{{L.k20}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k21}}</pv-button>
      </pv-empty>

      <block wx:elif="{{resource}}">
        <!-- 資源資料：一張卡＋髮絲線分列 -->
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row">
            <view class="res-head">
              <view class="venue-mark"><text class="venue-mark__text">{{resource.kindMark}}</text></view>
              <view class="res-main">
                <text class="ui-title res-title">{{resource.name}}</text>
                <text class="ui-meta">{{resource.kindLabel}}<block wx:if="{{resource.location}}"> · {{resource.location}}</block></text>
              </view>
              <pv-tag text="{{resource.needsApproval ? L.k26 : L.k27}}" type="{{resource.needsApproval ? 'warning' : 'success'}}" />
            </view>
          </view>
          <view class="ui-card ui-card--row">
            <view class="ui-row-between info-row">
              <text class="ui-sub">{{L.k02}}</text>
              <text class="ui-body ui-num">{{resource.hoursText}}</text>
            </view>
          </view>
          <view class="ui-card ui-card--row">
            <view class="ui-row-between info-row">
              <text class="ui-sub">{{L.k04}}</text>
              <text class="ui-body ui-num">{{resource.maxHours}} {{L.k34}}</text>
            </view>
          </view>
          <view wx:if="{{resource.description}}" class="ui-card ui-card--row ui-card--last">
            <text class="ui-field__label">{{L.k05}}</text>
            <text class="ui-body desc">{{resource.description}}</text>
          </view>
        </view>

        <!-- 預約表單 -->
        <view class="section-title">{{L.k06}}</view>
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row">
            <picker mode="selector" range="{{dateLabels}}" value="{{dateIndex}}" bindchange="onDateChange">
              <view class="field-row">
                <text class="field-label">{{L.k07}}</text>
                <text class="field-value">{{dateLabel}}</text>
                <text class="field-arrow">›</text>
              </view>
            </picker>
          </view>
          <view class="ui-card ui-card--row">
            <view class="field-row">
              <text class="field-label">{{L.k08}}</text>
              <picker class="field-picker" mode="selector" range="{{startLabels}}" value="{{startIndex}}" bindchange="onStartChange">
                <text class="field-value">{{startValue}}</text>
              </picker>
              <text class="field-arrow">›</text>
            </view>
          </view>
          <view class="ui-card ui-card--row">
            <view class="field-row">
              <text class="field-label">{{L.k09}}</text>
              <picker class="field-picker" mode="selector" range="{{endLabels}}" value="{{endIndex}}" bindchange="onEndChange">
                <text class="field-value">{{endValue}}</text>
              </picker>
              <text class="field-arrow">›</text>
            </view>
          </view>
          <view class="ui-card ui-card--row ui-card--last">
            <text class="ui-field__label">{{L.k10}}<block wx:if="{{durationText}}"> · {{durationText}}</block></text>
            <textarea
              class="ui-textarea"
              placeholder="{{L.k11}}"
              placeholder-class="ui-placeholder"
              value="{{purpose}}"
              maxlength="200"
              bindinput="onPurposeInput"
            />
          </view>
        </view>

        <view class="submit-row">
          <pv-button type="filled" block loading="{{submitting}}" disabled="{{!canBook}}" bind:tap="submit">{{submitting ? L.k13 : L.k12}}</pv-button>
          <text class="form-hint">{{formHint}}</text>
        </view>

        <!-- 最近 14 天的時段 -->
        <view class="section-title">{{L.k35}}</view>
        <view wx:if="{{bookings.length}}" class="ui-list ui-list--grouped">
          <view
            wx:for="{{bookings}}"
            wx:key="id"
            class="ui-card ui-card--row {{index === bookings.length - 1 ? 'ui-card--last' : ''}}"
          >
            <view class="slot-row">
              <view class="slot-main">
                <text class="ui-body ui-num">{{item.dateText}} {{item.timeText}}</text>
                <text class="ui-meta">{{item.user.nickname}}<block wx:if="{{item.purpose}}"> · {{item.purpose}}</block></text>
              </view>
              <pv-tag text="{{item.status === 'APPROVED' ? L.k25 : L.k24}}" type="{{item.status === 'APPROVED' ? 'success' : 'warning'}}" />
            </view>
          </view>
        </view>
        <view wx:else class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row ui-card--last">
            <text class="ui-meta empty-inline">{{L.k19}}</text>
          </view>
        </view>

        <!-- 我的申請 -->
        <block wx:if="{{mine.length}}">
          <view class="section-title">
            <text>{{L.k22}}</text>
            <text class="section-link" bindtap="goMine">{{L.k22}} ›</text>
          </view>
          <view class="ui-list ui-list--grouped">
            <view
              wx:for="{{mine}}"
              wx:key="id"
              class="ui-card ui-card--row {{index === mine.length - 1 ? 'ui-card--last' : ''}}"
            >
              <view class="slot-row">
                <view class="slot-main">
                  <text class="ui-body ui-num">{{item.dateText}} {{item.timeText}}</text>
                  <text class="ui-meta">{{item.purpose}}</text>
                </view>
                <view class="slot-actions">
                  <pv-tag text="{{item.statusLabel}}" type="{{item.status === 'APPROVED' ? 'success' : 'warning'}}" />
                  <text
                    wx:if="{{item.canCancel}}"
                    class="slot-cancel"
                    data-id="{{item.id}}"
                    data-label="{{item.dateText}} {{item.timeText}} · {{item.purpose}}"
                    bindtap="cancelBooking"
                  >{{L.k23}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
</view>
