@import "../../styles/tokens.wxss";
@import "../../styles/ui.wxss";

.set-inner { display: flex; flex-direction: column; gap: var(--pv-sp-2); padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }
/* 卡片間距交給 gap，避免「上一張卡」與「下一個群組標題」黏在一起 */
.set-inner pv-card { display: block; margin: 0; }
.set-group {
  display: block; margin: var(--pv-sp-2) 0 0 var(--pv-sp-1);
  font-size: var(--pv-fs-footnote); color: var(--pv-label-3); letter-spacing: 0.02em;
}
.set-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: var(--pv-sp-2) 0; }
.set-row__main { flex: 1; min-width: 0; }
.set-row__title { display: block; font-size: var(--pv-fs-callout); color: var(--pv-label); }
.set-row__sub { display: block; margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
.set-row__value { font-size: var(--pv-fs-callout); color: var(--pv-label-2); }
.set-row__chev { font-size: var(--pv-fs-title-3); color: var(--pv-label-4); }
.set-actions { display: flex; flex-direction: row; align-items: center; gap: var(--pv-sp-3); padding-top: var(--pv-sp-1); }
.set-link { font-size: var(--pv-fs-footnote); color: var(--pv-tint); }
.set-link--danger { color: var(--pv-danger); }

.seg { display: flex; flex-direction: row; background: var(--pv-fill); border-radius: var(--pv-r-sm); padding: 6rpx; }
.seg__item {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: var(--pv-fs-subhead); color: var(--pv-label-2); border-radius: var(--pv-r-sm);
}
.seg__item--on { background: var(--pv-surface); color: var(--pv-label); font-weight: 600; }
.set-hint { display: block; margin-top: var(--pv-sp-2); font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); line-height: 1.5; }

.set-input {
  margin-top: var(--pv-sp-2); padding: 18rpx var(--pv-sp-2);
  background: var(--pv-fill); border-radius: var(--pv-r-sm);
  font-size: var(--pv-fs-subhead);
}

/* 同一張卡裡的多列：用髮絲線分隔，不要每列一張卡 */
.set-row--sep { border-top: 1rpx solid var(--pv-sep); }
