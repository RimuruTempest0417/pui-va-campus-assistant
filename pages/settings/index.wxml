<view class="ui-page page-root {{themeClass}}">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="set-inner">

      <!-- 帳號 -->
      <text class="set-group">{{L.k02}}</text>
      <pv-card>
        <block wx:if="{{loggedIn}}">
          <view class="set-row">
            <view class="set-row__main">
              <text class="set-row__title">{{user.nickname || L.k17}}</text>
              <text class="set-row__sub">{{roleText}}{{isDemo ? L.k18 : ''}}</text>
            </view>
          </view>
          <view class="set-actions">
            <pv-tag wx:if="{{isStaff}}" text="{{L.k03}}" type="tint" bind:tap="goAdmin" />
            <text class="set-link" catchtap="goLogin">{{L.k04}}</text>
            <text class="set-link set-link--danger" catchtap="logout">{{L.k05}}</text>
          </view>
        </block>
        <view wx:else class="set-row" bindtap="goLogin">
          <view class="set-row__main">
            <text class="set-row__title">{{L.k06}}</text>
            <text class="set-row__sub">{{L.k07}}</text>
          </view>
          <text class="set-row__chev">›</text>
        </view>
      </pv-card>

      <!-- 兩步驗證（教職員） -->
      <block wx:if="{{isStaff && loggedIn}}">
        <text class="set-group">{{L.k30}}</text>
        <pv-card>
          <view class="set-row">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k31}}</text>
              <text class="set-row__sub">{{tfaEnabled ? (L.k32 + ' ' + tfaCodesLeft + ' ' + L.k33) : L.k34}}</text>
            </view>
          </view>

          <block wx:if="{{!tfaEnabled && !tfaSetup}}">
            <view class="set-actions">
              <text class="set-link" catchtap="tfaBegin">{{L.k35}}</text>
            </view>
          </block>

          <block wx:if="{{!tfaEnabled && tfaSetup}}">
            <text class="set-hint">{{L.k36}}{{tfaSetup.secret}}</text>
            <view class="set-actions"><text class="set-link" catchtap="copySecret">{{L.k37}}</text></view>
            <input class="set-input" value="{{tfaCode}}" type="number" maxlength="6"
                   placeholder="{{L.k38}}" bindinput="onTfaCode" />
            <view class="set-actions">
              <text class="set-link" catchtap="tfaEnable">{{tfaBusy ? L.k39 : L.k40}}</text>
            </view>
          </block>

          <block wx:if="{{tfaBackupCodes.length}}">
            <text class="set-hint">{{L.k44}}</text>
            <view class="codes">
              <text wx:for="{{tfaBackupCodes}}" wx:key="*this" class="codes__item">{{item}}</text>
            </view>
            <view class="set-actions">
              <text class="set-link" catchtap="copyBackupCodes">{{L.k45}}</text>
              <text class="set-link" catchtap="hideBackupCodes">{{L.k46}}</text>
            </view>
          </block>

          <block wx:if="{{tfaEnabled}}">
            <input class="set-input" value="{{tfaPassword}}" password
                   placeholder="{{L.k41}}" bindinput="onTfaPassword" />
            <view class="set-actions">
              <text class="set-link set-link--danger" catchtap="tfaDisable">{{tfaBusy ? L.k42 : L.k43}}</text>
            </view>
          </block>
        </pv-card>
      </block>

      <!-- 介面語言 -->
      <text class="set-group">{{L.k08}}</text>
      <pv-card>
        <view class="seg">
          <view wx:for="{{localeOptions}}" wx:key="key"
                class="seg__item {{localePref === item.key ? 'seg__item--on' : ''}}"
                data-key="{{item.key}}" catchtap="pickLocale">{{item.label}}</view>
        </view>
        <text class="set-hint">{{L.k09}}</text>
      </pv-card>

      <!-- 外觀 -->
      <text class="set-group">{{L.k10}}</text>
      <pv-card>
        <view class="seg">
          <view wx:for="{{themeOptions}}" wx:key="key"
                class="seg__item {{theme === item.key ? 'seg__item--on' : ''}}"
                data-key="{{item.key}}" catchtap="pickTheme">{{item.label}}</view>
        </view>
        <text class="set-hint">{{L.k11}}</text>
      </pv-card>

      <!-- 資料來源（教職員以上） -->
      <block wx:if="{{isStaff}}">
        <text class="set-group">{{L.k12}}</text>
        <pv-card>
          <view class="set-row" bindtap="goDev">
            <view class="set-row__main">
              <text class="set-row__title">{{isDemo ? L.k19 : L.k20}}</text>
              <text class="set-row__sub">{{apiBase}}</text>
            </view>
            <text class="set-row__chev">›</text>
          </view>
        </pv-card>
      </block>

      <!-- 關於 -->
      <text class="set-group">{{L.k13}}</text>
      <pv-card>
        <view class="set-row">
          <text class="set-row__title">{{L.k14}}</text>
          <text class="set-row__value">{{version}}</text>
        </view>
        <view class="set-row">
          <text class="set-row__title">{{L.k15}}</text>
          <text class="set-row__value">{{L.k16}}</text>
        </view>
      </pv-card>

    </view>
  </scroll-view>
</view>
