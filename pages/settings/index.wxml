<view class="ui-page page-root {{themeClass}}">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="set-inner">

      <!-- 帳號 -->
      <text class="set-group">{{L.k02}}</text>
      <pv-card>
        <block wx:if="{{loggedIn}}">
          <view class="set-row">
            <view class="set-row__main">
              <text class="set-row__title">{{user.nickname || L.k17}}</text>
              <text class="set-row__sub">{{roleText}}{{isDemo ? L.k18 : ''}}</text>
            </view>
          </view>
          <view class="set-actions">
            <pv-tag wx:if="{{isStaff}}" text="{{L.k03}}" type="tint" bind:tap="goAdmin" />
            <text class="set-link" catchtap="goLogin">{{L.k04}}</text>
            <text class="set-link set-link--danger" catchtap="logout">{{L.k05}}</text>
          </view>
        </block>
        <view wx:else class="set-row" bindtap="goLogin">
          <view class="set-row__main">
            <text class="set-row__title">{{L.k06}}</text>
            <text class="set-row__sub">{{L.k07}}</text>
          </view>
          <text class="set-row__chev">›</text>
        </view>
      </pv-card>

      <!-- 兩步驗證：只在網頁後台設定（v0.40.0 起） -->
      <block wx:if="{{isStaff && loggedIn}}">
        <text class="set-group">{{L.k30}}</text>
        <pv-card>
          <view class="set-row">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k31}}</text>
              <text class="set-row__sub">{{tfaEnabled ? (L.k32 + ' ' + tfaCodesLeft + ' ' + L.k33) : L.k47}}</text>
            </view>
          </view>
          <view class="set-actions">
            <text class="set-link" catchtap="copy2faUrl">{{L.k48}}</text>
          </view>
          <text class="set-hint">{{tfa2faUrl}}</text>
        </pv-card>
      </block>

      <!-- 介面語言 -->
      <text class="set-group">{{L.k08}}</text>
      <pv-card>
        <view class="seg">
          <view wx:for="{{localeOptions}}" wx:key="key"
                class="seg__item {{localePref === item.key ? 'seg__item--on' : ''}}"
                data-key="{{item.key}}" catchtap="pickLocale">{{item.label}}</view>
        </view>
        <text class="set-hint">{{L.k09}}</text>
      </pv-card>

      <!-- 外觀 -->
      <text class="set-group">{{L.k10}}</text>
      <pv-card>
        <view class="seg">
          <view wx:for="{{themeOptions}}" wx:key="key"
                class="seg__item {{theme === item.key ? 'seg__item--on' : ''}}"
                data-key="{{item.key}}" catchtap="pickTheme">{{item.label}}</view>
        </view>
        <text class="set-hint">{{L.k11}}</text>
      </pv-card>

      <!-- 資料來源（教職員以上） -->
      <block wx:if="{{isStaff}}">
        <text class="set-group">{{L.k12}}</text>
        <pv-card>
          <view class="set-row" bindtap="goDev">
            <view class="set-row__main">
              <text class="set-row__title">{{isDemo ? L.k19 : L.k20}}</text>
              <text class="set-row__sub">{{apiBase}}</text>
            </view>
            <text class="set-row__chev">›</text>
          </view>
        </pv-card>
      </block>

      <!-- 通知／使用說明／回報問題：合成一張卡（同類「去看／去做」的入口） -->
      <pv-card>
        <view class="set-row" bindtap="goNotifications">
          <view class="set-row__main">
            <text class="set-row__title">{{L.k51}}</text>
            <text class="set-row__sub">{{L.k52}}</text>
          </view>
          <text class="set-row__chev">›</text>
        </view>
        <view class="set-row set-row--sep" bindtap="goHelp">
          <view class="set-row__main">
            <text class="set-row__title">{{L.k49}}</text>
            <text class="set-row__sub">{{L.k50}}</text>
          </view>
          <text class="set-row__chev">›</text>
        </view>
        <!-- 回報問題（W-43）：按鈕沒反應、畫面怪這類不會拋錯，只能由使用者自己講 -->
        <view class="set-row set-row--sep" bindtap="reportIssue">
          <view class="set-row__main">
            <text class="set-row__title">{{L.k53}}</text>
            <text class="set-row__sub">{{L.k54}}</text>
          </view>
          <text class="set-row__chev">›</text>
        </view>
      </pv-card>

      <!-- W-102 我的資料：自己的紀錄自己帶走（複製成 CSV 文字，不需要下載權限） -->
      <block wx:if="{{loggedIn}}">
        <text class="set-group">{{L.k55}}</text>
        <pv-card>
          <view class="set-row" data-type="grades" bindtap="exportMy">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k56}}</text>
            </view>
            <text class="set-row__value">{{exporting === 'grades' ? L.k63 : L.k62}}</text>
          </view>
          <view class="set-row set-row--sep" data-type="attendance" bindtap="exportMy">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k57}}</text>
            </view>
            <text class="set-row__value">{{exporting === 'attendance' ? L.k63 : L.k62}}</text>
          </view>
          <view class="set-row set-row--sep" data-type="library" bindtap="exportMy">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k58}}</text>
            </view>
            <text class="set-row__value">{{exporting === 'library' ? L.k63 : L.k62}}</text>
          </view>
          <view class="set-row set-row--sep" data-type="leaves" bindtap="exportMy">
            <view class="set-row__main">
              <text class="set-row__title">{{L.k59}}</text>
            </view>
            <text class="set-row__value">{{exporting === 'leaves' ? L.k63 : L.k62}}</text>
          </view>
          <text class="set-hint">{{L.k60}}</text>
        </pv-card>
      </block>

      <!-- 關於 -->
      <text class="set-group">{{L.k13}}</text>
      <pv-card>
        <view class="set-row">
          <text class="set-row__title">{{L.k14}}</text>
          <text class="set-row__value">{{version}}</text>
        </view>
        <view class="set-row">
          <text class="set-row__title">{{L.k15}}</text>
          <text class="set-row__value">{{L.k16}}</text>
        </view>
      </pv-card>

    </view>
  </scroll-view>
</view>
