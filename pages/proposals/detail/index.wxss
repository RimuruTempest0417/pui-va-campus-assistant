@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.detail-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

.head { display: flex; flex-direction: row; align-items: flex-start; gap: var(--pv-sp-2); }
.head__mark {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: var(--pv-r-sm);
  background: var(--pv-fill);
  display: flex;
  align-items: center;
  justify-content: center;
}
.head__mark-text { font-size: var(--pv-fs-title-3); font-weight: 600; color: var(--pv-tint); }
.head__main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.head__title { font-size: var(--pv-fs-title-2); font-weight: 600; line-height: 1.35; color: var(--pv-label); }
.head__meta { margin-top: 6rpx; }

.bar { display: flex; flex-direction: row; align-items: center; gap: var(--pv-sp-2); margin-top: var(--pv-sp-3); }
.bar__track { flex: 1; min-width: 0; height: 10rpx; border-radius: 5rpx; background: var(--pv-fill-2); overflow: hidden; }
.bar__fill { height: 10rpx; background: var(--pv-tint); border-radius: 5rpx; }
.bar__text { flex-shrink: 0; font-size: var(--pv-fs-footnote); color: var(--pv-label-2); }
.bar__hint { display: block; margin-top: 8rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-success); }

.sep { height: 1rpx; background: var(--pv-sep); margin: var(--pv-sp-3) 0; }
.section-title { display: block; font-size: var(--pv-fs-footnote); color: var(--pv-label-3); font-weight: 600; }
.body-text {
  display: block;
  margin-top: 8rpx;
  font-size: var(--pv-fs-body);
  color: var(--pv-label);
  line-height: 1.6;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.supporters { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8rpx; margin-top: var(--pv-sp-2); }
.supporter {
  flex-shrink: 0;
  font-size: var(--pv-fs-caption-1);
  color: var(--pv-tint);
  background: var(--pv-tint-soft);
  border-radius: var(--pv-r-pill);
  padding: 6rpx var(--pv-sp-2);
}

.reply-card { margin-top: var(--pv-sp-2); }
.reply__meta { display: block; margin-top: 8rpx; }
.moderate { display: flex; flex-direction: row; justify-content: flex-end; margin-top: var(--pv-sp-2); }
.moderate__link { font-size: var(--pv-fs-subhead); color: var(--pv-danger); padding: 8rpx var(--pv-sp-2); }

.bar-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--pv-surface);
  border-top: 1rpx solid var(--pv-sep);
  padding: var(--pv-sp-2) var(--pv-sp-3) calc(var(--pv-sp-2) + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: var(--pv-sp-1);
}
.bar-fixed__link { text-align: center; font-size: var(--pv-fs-subhead); color: var(--pv-danger); padding: 12rpx 0; }
