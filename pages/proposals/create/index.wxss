@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.form-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

.cat-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--pv-sp-2); margin-top: var(--pv-sp-2); }
.cat {
  flex-shrink: 0;
  font-size: var(--pv-fs-subhead);
  color: var(--pv-label-2);
  background: var(--pv-fill);
  border-radius: var(--pv-r-pill);
  padding: 10rpx var(--pv-sp-3);
}
.cat.is-active { background: var(--pv-tint); color: var(--pv-on-tint); font-weight: 600; }

.hint {
  display: block;
  margin: var(--pv-sp-2) var(--pv-sp-1) 0;
  font-size: var(--pv-fs-caption-1);
  color: var(--pv-label-3);
  line-height: 1.5;
}

.actions { margin-top: var(--pv-sp-4); }
