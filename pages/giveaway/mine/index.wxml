<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="mine-inner">
      <view class="chips">
        <view class="chip {{segment === 'posted' ? 'is-active' : ''}}" data-key="posted" bindtap="onSegment">{{L.k02}}</view>
        <view class="chip {{segment === 'requests' ? 'is-active' : ''}}" data-key="requests" bindtap="onSegment">{{L.k03}}</view>
      </view>

      <block wx:if="{{loading}}">
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row"><pv-skeleton rows="2" /></view>
          <view class="ui-card ui-card--row ui-card--last"><pv-skeleton rows="2" /></view>
        </view>
      </block>

      <block wx:elif="{{needLogin}}">
        <pv-empty title="{{L.k19}}" desc="{{errorText}}">
          <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k05}}</pv-button>
        </pv-empty>
      </block>

      <pv-empty wx:elif="{{failed}}" title="{{L.k04}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k05}}</pv-button>
      </pv-empty>

      <!-- 我送出的 -->
      <block wx:elif="{{segment === 'posted'}}">
        <pv-empty wx:if="{{!posted.length}}" title="{{L.k06}}" desc="{{L.k07}}">
          <view class="empty-action" bindtap="goCreate">{{L.k08}}</view>
        </pv-empty>
        <view wx:else class="ui-list ui-list--grouped">
          <view
            wx:for="{{posted}}"
            wx:key="id"
            class="ui-card ui-card--row {{index === posted.length - 1 ? 'ui-card--last' : ''}}"
            data-id="{{item.id}}"
            bindtap="goDetail"
          >
            <view class="mine-row">
              <view class="mine-main">
                <text class="ui-title">{{item.title}}</text>
                <text class="ui-meta">{{item.metaText}}</text>
                <text class="ui-meta">{{item.applyText}}</text>
              </view>
              <pv-tag text="{{item.statusText}}" type="{{item.statusTag}}" />
            </view>
          </view>
        </view>
      </block>

      <!-- 我申請的 -->
      <block wx:else>
        <pv-empty wx:if="{{!requests.length}}" title="{{L.k09}}" desc="{{L.k10}}">
          <view class="empty-action" bindtap="goList">{{L.k11}}</view>
        </pv-empty>
        <view wx:else class="ui-list ui-list--grouped">
          <view
            wx:for="{{requests}}"
            wx:key="id"
            class="ui-card ui-card--row {{index === requests.length - 1 ? 'ui-card--last' : ''}}"
          >
            <view class="mine-row">
              <view class="mine-main" data-id="{{item.item.id}}" bindtap="goDetail">
                <text class="ui-title">{{item.title}}</text>
                <text class="ui-meta">{{item.ownerText}} · {{item.timeText}}</text>
                <text wx:if="{{item.message}}" class="ui-meta">{{item.message}}</text>
              </view>
              <view class="mine-side">
                <pv-tag text="{{item.statusText}}" type="{{item.statusTag}}" />
                <text wx:if="{{item.canCancel}}" class="cancel-link" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="cancelRequest">{{L.k12}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
</view>
