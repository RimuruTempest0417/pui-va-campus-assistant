<view class="ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="ci-inner">
      <block wx:if="{{result}}">
        <pv-card>
          <view class="ci-done">
            <text class="ci-done__mark">✓</text>
            <text class="ci-done__title">{{result.already ? '你已經簽到過' : '簽到成功'}}</text>
            <text class="ci-done__ev">{{result.title}}</text>
            <text class="ui-meta">{{result.whenText}}</text>
          </view>
        </pv-card>
        <view class="ci-actions">
          <pv-button type="tinted" bind:tap="again">{{L.k02}}</pv-button>
          <pv-button type="plain" bind:tap="goDetail">{{L.k03}}</pv-button>
        </view>
      </block>

      <block wx:else>
        <pv-card>
          <text class="ci-title">{{L.k04}}</text>
          <text class="ui-meta ci-hint">{{L.k05}}</text>
          <view class="ci-scan">
            <pv-button type="filled" block="{{true}}" loading="{{scanning}}" disabled="{{scanning}}" bind:tap="scan">{{L.k06}}</pv-button>
          </view>
        </pv-card>

        <view class="pv-group-title">{{L.k07}}</view>
        <pv-card>
          <input class="ci-input" type="number" maxlength="6" value="{{code}}" placeholder="{{L.k08}}" placeholder-class="ui-placeholder" bindinput="onInput" />
          <pv-button type="tinted" block="{{true}}" loading="{{submitting}}" disabled="{{submitting || code.length < 4}}" bind:tap="submit">{{L.k09}}</pv-button>
        </pv-card>

        <text wx:if="{{error}}" class="ci-error">{{error}}</text>
        <text class="ui-meta ci-note">{{L.k10}}</text>
      </block>
    </view>
  </scroll-view>
</view>
