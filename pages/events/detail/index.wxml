<view class="{{themeClass}} ui-page ui-page--withbar page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="detail-inner">
      <block wx:if="{{loading}}">
        <view class="ui-card"><pv-skeleton rows="3" avatar /></view>
      </block>

      <pv-empty wx:elif="{{failed}}" title="{{L.k02}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k03}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{!ev}}" title="{{L.k04}}" desc="{{L.k05}}" />

      <block wx:else>
        <view wx:if="{{ev.cancelled}}" class="ev-alert ev-alert--danger">{{L.k53}}</view>
        <view wx:elif="{{ev.postponedText}}" class="ev-alert">{{L.k54}}{{ev.postponedText}}{{L.k55}}</view>

        <view class="ev-head">
          <text class="ev-head__title">{{ev.title}}</text>
          <view class="ui-row ev-head__tags">
            <pv-tag class="ev-tag" text="{{ev.club}}" type="tint" plain />
            <pv-tag class="ev-tag" text="{{ev.ended ? L.k16 : (ev.signupClosed ? L.k91 : (ev.full ? L.k17 : L.k18))}}" type="{{(ev.ended || ev.signupClosed) ? 'neutral' : (ev.full ? 'danger' : 'success')}}" />
          </view>
        </view>

        <pv-card>
          <view class="meta-row"><text class="meta-k">{{L.k06}}</text><text class="meta-v">{{ev.timeText}}{{ev.endText ? ' — ' + ev.endText : ''}}</text></view>
          <view class="meta-row"><text class="meta-k">{{L.k07}}</text><text class="meta-v">{{ev.location}}</text></view>
          <view class="meta-row"><text class="meta-k">{{L.k08}}</text><text class="meta-v ui-num">{{ev.capacityText}}</text></view>
          <!-- W-64 報名截止：沒設就不佔一行，設了才顯示 -->
          <view wx:if="{{ev.signupEndText}}" class="meta-row"><text class="meta-k">{{L.k90}}</text><text class="meta-v">{{ev.signupEndText}}</text></view>
          <view class="cap"><view class="cap__bar"><view class="cap__fill" style="width: {{ev.ratio}}%" /></view></view>
          <text wx:if="{{ev.remaining !== null}}" class="ui-meta">{{ev.remaining > 0 ? L.k19 + ev.remaining + L.k20 : L.k21}}</text>
          <view class="meta-row meta-row--action" bindtap="makeShareCard">
            <text class="meta-k">{{L.k60}}</text>
            <text class="meta-v meta-v--link">{{L.k67}}</text>
          </view>
        </pv-card>

        <view class="pv-group-title">{{L.k09}}</view>
        <pv-card>
          <text class="ui-body">{{ev.description || L.k22}}</text>
        </pv-card>

        <!-- W-38 活動附件（章程／場地圖）：點一下直接開或複製連結 -->
        <block wx:if="{{attachments.length}}">
          <view class="pv-group-title">{{L.k70}}</view>
          <pv-card>
            <view wx:for="{{attachments}}" wx:key="id" class="att-row" data-id="{{item.id}}" bindtap="openAttachment">
              <view class="att-main">
                <text class="att-name">{{item.name}}</text>
                <text class="att-meta">{{item.metaText}}</text>
              </view>
              <text wx:if="{{ev.canManageAttachments}}" class="att-del" data-id="{{item.id}}" catchtap="removeAttachment">{{L.k73}}</text>
            </view>
          </pv-card>
        </block>
        <view wx:if="{{ev.canManageAttachments}}" class="att-add" bindtap="addAttachment">
          <text class="att-add__text">{{L.k71}}</text>
        </view>

        <pv-card wx:if="{{groups.length}}">
          <text class="group-title">{{L.k10}}</text>
          <view class="group-chips">
            <view wx:for="{{groups}}" wx:key="*this"
                  class="group-chip {{(pickedGroup === item || ev.myGroupKey === item) ? 'group-chip--on' : ''}}"
                  data-group="{{item}}" bindtap="chooseGroup">{{item}}</view>
          </view>
          <text wx:if="{{ev.myGroupKey}}" class="group-hint">你已報名 {{ev.myGroupKey}}</text>
          <text wx:elif="{{!pickedGroup}}" class="group-hint">{{L.k11}}</text>
        </pv-card>

        <view wx:if="{{ev.myStatus}}" class="my-state">
          <text wx:if="{{ev.myStatus === 'CONFIRMED'}}">{{L.k12}}</text>
          <text wx:else>你在候補第 {{ev.waitlistPos}} 位，有名額釋出時會自動補上。</text>
        </view>

        <pv-card wx:if="{{ev.myStatus === 'CONFIRMED'}}">
          <view class="ui-row-between">
            <view class="checkin-info">
              <text class="checkin-info__title">{{ev.myCheckedIn ? L.k23 : L.k24}}</text>
              <text class="ui-meta">{{ev.myCheckedIn ? L.k25 : L.k26}}</text>
            </view>
            <pv-button wx:if="{{!ev.myCheckedIn}}" type="tinted" size="sm" bind:tap="goCheckin">{{L.k13}}</pv-button>
          </view>
        </pv-card>
        <!-- W-30 組隊報名 -->
        <view wx:if="{{ev.teamsEnabled}}" class="team-card">
          <text class="team-title">{{L.k61}}</text>
          <block wx:for="{{teams}}" wx:key="id" wx:for-item="tm">
            <view class="team-row" data-code="{{tm.code}}" bindtap="useTeamCode">
              <text class="team-row__name">{{tm.name}}</text>
              <text class="team-row__meta">{{tm.members}} 人{{tm.code ? ' · 邀請碼 ' + tm.code : ''}}</text>
            </view>
          </block>
          <text wx:if="{{!teams.length}}" class="team-empty">{{L.k62}}</text>
          <view class="ui-row" style="margin-top:16rpx">
            <pv-button size="sm" type="tinted" bind:tap="createTeam">{{L.k63}}</pv-button>
            <pv-button size="sm" bind:tap="joinByCode">{{L.k64}}</pv-button>
          </view>
          <text wx:if="{{pickedTeamCode}}" class="team-picked">{{L.k65}}{{pickedTeamCode}}</text>
        </view>

        <!-- W-31 活動回饋（活動結束後才出現） -->
        <view wx:if="{{ev.ended}}" class="fb-card">
          <text class="fb-title">{{L.k56}}</text>
          <text class="fb-avg" wx:if="{{fb.count}}">★ {{fb.avg}} · {{fb.count}} 人評分</text>
          <text class="fb-avg" wx:else>{{L.k57}}</text>

          <block wx:if="{{canFeedback}}">
            <view class="fb-stars">
              <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="fb-star {{fbDraft >= item ? 'fb-star--on' : ''}}"
                    data-v="{{item}}" bindtap="pickStar">★</text>
            </view>
            <textarea class="fb-input" value="{{fbComment}}" placeholder="{{L.k58}}" maxlength="300" bindinput="onFbInput" auto-height />
            <pv-button size="sm" type="tinted" bind:tap="submitFeedback">{{L.k59}}</pv-button>
          </block>

          <block wx:for="{{fb.items}}" wx:key="createdAt" wx:for-item="row">
            <view class="fb-item">
              <text class="fb-item__head">{{row.nickname}} · {{row.rating}}★</text>
              <text class="fb-item__body">{{row.comment}}</text>
            </view>
          </block>
        </view>

        <canvas type="2d" id="shareCanvas" class="share-canvas" />
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{ev}}" class="ui-bar">
    <view class="ui-bar__left">
      <text class="ui-bar__hint">{{barHint}}</text>
      <text class="ui-bar__report" catchtap="openReport">{{L.k14}}</text>
    </view>
    <pv-button type="{{barType}}" bind:tap="onPrimary" loading="{{submitting}}" disabled="{{submitting || barDisabled}}">{{barText}}</pv-button>
  </view>

  <pv-sheet show="{{reportOpen}}" title="{{L.k15}}" bind:close="closeReport">
    <view wx:for="{{reportReasons}}" wx:key="*this" class="report-row"
          data-reason="{{item}}" catchtap="pickReason">{{item}}</view>
  </pv-sheet>
</view>
