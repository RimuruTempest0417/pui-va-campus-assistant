@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.checkin-info { display: flex; flex-direction: column; }
.checkin-info__title { font-size: var(--pv-fs-callout); font-weight: 600; }

.detail-inner { padding: var(--pv-sp-3) var(--pv-sp-3) var(--pv-sp-6); }
.ev-head { padding-bottom: var(--pv-sp-2); }
.ev-head__title { font-size: var(--pv-fs-title-1); font-weight: 700; letter-spacing: var(--pv-ls-large-title); line-height: 1.2; }
.ev-head__tags { margin-top: var(--pv-sp-2); }
.ev-tag { margin-right: var(--pv-sp-1); }
.meta-row { display: flex; flex-direction: row; align-items: flex-start; padding: var(--pv-sp-1) 0; }
.meta-k { width: 96rpx; font-size: var(--pv-fs-subhead); color: var(--pv-label-2); }
.meta-v { flex: 1; font-size: var(--pv-fs-body); }
.cap { margin: var(--pv-sp-2) 0 var(--pv-sp-1); }
.cap__bar { height: 12rpx; border-radius: var(--pv-r-pill); background: var(--pv-fill); overflow: hidden; }
.cap__fill { height: 12rpx; background: var(--pv-tint); border-radius: var(--pv-r-pill); }
.my-state {
  margin-top: var(--pv-sp-3);
  background: var(--pv-tint-soft);
  color: var(--pv-tint);
  border-radius: var(--pv-r);
  padding: var(--pv-sp-2) var(--pv-sp-3);
  font-size: var(--pv-fs-subhead);
}

.group-title { display: block; font-size: var(--pv-fs-subhead); color: var(--pv-label-2); margin-bottom: var(--pv-sp-1); }
.group-chips { display: flex; flex-direction: row; flex-wrap: wrap; }
.group-chip {
  padding: 0 var(--pv-sp-3); line-height: 64rpx; margin: 0 var(--pv-sp-1) var(--pv-sp-1) 0;
  border-radius: 999rpx; background: var(--pv-fill); color: var(--pv-label-2); font-size: var(--pv-fs-subhead);
}
.group-chip--on { background: var(--pv-tint); color: var(--pv-on-tint); font-weight: 600; }
.group-hint { display: block; margin-top: var(--pv-sp-1); font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

.ui-bar__left { flex: 1; display: flex; flex-direction: column; }
.ui-bar__report { margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); text-decoration: underline; }
.report-row { padding: var(--pv-sp-3) 0; font-size: var(--pv-fs-callout); border-bottom: 1rpx solid var(--pv-sep); }

/* W-29 延期／取消提示條 */
.ev-alert { margin-bottom: var(--pv-sp-2); padding: var(--pv-sp-2) var(--pv-sp-3); border-radius: var(--pv-r-lg); background: var(--pv-warning-soft); color: var(--pv-label); font-size: var(--pv-fs-subhead); line-height: 1.5; }
.ev-alert--danger { background: var(--pv-brand-soft); }

/* W-31 回饋 */
.fb-card { margin-top: var(--pv-sp-3); background: var(--pv-surface); border-radius: var(--pv-r-lg); padding: var(--pv-sp-3); }
.fb-title { display: block; font-size: var(--pv-fs-callout); font-weight: 600; color: var(--pv-label); }
.fb-avg { display: block; margin-top: 6rpx; font-size: var(--pv-fs-footnote); color: var(--pv-label-3); }
.fb-stars { display: flex; flex-direction: row; margin: var(--pv-sp-2) 0; }
.fb-star { font-size: 44rpx; color: var(--pv-fill-2); margin-right: 12rpx; }
.fb-star--on { color: var(--pv-warning); }
.fb-input { width: 100%; min-height: 120rpx; padding: var(--pv-sp-2); border-radius: var(--pv-r-sm); background: var(--pv-fill); font-size: var(--pv-fs-subhead); color: var(--pv-label); margin-bottom: var(--pv-sp-2); }
.fb-item { margin-top: var(--pv-sp-2); padding-top: var(--pv-sp-2); border-top: 1rpx solid var(--pv-sep); }
.fb-item__head { display: block; font-size: var(--pv-fs-footnote); color: var(--pv-label-2); }
.fb-item__body { display: block; margin-top: 4rpx; font-size: var(--pv-fs-subhead); color: var(--pv-label); line-height: 1.5; }

/* W-32 分享卡 */
.share-card { margin-top: var(--pv-sp-3); padding: var(--pv-sp-3); border-radius: var(--pv-r-lg); background: var(--pv-tint); text-align: center; }
.share-card__text { color: var(--pv-on-tint); font-size: var(--pv-fs-callout); font-weight: 600; }
.share-canvas { position: fixed; left: -9999rpx; top: 0; width: 600px; height: 800px; }

/* W-30 組隊 */
.team-card { margin-top: var(--pv-sp-3); background: var(--pv-surface); border-radius: var(--pv-r-lg); padding: var(--pv-sp-3); }
.team-title { display: block; font-size: var(--pv-fs-callout); font-weight: 600; color: var(--pv-label); }
.team-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: var(--pv-sp-2) 0; border-bottom: 1rpx solid var(--pv-sep); }
.team-row__name { font-size: var(--pv-fs-subhead); color: var(--pv-label); font-weight: 600; }
.team-row__meta { font-size: var(--pv-fs-footnote); color: var(--pv-label-3); }
.team-empty { display: block; margin-top: var(--pv-sp-2); font-size: var(--pv-fs-footnote); color: var(--pv-label-3); }
.team-picked { display: block; margin-top: var(--pv-sp-2); font-size: var(--pv-fs-footnote); color: var(--pv-tint); }

/* W-38 活動附件 */
.att-row { display: flex; flex-direction: row; align-items: center; min-height: 88rpx; padding: var(--pv-sp-2) 0; border-bottom: 1rpx solid var(--pv-sep); }
.att-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.att-name { font-size: var(--pv-fs-subhead); color: var(--pv-label); }
.att-meta { margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
.att-del { flex-shrink: 0; margin-left: var(--pv-sp-2); font-size: var(--pv-fs-footnote); color: var(--pv-brand); }
.att-add { margin-top: var(--pv-sp-2); min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--pv-r-lg); background: var(--pv-fill); }
.att-add__text { font-size: var(--pv-fs-subhead); color: var(--pv-tint); font-weight: 600; }
