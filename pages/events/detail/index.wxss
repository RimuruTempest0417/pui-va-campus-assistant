@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.checkin-info { display: flex; flex-direction: column; }
.checkin-info__title { font-size: var(--pv-fs-callout); font-weight: 600; }

.detail-inner { padding: var(--pv-sp-3) var(--pv-sp-3) var(--pv-sp-6); }
.ev-head { padding-bottom: var(--pv-sp-2); }
.ev-head__title { font-size: var(--pv-fs-title-1); font-weight: 700; letter-spacing: var(--pv-ls-large-title); line-height: 1.2; }
.ev-head__tags { margin-top: var(--pv-sp-2); }
.ev-tag { margin-right: var(--pv-sp-1); }
.meta-row { display: flex; flex-direction: row; align-items: flex-start; padding: var(--pv-sp-1) 0; }
.meta-k { width: 96rpx; font-size: var(--pv-fs-subhead); color: var(--pv-label-2); }
.meta-v { flex: 1; font-size: var(--pv-fs-body); }
.cap { margin: var(--pv-sp-2) 0 var(--pv-sp-1); }
.cap__bar { height: 12rpx; border-radius: var(--pv-r-pill); background: var(--pv-fill); overflow: hidden; }
.cap__fill { height: 12rpx; background: var(--pv-tint); border-radius: var(--pv-r-pill); }
.my-state {
  margin-top: var(--pv-sp-3);
  background: var(--pv-tint-soft);
  color: var(--pv-tint);
  border-radius: var(--pv-r);
  padding: var(--pv-sp-2) var(--pv-sp-3);
  font-size: var(--pv-fs-subhead);
}
