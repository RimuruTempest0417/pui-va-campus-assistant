<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="list-inner">
      <view class="tabs-wrap">
        <pv-tabs tabs="{{tabs}}" current="{{scope}}" bind:change="onScopeChange" />
        <view class="mine-link" bindtap="goMine">{{L.k02}}</view>
      </view>

      <block wx:if="{{loading}}">
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row"><pv-skeleton rows="2" /></view>
          <view class="ui-card ui-card--row ui-card--last"><pv-skeleton rows="2" /></view>
        </view>
      </block>

      <pv-empty wx:elif="{{failed}}" tone="warning" title="{{L.k03}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k04}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{!items.length}}" title="{{L.k05}}" desc="{{L.k06}}" />

      <view wx:else class="ui-list ui-list--grouped">
        <view wx:for="{{items}}" wx:key="id" class="ui-card ui-card--row {{index === items.length - 1 ? 'ui-card--last' : ''}}"
              data-id="{{item.id}}" bindtap="goDetail"
              hover-class="ui-card--pressed" hover-start-time="0">
          <view class="ui-row-between">
            <text class="ui-title ev-title">{{item.title}}</text>
            <pv-tag wx:if="{{item.myLabel}}" text="{{item.myLabel}}" type="{{item.myStatus === 'CONFIRMED' ? 'success' : 'warning'}}" />
            <pv-tag wx:elif="{{item.ended}}" text="{{L.k07}}" />
            <pv-tag wx:elif="{{item.full}}" text="{{L.k08}}" type="danger" />
          </view>
          <text class="ui-meta ev-meta">{{item.club}} · {{item.timeText}}</text>
          <text class="ui-meta">{{item.location}}</text>

          <view class="cap">
            <view class="cap__bar"><view class="cap__fill" style="width: {{item.ratio}}%" /></view>
            <text class="cap__text ui-num">{{item.capacityText}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
