@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.list-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }
.tabs-wrap { margin-bottom: var(--pv-sp-2); }
.mine-link {
  text-align: right;
  padding: var(--pv-sp-1) 0 0;
  font-size: var(--pv-fs-subhead);
  color: var(--pv-tint);
}
.ev-title { flex: 1; margin-right: var(--pv-sp-2); }
.ev-meta { display: block; margin-top: 6rpx; }
.cap { margin-top: var(--pv-sp-2); display: flex; flex-direction: row; align-items: center; }
.cap__bar { flex: 1; height: 10rpx; border-radius: var(--pv-r-pill); background: var(--pv-fill); overflow: hidden; }
.cap__fill { height: 10rpx; background: var(--pv-tint); border-radius: var(--pv-r-pill); }
.cap__text { margin-left: var(--pv-sp-2); font-size: var(--pv-fs-caption-1); color: var(--pv-label-2); }

/* 去 AI 味（v0.57.0）：列表改成 iOS inset grouped —— 整份是一張卡，項目之間用髮絲線分隔，
   不要每一個項目各一張卡（那是「卡片堆疊」最明顯的來源）。 */
.ui-list { background: var(--pv-surface); border-radius: var(--pv-r-lg); overflow: hidden; }
.ui-list .ui-card--row { margin: 0; border-radius: 0; background: transparent; box-shadow: none; border-bottom: 1rpx solid var(--pv-sep); }
.ui-list .ui-card--last { border-bottom: 0; }
