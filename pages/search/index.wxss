@import "../../styles/tokens.wxss";
@import "../../styles/ui.wxss";

.search-inner { padding-bottom: var(--pv-sp-5); }

/* 搜尋框：填充底、12rpx 圓角、88rpx 高（＝44pt 最小觸控） */
.sbox {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--pv-sp-2);
  height: 88rpx;
  padding: 0 var(--pv-sp-3);
  margin-top: var(--pv-sp-2);
  background: var(--pv-fill);
  border-radius: var(--pv-r-sm);
}
.sbox__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--pv-fs-body);
  color: var(--pv-label);
}
.sbox__clear {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--pv-fill-2);
}
.sbox__clear-x { font-size: 24rpx; color: var(--pv-label-2); }

.recent { margin-top: var(--pv-sp-3); }
.recent__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--pv-sp-2);
}
.recent__clear { font-size: var(--pv-fs-footnote); color: var(--pv-tint); }
.chips { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--pv-sp-2); }
.chip {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 var(--pv-sp-3);
  font-size: var(--pv-fs-subhead);
  color: var(--pv-label);
  background: var(--pv-surface);
  border-radius: var(--pv-r-pill);
}

.retry { margin-top: var(--pv-sp-2); }

.sum { margin: var(--pv-sp-3) 0 var(--pv-sp-1); }

.grp { margin-bottom: var(--pv-sp-3); }
.grp__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx var(--pv-sp-1);
}
.grp__count { font-size: var(--pv-fs-footnote); color: var(--pv-label-3); }

.hit { display: flex; flex-direction: column; padding: var(--pv-sp-2) 0; }
.hit__head { display: flex; flex-direction: row; align-items: center; gap: var(--pv-sp-2); }
/* 標題吃掉剩餘寬度，徽章一定要 flex-shrink: 0 —— 否則被壓成一個看不出字的小方塊 */
.hit__title {
  flex: 1;
  min-width: 0;
  font-size: var(--pv-fs-callout);
  font-weight: 600;
  letter-spacing: var(--pv-ls-body);
  color: var(--pv-label);
}
.hit__badge { flex-shrink: 0; }
.hit__snippet {
  display: block;
  margin-top: 4rpx;
  font-size: var(--pv-fs-subhead);
  color: var(--pv-label-2);
  line-height: 1.45;
}
.hit__meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--pv-fs-caption-1);
  color: var(--pv-label-3);
}
