@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.repair-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

.toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--pv-sp-2);
  margin-bottom: var(--pv-sp-1);
}
.toolbar__summary {
  flex: 1;
  min-width: 0;
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  letter-spacing: var(--pv-ls-section);
}
/* 右上角膠囊：44pt 可點高度；flex-shrink 0，否則被 flex:1 的兄弟壓扁 */
.toolbar__action {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 var(--pv-sp-3);
  display: flex;
  align-items: center;
  border-radius: var(--pv-r-pill);
  background: var(--pv-tint-soft);
  color: var(--pv-tint);
  font-size: var(--pv-fs-footnote);
}

.group-title {
  margin: var(--pv-sp-3) var(--pv-sp-1) var(--pv-sp-1);
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  letter-spacing: var(--pv-ls-section);
}

.repair-row { display: flex; flex-direction: row; align-items: center; }
.repair-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.repair-title { flex: 1; min-width: 0; margin-right: var(--pv-sp-2); }
.repair-desc { color: var(--pv-label-2); }
.repair-cancel {
  flex-shrink: 0;
  margin-left: var(--pv-sp-2);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding-left: var(--pv-sp-2);
  font-size: var(--pv-fs-footnote);
  color: var(--pv-tint);
}
