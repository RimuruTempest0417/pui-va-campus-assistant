@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.form-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

/* 選項 chips：一列可換行，每個都不壓縮（Skyline 下 flex-shrink 會把字裁掉） */
.chip-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--pv-sp-2);
  margin-top: var(--pv-sp-2);
}
.chip {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 var(--pv-sp-3);
  display: flex;
  align-items: center;
  border-radius: var(--pv-r-sm);
  background: var(--pv-fill);
  color: var(--pv-label-2);
  font-size: var(--pv-fs-footnote);
}
.chip.is-active { background: var(--pv-tint-soft); color: var(--pv-tint); }

.form-hint {
  display: block;
  margin: var(--pv-sp-2) var(--pv-sp-1) var(--pv-sp-3);
  font-size: var(--pv-fs-caption-1);
  color: var(--pv-label-3);
  line-height: 1.5;
}

.submit-row { margin-top: var(--pv-sp-4); }
