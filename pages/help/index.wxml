<view class="help page-root {{themeClass}}">
  <pv-navbar title="{{L.title}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="help-inner">
      <view class="help-head">
        <text class="help-head__title">你現在是 {{roleText}}</text>
        <text class="help-head__sub">下面是依身分整理的操作說明；切到其他身分可以看到別人的流程。</text>
      </view>

      <view class="help-tabs">
        <view wx:for="{{tabs}}" wx:key="key"
              class="help-tab {{active === item.key ? 'help-tab--on' : ''}}"
              data-key="{{item.key}}" catchtap="pickTab">{{item.label}}</view>
      </view>

      <block wx:for="{{list}}" wx:key="q" wx:for-item="row">
        <pv-card>
          <text class="qa__q">{{row.q}}</text>
          <text class="qa__a">{{row.a}}</text>
        </pv-card>
      </block>

      <text class="help-foot">找不到答案？請向資訊管理員或班主任反映。</text>
    </view>
  </scroll-view>
</view>
