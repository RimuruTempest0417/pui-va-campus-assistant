<view class="pv-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="check-inner">
  <view class="pv-large-title">{{L.k01}}</view>
  <view class="pv-footnote" id="mode-line">模式：{{modeText}}｜通過 {{passed}}／{{total}}</view>

  <view id="check-summary" class="checks">
    <view wx:for="{{lines}}" wx:key="name" class="check {{item.ok ? 'ok' : 'bad'}}">
      <text class="check__name">{{item.name}}</text>
      <text class="check__val">{{item.value}}</text>
    </view>
  </view>

  <pv-card>
    <pv-button type="filled" block bind:tap="rerun">{{L.k02}}</pv-button>
  </pv-card>
  <pv-card>
    <view class="api-row">
      <text class="demo-row__title">{{L.k03}}</text>
      <text class="demo-row__desc">{{L.k04}}</text>
      <input class="api-input" value="{{apiBase}}" bindinput="onApiBaseInput" placeholder="http://127.0.0.1:3100/api/v1" />
      <view class="api-actions">
        <pv-button type="filled" size="sm" bind:tap="saveApiBase">{{L.k05}}</pv-button>
        <pv-button type="plain" size="sm" bind:tap="resetApiBase">{{L.k06}}</pv-button>
      </view>
    </view>
  </pv-card>
  <pv-card>
    <view class="demo-row">
      <view class="demo-row__text">
        <text class="demo-row__title">{{L.k07}}</text>
        <text class="demo-row__desc">{{L.k08}}</text>
      </view>
      <switch checked="{{forceDemo}}" bindchange="toggleDemo" color="{{theme.tint}}" />
    </view>
  </pv-card>
  <pv-card>
    <pv-button type="tinted" block bind:tap="resetDemo">{{L.k09}}</pv-button>
  </pv-card>
  <view class="pv-caption" id="result-line">{{resultLine}}</view>

    </view>
  </scroll-view>
</view>  <view class="ui-card">
    <text class="dev-label">{{localeTitle}}</text>
    <view class="dev-chips">
      <view wx:for="{{locales}}" wx:key="key" class="dev-chip {{locale === item.key ? 'dev-chip--on' : ''}}"
            data-loc="{{item.key}}" bindtap="setLocale">{{item.label}}</view>
    </view>
    <text class="dev-hint">{{L.k10}}</text>
  </view>


