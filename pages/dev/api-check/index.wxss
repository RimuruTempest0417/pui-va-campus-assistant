.check-inner { display: flex; flex-direction: column; gap: var(--pv-sp-2); padding: var(--pv-sp-3) var(--pv-sp-3) 72rpx; }
.check-inner pv-card { display: block; margin: 0; }
@import "../../../styles/tokens.wxss";

.checks { margin: var(--pv-sp-3) 0; background: var(--pv-surface); border-radius: var(--pv-r-lg); overflow: hidden; }
.check { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: var(--pv-sp-2) var(--pv-sp-3); border-bottom: 1rpx solid var(--pv-sep); }
.check:last-child { border-bottom: none; }
.check__name { font-size: var(--pv-fs-subhead); color: var(--pv-label-2); }
.check__val { font-size: var(--pv-fs-subhead); font-weight: 600; }
.check.ok .check__val { color: var(--pv-success); }
.check.bad .check__val { color: var(--pv-danger); }

.demo-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.demo-row__text { flex: 1; display: flex; flex-direction: column; margin-right: var(--pv-sp-2); }
.demo-row__title { font-size: var(--pv-fs-body); font-weight: 600; }
.demo-row__desc { font-size: var(--pv-fs-caption-1); color: var(--pv-label-2); margin-top: 4rpx; line-height: 1.4; }

.api-row { display: flex; flex-direction: column; }
.api-input {
  margin-top: var(--pv-sp-1); padding: 16rpx var(--pv-sp-2);
  background: var(--pv-fill); border-radius: var(--pv-r-sm);
  font-size: var(--pv-fs-subhead);
}
.api-actions { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--pv-sp-2); margin-top: var(--pv-sp-2); }

.dev-label { display: block; font-size: var(--pv-fs-subhead); color: var(--pv-label-2); margin-bottom: var(--pv-sp-1); }
.dev-chips { display: flex; flex-direction: row; gap: var(--pv-sp-2); }
.dev-chip {
  padding: 0 var(--pv-sp-3); line-height: 64rpx; border-radius: 999rpx;
  background: var(--pv-fill); color: var(--pv-label-2); font-size: var(--pv-fs-subhead);
}
.dev-chip--on { background: var(--pv-tint); color: var(--pv-on-tint); font-weight: 600; }
.dev-hint { display: block; margin-top: var(--pv-sp-1); font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
