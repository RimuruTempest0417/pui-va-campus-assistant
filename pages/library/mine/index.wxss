@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.mine-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

.stats { display: flex; flex-direction: row; gap: var(--pv-sp-2); }
.stat {
  flex: 1;
  background: var(--pv-surface);
  border-radius: var(--pv-r-lg);
  padding: var(--pv-sp-3);
  display: flex;
  flex-direction: column;
}
.stat__num { font-size: var(--pv-fs-title-1); font-weight: 600; }
.stat__num--warn { color: var(--pv-danger); }
.stat__label { font-size: var(--pv-fs-footnote); color: var(--pv-label-2); margin-top: 4rpx; }

.loan-row { padding: var(--pv-sp-2) 0 0; }
.loan-main { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.loan-title { flex: 1; min-width: 0; margin-right: var(--pv-sp-2); }
.loan-meta { margin-top: 6rpx; }

/* 自訂組件的 margin 不會穿透宿主 → 用 gap 控制兩顆按鈕的間距 */
.loan-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: var(--pv-sp-2);
  padding: var(--pv-sp-2) 0 var(--pv-sp-1);
}
