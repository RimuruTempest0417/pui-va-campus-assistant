<view class="{{themeClass}} ui-page page-root">
  <pv-refreshing />
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="hw-inner">
      <!-- W-98：離線資料橫幅（用上次成功的資料時一定要寫出時間） -->
      <view wx:if="{{offlineText}}" class="ui-offline">{{offlineText}}</view>
      <view class="hw-head">
        <view class="hw-head__main">
          <text class="hw-head__class">{{className}}</text>
          <text wx:if="{{!loading && !failed && !needLogin && !needsClass}}" class="hw-head__stats">{{L.k05}} {{stats.todo}} · {{L.k06}} {{stats.overdue}} · {{L.k07}} {{stats.done}}</text>
        </view>
      </view>

      <!-- W-94：老師的班級總覽（學生看不到；取不到資料時整區不出現，不影響功課清單） -->
      <view wx:if="{{classInfo && !loading && !failed && !needLogin && !needsClass}}" class="ui-list">
        <view class="ui-card hw-ov">
          <view class="ui-row-between">
            <text class="ui-title">{{L.k46}}</text>
            <text class="ui-meta">{{classInfo.className}} · {{classInfo.classSize}} {{L.k47}}</text>
          </view>
          <view class="hw-ov__grid">
            <view wx:for="{{overviewStats}}" wx:key="key" class="hw-ov__cell">
              <text class="hw-ov__num ui-num">{{item.value}}</text>
              <text class="hw-ov__label">{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{subjectLines.length}}" class="hw-ov__block">
            <text class="hw-ov__caption">{{L.k52}}</text>
            <view wx:for="{{subjectLines}}" wx:key="subject" class="hw-ov__line">
              <text class="hw-ov__line-text">{{item.text}}</text>
            </view>
          </view>
          <view class="hw-ov__block">
            <text class="hw-ov__caption">{{L.k50}}</text>
            <view wx:if="{{!leaveLines.length}}" class="hw-ov__line">
              <text class="hw-ov__line-text">{{L.k53}}</text>
            </view>
            <view wx:for="{{leaveLines}}" wx:key="id" class="hw-ov__line">
              <text class="hw-ov__line-text">{{item.text}}</text>
            </view>
          </view>

          <!-- W-106：本班出席率月報（點一列原地展開每日明細，不開新頁） -->
          <view wx:if="{{attendance}}" class="hw-ov__block">
            <view
              class="hw-att__head {{attPressed ? 'is-pressed' : ''}}"
              bindtap="toggleAttendance"
              bindtouchstart="pressAtt"
              bindtouchend="releaseAtt"
              bindtouchcancel="releaseAtt"
            >
              <view class="hw-att__text">
                <text class="hw-att__title">{{L.k55}}</text>
                <text class="hw-att__sub">{{attendance.subText}}</text>
              </view>
              <text class="hw-att__rate ui-num">{{attendance.rateText}}</text>
            </view>
            <view wx:if="{{attendanceOpen}}" class="hw-att__detail">
              <view wx:if="{{attendance.empty}}" class="hw-ov__line">
                <text class="hw-ov__line-text">{{L.k60}}</text>
              </view>
              <block wx:else>
                <text class="hw-ov__caption">{{L.k58}}</text>
                <view wx:for="{{attendance.dayLines}}" wx:key="key" class="hw-ov__line">
                  <text class="hw-att__date">{{item.dateText}}</text>
                  <text class="hw-ov__line-text">{{item.text}}</text>
                </view>
                <view wx:if="{{attendance.worstLines.length}}" class="hw-att__worst">
                  <text class="hw-ov__caption">{{L.k59}}</text>
                  <view wx:for="{{attendance.worstLines}}" wx:key="key" class="hw-ov__line">
                    <text class="hw-att__date">{{item.dateText}}</text>
                    <text class="hw-ov__line-text">{{item.text}}</text>
                  </view>
                </view>
              </block>
              <text class="hw-att__hint">{{L.k62}}</text>
            </view>
            <text wx:else class="hw-att__hint">{{L.k61}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!loading && !failed && !needLogin && !needsClass}}" class="hw-seg">
        <view class="hw-seg__item {{scope === 'todo' ? 'is-on' : ''}}" data-key="todo" bindtap="switchScope">{{L.k02}}</view>
        <view class="hw-seg__item {{scope === 'done' ? 'is-on' : ''}}" data-key="done" bindtap="switchScope">{{L.k03}}</view>
        <view class="hw-seg__item {{scope === 'all' ? 'is-on' : ''}}" data-key="all" bindtap="switchScope">{{L.k04}}</view>
      </view>

      <block wx:if="{{loading}}">
        <view class="ui-list ui-list--grouped">
          <view class="ui-card ui-card--row"><pv-skeleton rows="3" /></view>
          <view class="ui-card ui-card--row ui-card--last"><pv-skeleton rows="3" /></view>
        </view>
      </block>

      <pv-empty wx:elif="{{needLogin}}" title="{{L.k22}}" desc="{{L.k23}}">
        <pv-button type="tinted" size="sm" bind:tap="goLogin">{{L.k22}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{failed}}" tone="warning" title="{{L.k11}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k12}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{needsClass}}" title="{{L.k20}}" desc="{{L.k21}}" />

      <block wx:elif="{{items.length}}">
        <view class="ui-list ui-list--grouped">
          <view
            wx:for="{{items}}"
            wx:key="id"
            class="ui-card ui-card--row {{index === items.length - 1 ? 'ui-card--last' : ''}}"
            data-id="{{item.id}}"
            data-title="{{item.title}}"
            bindtouchstart="press"
            bindtouchend="release"
            bindtap="toggle"
          >
            <view class="hw-row {{pressedId === item.id ? 'is-pressed' : ''}}">
              <view class="hw-tick {{item.done ? 'is-done' : ''}}">
                <text wx:if="{{item.done}}" class="hw-tick__mark">✓</text>
              </view>
              <view class="hw-row__main">
                <view class="ui-row-between">
                  <text class="ui-title hw-row__title {{item.done ? 'is-done' : ''}}">{{item.subject}} · {{item.title}}</text>
                </view>
                <text wx:if="{{item.detail}}" class="ui-meta">{{item.detail}}</text>
                <view wx:if="{{item.links.length}}" class="hw-links">
                  <view
                    wx:for="{{item.links}}"
                    wx:for-item="link"
                    wx:key="url"
                    class="hw-link"
                    data-url="{{link.url}}"
                    catchtap="copyLink"
                  >
                    <text class="hw-link__text">{{link.text}}</text>
                  </view>
                </view>
                <view class="hw-row__foot">
                  <text class="hw-row__due {{item.overdue ? 'is-overdue' : ''}}">{{item.dueText}}</text>
                  <pv-tag wx:if="{{item.overdue}}" text="{{item.dueBadge}}" type="warning" />
                  <text wx:if="{{item.countText}}" class="hw-row__count" data-id="{{item.id}}" catchtap="openPending">{{item.countText}}{{L.k38}}</text>
                  <view wx:if="{{item.mine}}" class="hw-del" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="remove">
                    <text class="hw-del__text">{{L.k30}}</text>
                  </view>
                </view>
                <text wx:if="{{pendingId === item.id}}" class="hw-row__pending">{{L.k39}}：{{pendingNames}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <pv-empty wx:elif="{{scope === 'todo'}}" title="{{L.k14}}" desc="{{L.k15}}" />
      <pv-empty wx:elif="{{scope === 'done'}}" title="{{L.k16}}" desc="{{L.k17}}" />
      <pv-empty wx:else title="{{L.k18}}" desc="{{L.k19}}" />

      <view wx:if="{{canCreate && !loading && !needLogin}}" class="hw-foot">
        <pv-button type="filled" size="md" block="true" bind:tap="openForm">{{L.k24}}</pv-button>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{formOpen}}" class="hw-sheet" catchtouchmove="noop">
    <view class="hw-sheet__panel">
      <view class="hw-sheet__head">
        <text class="hw-sheet__title">{{L.k24}}</text>
        <text class="hw-sheet__cancel" bindtap="closeForm">{{L.k29}}</text>
      </view>
      <view class="hw-field">
        <text class="hw-field__label">{{L.k25}}</text>
        <input class="hw-input" value="{{formSubject}}" placeholder="{{L.k35}}" bindinput="onSubject" maxlength="40" />
      </view>
      <view class="hw-field">
        <text class="hw-field__label">{{L.k26}}</text>
        <input class="hw-input" value="{{formTitle}}" placeholder="{{L.k34}}" bindinput="onTitle" maxlength="120" />
      </view>
      <view class="hw-field">
        <text class="hw-field__label">{{L.k27}}</text>
        <picker mode="date" value="{{formDue}}" bindchange="onDue">
          <view class="hw-input hw-input--picker">{{formDue}}</view>
        </picker>
      </view>
      <view class="hw-field">
        <text class="hw-field__label">{{L.k40}}</text>
        <textarea
          class="hw-input hw-input--area"
          value="{{formLinks}}"
          placeholder="{{L.k41}}"
          maxlength="1600"
          auto-height
          bindinput="onLinks"
        />
      </view>
      <view class="hw-sheet__actions">
        <pv-button type="filled" size="md" block="true" bind:tap="submit">{{L.k28}}</pv-button>
      </view>
    </view>
  </view>
</view>
