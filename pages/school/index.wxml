<view class="school page-root {{themeClass}}">
  <pv-navbar title="{{L.title}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="school-inner">
      <pv-skeleton wx:if="{{loading}}" rows="{{4}}" />

      <pv-empty wx:elif="{{needLogin}}" title="{{L.needLoginTitle}}" desc="{{L.needLoginHint}}">
        <pv-button type="tinted" size="sm" bind:tap="goLogin">{{L.goLogin}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{failed}}" title="{{L.failTitle}}" desc="{{errorText || L.failHint}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.retry}}</pv-button>
      </pv-empty>

      <block wx:else>
        <!-- 家長：登入時已自動對應的子女（一位就直接顯示名字，多位給 chips 切換） -->
        <pv-card wx:if="{{isParent && children.length}}">
          <view class="ui-row-between">
            <text class="sch-title">{{L.myChildren}}</text>
            <pv-tag text="{{children.length}}{{L.childUnit}}" type="tint" />
          </view>
          <view class="sch-kids" wx:if="{{children.length > 1}}">
            <view wx:for="{{children}}" wx:key="studentId"
                  class="sch-kid {{item.studentId === activeChildId ? 'sch-kid--on' : ''}}"
                  data-id="{{item.studentId}}" bindtap="pickChild">{{item.nickname}}</view>
          </view>
          <text wx:else class="sch-hint">{{L.viewing}} · {{children[0].nickname}}</text>
          <!-- 已對應子女 ≠ 已連結同步：家長看到 linked:false 會以為沒對應到小孩，這裡講清楚 -->
          <text wx:if="{{!credLinked}}" class="sch-hint">{{L.childNoSyncHint}}</text>
        </pv-card>

        <pv-empty wx:elif="{{isParent}}" title="{{L.noChildren}}" desc="{{L.noChildrenHint}}" />

        <!-- 家校通帳密（同步用）：沒連結才顯示輸入框 -->
        <pv-card wx:if="{{!credLinked}}">
          <text class="sch-title">{{L.link}}</text>
          <text class="sch-hint">{{L.linkHint}}</text>
          <input class="sch-input" value="{{account}}" bindinput="onAccount" placeholder="{{L.account}}" />
          <input class="sch-input" value="{{password}}" bindinput="onPassword" password placeholder="{{L.password}}" />
          <view class="sch-actions">
            <pv-button type="filled" loading="{{linking}}" disabled="{{linking}}" bind:tap="link">{{L.link}}</pv-button>
          </view>
        </pv-card>

        <pv-card wx:else>
          <view class="ui-row-between">
            <text class="sch-title">{{L.linked}} · {{status.studentNo}}</text>
            <pv-tag text="{{status.className}}" type="tint" />
          </view>
          <view class="sch-actions">
            <pv-button size="sm" type="filled" loading="{{syncing}}" disabled="{{syncing}}" bind:tap="sync">{{isParent ? L.syncChild : L.sync}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="unlink">{{L.unlink}}</pv-button>
          </view>
          <!-- 分批同步：上次沒抓完就寫在這裡，讓使用者知道「再按一次」不是重來 -->
          <text wx:if="{{pendingCells > 0}}" class="sch-hint">{{L.pendingPrefix}}{{pendingCells}}{{L.pendingSuffix}}</text>
        </pv-card>

        <block wx:if="{{(isParent && children.length) || (!isParent && credLinked)}}">
          <view class="sch-tabs">
            <view class="sch-tab {{tab === 'grades' ? 'sch-tab--on' : ''}}" data-tab="grades" bindtap="pickTab">{{L.grades}}</view>
            <view class="sch-tab {{tab === 'attendance' ? 'sch-tab--on' : ''}}" data-tab="attendance" bindtap="pickTab">{{L.attendance}}</view>
          </view>

          <block wx:if="{{tab === 'grades'}}">
            <pv-card wx:if="{{grades.length}}">
              <view wx:for="{{grades}}" wx:key="id" class="g-row">
                <view class="g-main">
                  <text class="g-course">{{item.courseName}}</text>
                  <text class="g-meta">{{item.term}} · {{item.testType}} · {{item.dateText}}</text>
                  <text wx:if="{{item.manual}}" class="g-manual">{{L.manualTag}}</text>
                </view>
                <text class="g-score ui-num">{{item.scoreText}}</text>
              </view>
            </pv-card>
            <pv-empty wx:else title="{{isParent ? L.emptyGradesChild : L.emptyGrades}}" />
          </block>

          <block wx:else>
            <pv-card wx:if="{{attendance.length}}">
              <view class="sch-sum">
                <view class="sch-sum__cell"><text class="sch-sum__num ui-num">{{summary.total}}</text><text class="sch-sum__label">{{L.total}}</text></view>
                <view class="sch-sum__cell"><text class="sch-sum__num ui-num">{{summary.late}}</text><text class="sch-sum__label">{{L.late}}</text></view>
                <view class="sch-sum__cell"><text class="sch-sum__num ui-num">{{summary.absent}}</text><text class="sch-sum__label">{{L.absent}}</text></view>
              </view>
              <view wx:for="{{attendance}}" wx:key="id" class="a-row">
                <text class="a-date ui-num">{{item.dateText}}</text>
                <text class="a-time">{{item.amIn || '—'}} / {{item.pmOut || '—'}}</text>
                <text wx:if="{{item.manual}}" class="a-manual">{{L.manualTag}}</text>
                <pv-tag text="{{item.statusText}}" type="{{item.tone}}" />
              </view>
            </pv-card>
            <pv-empty wx:else title="{{L.emptyAttend}}" />
          </block>
        </block>
      </block>
    </view>
  </scroll-view>
</view>
