<view class="ui-page page-root">
  <pv-navbar title="我的子女" back="{{true}}" />

  <scroll-view
    class="page-scroll"
    scroll-y
    bounces
    show-scrollbar="{{false}}"
    enhanced="{{true}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="parent-inner">
      <block wx:if="{{loading}}">
        <view class="ui-card"><pv-skeleton rows="2" /></view>
        <view class="ui-card"><pv-skeleton rows="3" /></view>
      </block>

      <!-- 403：帳號不是家長（學生／老師／職員）。這是「這一頁不屬於你」，不是載入失敗 → 不給重試 -->
      <pv-empty
        wx:elif="{{denied}}"
        icon="👪"
        title="這一頁只給已綁定子女的家長"
        desc="目前的帳號不是家長身分（學生、老師、校方職員都沒有子女資料）。家長端要由學校在家長帳號下綁定學號之後，這裡才會有內容。"
      >
        <view class="state-actions">
          <pv-button type="tinted" size="sm" bind:tap="goHome">回首頁</pv-button>
          <pv-button class="state-actions__next" type="plain" size="sm" bind:tap="goLogin">切換帳號</pv-button>
        </view>
      </pv-empty>

      <!-- 401：沒登入或登入過期 → 給登入入口 -->
      <pv-empty
        wx:elif="{{guest}}"
        icon="🔐"
        title="請先在家長帳號登入"
        desc="子女的報名與認領要在家長帳號登入後才看得到。"
      >
        <view class="state-actions">
          <pv-button type="tinted" size="sm" bind:tap="goLogin">去登入</pv-button>
          <pv-button class="state-actions__next" type="plain" size="sm" bind:tap="goHome">回首頁</pv-button>
        </view>
      </pv-empty>

      <!-- 真的讀不到（斷網／伺服器錯誤）才給重試 -->
      <pv-empty
        wx:elif="{{failed}}"
        icon="⚠️"
        title="無法讀取子女資料"
        desc="{{errorText || '請稍後再試'}}"
      >
        <pv-button type="tinted" size="sm" bind:tap="retry">重試</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{!children.length}}" icon="👪" title="還沒有綁定的子女" desc="請聯絡學校把家長帳號綁到學生的學號" />

      <block wx:else>
        <view wx:if="{{tabs.length > 1}}" class="tabs-wrap">
          <pv-tabs tabs="{{tabs}}" current="{{activeId}}" bind:change="onSwitchChild" />
        </view>

        <view wx:if="{{child}}" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{child.student.nickname}}</text>
            <pv-tag text="{{child.relationLabel}}" type="tint" plain />
          </view>
          <text class="ui-meta kid-meta">{{child.student.grade ? child.student.grade : '—'}}{{child.student.className ? ' · ' + child.student.className + '班' : ''}}</text>
          <view class="stats">
            <view class="stat">
              <text class="stat__num">{{signups.length}}</text>
              <text class="stat__label">報名中</text>
            </view>
            <view class="stat">
              <text class="stat__num">{{child.claimCount}}</text>
              <text class="stat__label">認領申請</text>
            </view>
            <view class="stat">
              <text class="stat__num">{{child.unreadNotices}}</text>
              <text class="stat__label">未讀公告</text>
            </view>
          </view>
        </view>

        <view class="pv-group-title">報名中的活動</view>
        <view wx:if="{{signups.length}}" class="ui-list">
          <view wx:for="{{signups}}" wx:key="id" class="ui-card">
            <view class="ui-row-between" data-id="{{item.event.id}}" bindtap="goEvent" hover-class="ui-card--pressed" hover-start-time="0">
              <text class="ui-title row-title">{{item.event.title}}</text>
              <pv-tag text="{{item.statusLabel}}" type="{{item.tagType}}" />
            </view>
            <text class="ui-meta row-meta">{{item.timeText}}{{item.event.location ? ' · ' + item.event.location : ''}}</text>
            <view class="row-actions">
              <pv-button class="row-btn" type="plain" size="sm" data-id="{{item.event.id}}" bind:tap="onCancel">取消報名</pv-button>
            </view>
          </view>
        </view>
        <view wx:else class="ui-card"><pv-empty icon="🎟" title="還沒有報名" desc="由下方清單替孩子報名" /></view>

        <view class="pv-group-title">可代為報名</view>
        <view wx:if="{{openEvents.length}}" class="ui-list">
          <view wx:for="{{openEvents}}" wx:key="id" class="ui-card">
            <view class="ui-row-between" data-id="{{item.id}}" bindtap="goEvent" hover-class="ui-card--pressed" hover-start-time="0">
              <text class="ui-title row-title">{{item.title}}</text>
              <pv-tag wx:if="{{item.full}}" text="已滿" type="danger" />
              <pv-tag wx:else text="{{item.capText}}" type="tint" plain />
            </view>
            <text class="ui-meta row-meta">{{item.timeText}}{{item.location ? ' · ' + item.location : ''}}</text>
            <view class="row-actions">
              <pv-button class="row-btn" type="{{item.full ? 'plain' : 'tinted'}}" size="sm" data-id="{{item.id}}" bind:tap="onSignup">{{item.full ? '排候補' : '代為報名'}}</pv-button>
            </view>
          </view>
        </view>
        <view wx:else class="ui-card"><pv-empty icon="✅" title="近期活動都報過了" desc="有新活動時會出現在這裡" /></view>
      </block>
    </view>
  </scroll-view>
</view>
