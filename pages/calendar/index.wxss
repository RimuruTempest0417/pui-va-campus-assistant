@import "../../styles/tokens.wxss";
@import "../../styles/ui.wxss";

.cal-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

.cal-head {
  display: flex; flex-direction: row; align-items: center;
  padding: var(--pv-sp-2) 0 var(--pv-sp-3);
}
.cal-head__nav {
  width: 72rpx; height: 72rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--pv-r-sm); background: var(--pv-surface);
}
.cal-head__arrow { font-size: 40rpx; color: var(--pv-tint); line-height: 1; }
.cal-head__title {
  flex: 1; min-width: 0; text-align: center;
  font-size: var(--pv-fs-title-3); font-weight: 600; color: var(--pv-label);
}
.cal-head__today {
  /* 固定寬度＋不壓縮：曾量到只剩 18px，「今天」兩個字被裁成大半個紫色方塊 */
  flex-shrink: 0; width: 104rpx; height: 72rpx; margin-left: var(--pv-sp-2);
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--pv-r-sm);
  background: var(--pv-tint-soft);
}
.cal-head__today-text { font-size: var(--pv-fs-subhead); color: var(--pv-tint); font-weight: 600; }

.cal-week { display: flex; flex-direction: row; padding: 0 0 var(--pv-sp-1); }
.cal-week__cell {
  flex: 1; text-align: center;
  font-size: var(--pv-fs-caption-1); color: var(--pv-label-3);
}

.cal-grid {
  display: flex; flex-direction: row; flex-wrap: wrap;
  background: var(--pv-surface); border-radius: var(--pv-r-lg);
  padding: var(--pv-sp-1) 0;
}
.cal-cell {
  width: 14.2857%; height: 96rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: var(--pv-r-sm);
}
.cal-cell__day { font-size: var(--pv-fs-subhead); color: var(--pv-label); }
.cal-cell--out .cal-cell__day { color: var(--pv-label-4); }
.cal-cell--today { background: var(--pv-tint-soft); }
.cal-cell--today .cal-cell__day { color: var(--pv-tint); font-weight: 600; }
.cal-cell--on { background: var(--pv-tint); }
.cal-cell--on .cal-cell__day { color: var(--pv-on-tint); font-weight: 600; }

.cal-dots { display: flex; flex-direction: row; height: 12rpx; margin-top: 6rpx; }
.cal-dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin: 0 2rpx; }
.cal-dot--urgent { background: var(--pv-brand); }
.cal-dot--event { background: var(--pv-tint); }
.cal-dot--school { background: var(--pv-warning); }
.cal-dot--notice { background: var(--pv-label-3); }
.cal-cell--on .cal-dot--notice { background: var(--pv-on-tint-2); }
.cal-cell--on .cal-dot--event { background: var(--pv-on-tint); }

.cal-day {
  display: flex; flex-direction: row; align-items: baseline; justify-content: space-between;
  margin: var(--pv-sp-4) 0 var(--pv-sp-2);
}
.cal-day__title { font-size: var(--pv-fs-headline); font-weight: 600; }
.cal-day__count { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

/* 檢視切換：iOS 分段控制（底色 fill、選中白底＋粗體），44pt 高 */
.cal-modes {
  display: flex; flex-direction: row;
  background: var(--pv-fill); border-radius: var(--pv-r-sm);
  padding: 4rpx; margin: var(--pv-sp-2) 0;
}
.cal-mode {
  flex: 1; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: var(--pv-r-sm);
  font-size: var(--pv-fs-subhead); color: var(--pv-label-2);
  transition: background var(--pv-dur-release) var(--pv-ease), color var(--pv-dur-release) var(--pv-ease);
}
.cal-mode--on { background: var(--pv-surface); color: var(--pv-label); font-weight: 600; }
.cal-mode--pressed { opacity: 0.88; }

/* 一天一組：日期標題 + 一張 inset grouped 卡（列與列之間 1rpx 髮絲線） */
.tl-head {
  display: flex; flex-direction: row; align-items: baseline; justify-content: space-between;
  padding: 0 0 var(--pv-sp-2);
}
.tl-head__title { font-size: var(--pv-fs-footnote); color: var(--pv-label-2); letter-spacing: var(--pv-ls-section); }
.tl-head__range { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

.tl-day { margin-bottom: var(--pv-sp-4); }
.tl-day__head {
  display: flex; flex-direction: row; align-items: center;
  gap: var(--pv-sp-1);
  padding: 0 0 var(--pv-sp-1);
}
.tl-day__mark { width: 8rpx; height: 28rpx; border-radius: 4rpx; flex-shrink: 0; background: var(--pv-label-3); }
.tl-day__mark--urgent { background: var(--pv-brand); }
.tl-day__mark--exam { background: var(--pv-warning); }
.tl-day__mark--event { background: var(--pv-tint); }
.tl-day__mark--plain { background: var(--pv-label-3); }
.tl-day__date { font-size: var(--pv-fs-headline); font-weight: 600; color: var(--pv-label); }
.tl-day__week { font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
.tl-day__badge {
  flex-shrink: 0; padding: 2rpx 12rpx; border-radius: var(--pv-r-pill);
  background: var(--pv-tint-soft); color: var(--pv-tint);
  font-size: var(--pv-fs-caption-2); font-weight: 600;
}
.tl-day__count { margin-left: auto; flex-shrink: 0; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

/* 一列：標題（可兩行）在左、標籤在右；膠囊不壓縮，標題 min-width: 0 才能換行 */
.tl-row { display: flex; flex-direction: row; align-items: center; gap: var(--pv-sp-2); padding: 22rpx var(--pv-sp-3); }
.tl-row__main { flex: 1; min-width: 0; }
.tl-row__title { display: block; font-size: var(--pv-fs-callout); color: var(--pv-label); }
.tl-row__meta { display: block; margin-top: 4rpx; font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }
.tl-row__tag { flex-shrink: 0; }
.tl-row--pressed { background: var(--pv-fill); }

.tl-foot { display: block; margin-top: var(--pv-sp-2); font-size: var(--pv-fs-caption-1); color: var(--pv-label-3); }

.cal-src { display: flex; flex-direction: row; flex-wrap: wrap; gap: var(--pv-sp-1); padding-bottom: var(--pv-sp-2); }
.cal-src__chip {
  padding: 8rpx 20rpx; border-radius: var(--pv-r-pill);
  background: var(--pv-fill); color: var(--pv-label-2); font-size: var(--pv-fs-caption-1);
}
.cal-src__chip--on { background: var(--pv-tint-soft); color: var(--pv-tint); font-weight: 600; }
