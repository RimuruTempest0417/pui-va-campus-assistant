<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="detail-inner">
      <block wx:if="{{loading}}">
        <view class="ui-card"><pv-skeleton rows="4" /></view>
      </block>

      <pv-empty wx:elif="{{failed}}" icon="⚠️" title="{{L.k02}}" desc="{{errorText}}">
        <pv-button type="tinted" size="sm" bind:tap="retry">{{L.k03}}</pv-button>
      </pv-empty>

      <pv-empty wx:elif="{{!notice}}" icon="🕳" title="{{L.k04}}" desc="{{L.k05}}" />

      <block wx:else>
        <view class="head {{notice.kind === 'URGENT' ? 'head--urgent' : ''}}">
          <view class="ui-row head__tags">
            <pv-tag wx:if="{{notice.isPinned}}" class="head__tag" text="{{L.k06}}" type="tint" />
            <pv-tag class="head__tag" text="{{notice.kindLabel}}" type="{{notice.kindTag}}" />
          </view>
          <text class="head__title">{{notice.title}}</text>
          <text class="head__time">{{notice.timeText}}發布{{notice.expiresAt ? L.k09 + notice.expiresText : ''}}</text>
        </view>

        <pv-card>
          <text class="content">{{notice.content}}</text>
        </pv-card>

        <view wx:if="{{notice.kind === 'URGENT'}}" class="urgent-note">
          緊急公告由校方發布，如有疑問請聯絡校務處。
        </view>

        <text class="report-link" catchtap="openReport">{{L.k07}}</text>
      </block>
    </view>
  </scroll-view>

  <pv-sheet show="{{reportOpen}}" title="{{L.k08}}" bind:close="closeReport">
    <view wx:for="{{reportReasons}}" wx:key="*this" class="report-row"
          data-reason="{{item}}" catchtap="pickReason">{{item}}</view>
  </pv-sheet>
</view>
