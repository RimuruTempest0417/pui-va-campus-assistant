<view class="{{themeClass}} sv-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="sv-inner">
  <!-- 探針：尺寸完全由 CSS 變數決定；var() 不生效時會量到 0 -->
  <view id="token-probe" class="sv-probe" />

  <view class="sv-hero">
    <text class="sv-eyebrow">PUI VA CAMPUS</text>
    <text class="sv-title">{{L.k01}}</text>
    <text class="sv-sub">{{L.k02}}</text>
  </view>

  <!-- 色彩 -->
  <view class="pv-group-title">{{L.k03}}</view>
  <pv-card>
    <view class="sv-swatches">
      <view wx:for="{{colors}}" wx:key="varName" class="sv-swatch">
        <view class="sv-swatch__chip" style="background: {{item.value}}" />
        <text class="sv-swatch__name">{{item.name}}</text>
        <text class="sv-swatch__hex">{{item.value}}</text>
      </view>
    </view>
  </pv-card>

  <!-- 字階 -->
  <view class="pv-group-title">{{L.k04}}</view>
  <pv-card>
    <view wx:for="{{types}}" wx:key="cls" class="sv-type-row">
      <text class="{{item.cls}}">{{item.text}}</text>
      <text class="sv-type-label">{{item.label}}</text>
    </view>
  </pv-card>

  <!-- 按鈕 -->
  <view class="pv-group-title">{{L.k05}}</view>
  <pv-card>
    <view class="sv-gap">
      <pv-button class="sv-gap__item" type="filled" bind:tap="simulateLoading" loading="{{loading}}">{{L.k06}}</pv-button>
      <pv-button class="sv-gap__item" type="tinted">{{L.k07}}</pv-button>
      <pv-button class="sv-gap__item" type="plain">{{L.k08}}</pv-button>
      <pv-button class="sv-gap__item" type="destructive">{{L.k09}}</pv-button>
    </view>
    <view class="sv-gap">
      <pv-button class="sv-gap__item" type="filled" size="sm">{{L.k10}}</pv-button>
      <pv-button class="sv-gap__item" type="tinted" size="lg">{{L.k11}}</pv-button>
      <pv-button class="sv-gap__item" type="filled" disabled>{{L.k12}}</pv-button>
    </view>
    <view class="sv-gap">
      <pv-button class="sv-gap__item" type="filled" block>{{L.k13}}</pv-button>
    </view>
  </pv-card>

  <!-- 標籤與頭像 -->
  <view class="pv-group-title">{{L.k14}}</view>
  <pv-card>
    <view class="sv-gap">
      <pv-tag class="sv-gap__item" text="{{L.k15}}" type="warning" />
      <pv-tag class="sv-gap__item" text="{{L.k16}}" type="success" />
      <pv-tag class="sv-gap__item" text="{{L.k17}}" />
      <pv-tag class="sv-gap__item" text="{{L.k18}}" type="danger" />
      <pv-tag class="sv-gap__item" text="{{L.k19}}" type="tint" plain />
      <pv-tag class="sv-gap__item" text="{{L.k20}}" type="brand" />
    </view>
    <view class="sv-gap sv-avatars">
      <pv-avatar class="sv-gap__item" name="霖" size="sm" />
      <pv-avatar class="sv-gap__item" name="培華" size="md" />
      <pv-avatar class="sv-gap__item" name="資訊管理員" size="lg" />
    </view>
  </pv-card>

  <!-- 分段控制 -->
  <view class="pv-group-title">{{L.k21}}</view>
  <pv-tabs tabs="{{tabs}}" current="{{tab}}" bind:change="onTabChange" />
  <view class="pv-footnote" style="margin-top: 16rpx;">目前選中：{{tab}}</view>

  <!-- 列表樣式 -->
  <view class="pv-group-title">{{L.k22}}</view>
  <pv-card padded="{{false}}">
    <view class="sv-cell">
      <text class="sv-cell__label">{{L.k23}}</text>
      <text class="sv-cell__value">{{L.k24}}</text>
    </view>
    <view class="sv-cell">
      <text class="sv-cell__label">{{L.k25}}</text>
      <text class="sv-cell__value">{{L.k26}}</text>
    </view>
    <view class="sv-cell sv-cell--last">
      <text class="sv-cell__label">{{L.k27}}</text>
      <pv-tag class="sv-gap__item" text="1" type="danger" />
    </view>
  </pv-card>

  <!-- 骨架屏 -->
  <view class="pv-group-title">{{L.k28}}</view>
  <pv-card padded="{{false}}">
    <pv-skeleton rows="3" avatar />
    <view class="sv-divider" />
    <pv-skeleton rows="2" />
  </pv-card>

  <!-- 空狀態 -->
  <view class="pv-group-title">{{L.k29}}</view>
  <pv-card padded="{{false}}">
    <pv-empty title="{{L.k30}}" desc="{{L.k31}}">
      <pv-button class="sv-gap__item" type="tinted" size="sm">{{L.k32}}</pv-button>
    </pv-empty>
  </pv-card>

  <!-- 彈層 -->
  <view class="pv-group-title">{{L.k33}}</view>
  <pv-button class="sv-gap__item" type="plain" block bind:tap="openSheet">{{L.k34}}</pv-button>

  

  <view class="sv-foot">{{L.k35}}</view>

    </view>
  </scroll-view>
<pv-sheet show="{{sheetShow}}" title="{{L.k36}}" bind:close="closeSheet">
    <view class="pv-sheet-item">{{L.k37}}</view>
    <view class="pv-sheet-item">{{L.k38}}</view>
    <view class="pv-sheet-item">{{L.k39}}</view>
  </pv-sheet>
</view>
