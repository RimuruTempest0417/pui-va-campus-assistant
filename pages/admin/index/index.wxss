@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.tabs-scroll { height: 104rpx; flex-shrink: 0; background: var(--pv-bg); }
.tabs { display: flex; flex-direction: row; align-items: center; height: 104rpx; padding: 0 var(--pv-sp-2); }
.tab {
  flex-shrink: 0;
  padding: 14rpx var(--pv-sp-3); margin-right: var(--pv-sp-1);
  border-radius: var(--pv-r-pill); background: var(--pv-surface);
  font-size: var(--pv-fs-subhead); color: var(--pv-label-2);
}
.tab--on { background: var(--pv-brand); color: var(--pv-on-tint); font-weight: 600; }

.admin-inner { padding: var(--pv-sp-2) var(--pv-sp-3) var(--pv-sp-6); }

/* 後台統計首頁（W-39）：本週五張卡，點一下跳到對應分頁 */
.ov-head { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; margin: var(--pv-sp-1) 0 var(--pv-sp-2); }
.ov-head__title { font-size: var(--pv-fs-headline); font-weight: 600; color: var(--pv-label); }
.ov-head__hint { font-size: var(--pv-fs-caption-2); color: var(--pv-label-3); }
.ov-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: var(--pv-sp-1); }
.ov-card {
  width: 31%; margin: 0 1% var(--pv-sp-2) 0; box-sizing: border-box;
  min-height: 88rpx; background: var(--pv-surface); border-radius: var(--pv-r-sm);
  padding: var(--pv-sp-2); display: flex; flex-direction: column;
  transition: transform 180ms cubic-bezier(.32,.72,0,1), opacity 180ms cubic-bezier(.32,.72,0,1);
}
.ov-card--pressed { transform: scale(.96); opacity: .88; transition-duration: 60ms; }
.ov-card__top { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.ov-card__num { font-size: 44rpx; font-weight: 700; line-height: 1.1; color: var(--pv-tint); }
.ov-card__go { font-size: var(--pv-fs-footnote); color: var(--pv-label-3); }
.ov-card__label { font-size: var(--pv-fs-caption-2); color: var(--pv-label-2); margin-top: 6rpx; }
.ov-section { margin: var(--pv-sp-3) 0 var(--pv-sp-2); }

.stat-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: var(--pv-sp-2); }
.stat {
  width: 31%; margin: 0 1% var(--pv-sp-2) 0;
  background: var(--pv-fill); border-radius: var(--pv-r-sm);
  padding: var(--pv-sp-2); display: flex; flex-direction: column;
}
.stat__num { font-size: 40rpx; font-weight: 700; color: var(--pv-label); }
.stat__label { font-size: var(--pv-fs-caption-2); color: var(--pv-label-2); }

.row-actions { display: flex; flex-direction: row; margin-top: var(--pv-sp-2);
  gap: var(--pv-sp-2);
  flex-wrap: wrap;
}
.row-actions pv-button { margin-right: var(--pv-sp-2); }

.filter-row { display: flex; flex-direction: row; flex-wrap: wrap; margin: var(--pv-sp-1) 0; }
.chip {
  padding: 10rpx var(--pv-sp-2); margin: 0 var(--pv-sp-1) 8rpx 0;
  border-radius: var(--pv-r-pill); background: var(--pv-fill);
  font-size: var(--pv-fs-footnote); color: var(--pv-label-2);
}
.chip--on { background: var(--pv-tint-soft); color: var(--pv-tint); font-weight: 600; }

.field__input {
  padding: 18rpx var(--pv-sp-2); background: var(--pv-fill);
  border-radius: var(--pv-r-sm); font-size: var(--pv-fs-body);
}
.field__textarea { min-height: 200rpx; width: 100%; box-sizing: border-box; }
.switch-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: var(--pv-sp-2); }
.ci-box { display: flex; flex-direction: row; align-items: center; margin-top: var(--pv-sp-2); }
.ci-qr { width: 240rpx; height: 240rpx; border-radius: var(--pv-r-sm); background: var(--pv-surface); }
.ci-side { display: flex; flex-direction: column; margin-left: var(--pv-sp-3); }
.ci-code { font-size: 56rpx; font-weight: 700; letter-spacing: 8rpx; color: var(--pv-label); }
.ci-off { display: block; margin-top: var(--pv-sp-2); line-height: 1.45; }
.ci-list { margin-top: var(--pv-sp-2); }
.ci-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid var(--pv-sep); }
.ci-row__name { font-size: var(--pv-fs-body); }
.ci-row__right { display: flex; flex-direction: row; align-items: center; }
.signup-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid var(--pv-sep); }
.signup-row__name { font-size: var(--pv-fs-body); }
.hint { display: block; margin-top: var(--pv-sp-2); }

.field__gap { margin-top: var(--pv-sp-1); }

.edit-box {
  margin-top: var(--pv-sp-2);
  padding: var(--pv-sp-2);
  background: var(--pv-fill);
  border-radius: var(--pv-r-sm);
}

.stat-row {
  display: flex;
  gap: var(--pv-sp-2);
  margin: var(--pv-sp-2) 0;
}
.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--pv-sp-2) 0;
  background: var(--pv-fill);
  border-radius: var(--pv-r-sm);
}
.stat-cell__num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--pv-tint);
}
.stat-cell__label {
  font-size: 22rpx;
  color: var(--pv-label-3);
  margin-top: 4rpx;
}

.group-stat { margin: var(--pv-sp-2) 0; }
.group-stat__row {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  padding: var(--pv-sp-1) 0; border-bottom: 1rpx solid var(--pv-sep);
}
.group-stat__name { font-size: var(--pv-fs-subhead); font-weight: 600; color: var(--pv-label); }

/* W-55 回饋統計：與報名統計同一張卡，用一段細分隔線開頭，不再多包一層卡片 */
.fb-box { margin-top: var(--pv-sp-2); padding-top: var(--pv-sp-2); border-top: 1rpx solid var(--pv-sep); }
.fb-box__line { display: block; line-height: 1.45; }
.fb-item {
  display: flex; flex-direction: row; align-items: flex-start;
  padding: var(--pv-sp-1) 0; border-bottom: 1rpx solid var(--pv-sep);
}
.fb-item:last-child { border-bottom: none; }
.fb-item__stars { flex-shrink: 0; width: 130rpx; font-size: var(--pv-fs-footnote); color: var(--pv-accent); letter-spacing: 1rpx; }
.fb-item__text { flex: 1; min-width: 0; font-size: var(--pv-fs-footnote); line-height: 1.45; color: var(--pv-label-2); }
/* W-56 催填回饋：按鈕與結果提示同一列，窄屏自動換行（gap 一律用 sp-2，不靠 margin 穿透組件） */
.fb-box__actions {
  display: flex; flex-direction: row; align-items: center; flex-wrap: wrap;
  gap: var(--pv-sp-2); margin-top: var(--pv-sp-2);
}
.fb-box__hint { flex: 1; min-width: 0; color: var(--pv-label-2); }

/* 批次匯入（活動／菜單）：逐列結果像 iOS 的清單，成功用主字色、失敗才用警示色 */
.imp-hint { display: block; margin-top: var(--pv-sp-1); line-height: 1.45; }
.imp-sum { display: block; margin-top: var(--pv-sp-2); }
.imp-row { display: flex; flex-direction: row; align-items: flex-start; padding: 10rpx 0; border-bottom: 1rpx solid var(--pv-sep); }
.imp-row__line { width: 140rpx; flex-shrink: 0; font-size: var(--pv-fs-caption-1); color: var(--pv-label-2); }
.imp-row__msg { flex: 1; font-size: var(--pv-fs-footnote); line-height: 1.45; }
.imp-row__msg--ok { color: var(--pv-label); }
.imp-row__msg--bad { color: var(--pv-warning); }

/* ── W-66 圖書館分頁 ── */
/* 兩欄輸入（分類／索書號、館藏量／借期）：窄屏各佔一半，用 gap 而不是 margin， */
/* 自訂組件與 input 都不會互相擠在一起。 */
.lib-two { display: flex; flex-direction: row; gap: var(--pv-sp-2); }
.lib-two__col { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.lib-two__col .field__input { width: 100%; box-sizing: border-box; }

/* 「掃書號」是一個小動作，做成文字按鈕比第二顆實心鈕低調 */
.lib-scan {
  flex-shrink: 0;
  font-size: var(--pv-fs-footnote);
  color: var(--pv-tint);
  background: var(--pv-fill);
  border-radius: var(--pv-r-pill);
  padding: 6rpx var(--pv-sp-2);
}

.lib-row { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; gap: var(--pv-sp-2); }
.lib-row__main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.lib-row .row-actions { margin-top: 0; flex-wrap: nowrap; }

/* 場地分頁（W-67）：子模式標題與緊湊 chip 列 */
.group-sub {
  display: block;
  margin: var(--pv-sp-3) var(--pv-sp-1) var(--pv-sp-1);
  font-size: var(--pv-fs-footnote);
  color: var(--pv-label-2);
  letter-spacing: var(--pv-ls-section);
}
.filter-row--tight { margin: var(--pv-sp-2) 0 0; gap: var(--pv-sp-2); }
