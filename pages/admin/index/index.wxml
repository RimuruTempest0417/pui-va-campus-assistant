<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="tabs-scroll" scroll-x enable-flex show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab--on' : ''}}"
            data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </view>
  </scroll-view>

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="admin-inner">

      <block wx:if="{{tabLoading}}">
        <view class="ui-card"><pv-skeleton rows="2" /></view>
        <view class="ui-card"><pv-skeleton rows="3" /></view>
      </block>

      <block wx:elif="{{failed}}">
        <pv-empty title="{{L.k02}}" desc="{{errorText}}">
          <pv-button size="sm" type="tinted" bind:tap="reloadTab">{{L.k03}}</pv-button>
        </pv-empty>
      </block>

      <!-- 概況 -->
      <block wx:elif="{{tab === 'stats'}}">
        <view class="ov-head">
          <text class="ov-head__title">{{L.k157}}</text>
          <text class="ov-head__hint">{{L.k159}}</text>
        </view>
        <view class="ov-grid">
          <view wx:for="{{ovCards}}" wx:key="key"
                class="ov-card {{ovPressed === index ? 'ov-card--pressed' : ''}}"
                data-key="{{item.target}}" data-i="{{index}}"
                bindtap="switchTab" bindtouchstart="ovDown" bindtouchend="ovUp" bindtouchcancel="ovUp">
            <view class="ov-card__top">
              <text class="ov-card__num ui-num">{{item.value}}</text>
              <text class="ov-card__go">›</text>
            </view>
            <text class="ov-card__label">{{item.label}}</text>
          </view>
        </view>

        <text class="ui-section ov-section">{{L.k158}}</text>
        <view class="stat-grid">
          <view class="stat"><text class="stat__num ui-num">{{stats.users}}</text><text class="stat__label">{{L.k04}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{stats.items.open}}</text><text class="stat__label">{{L.k05}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{stats.claimsPending}}</text><text class="stat__label">{{L.k06}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{stats.signups.confirmed}}</text><text class="stat__label">{{L.k07}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{stats.signups.waitlist}}</text><text class="stat__label">{{L.k08}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{stats.noticesActive}}</text><text class="stat__label">{{L.k09}}</text></view>
        </view>
        <pv-card>
          <text class="ui-meta">近 7 天新增失物 {{stats.items.added7d}} 筆｜已認領 {{stats.items.claimed}} 筆｜評分 {{stats.ratings.count}} 則（平均 {{stats.ratings.avg}}）</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="logout">{{L.k10}}</pv-button>
          </view>
        </pv-card>
      </block>

      <!-- 待審認領 -->
      <block wx:elif="{{tab === 'claims'}}">
        <pv-empty wx:if="{{!claims.length}}" title="{{L.k11}}" desc="{{L.k12}}" />
        <view wx:if="{{claims.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{claims}}" wx:key="id" class="ui-card ui-card--row {{index === claims.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.item.title}}</text>
              <pv-tag text="{{item.item.place}}" plain />
            </view>
            <text class="ui-meta">申請人：{{item.claimant.nickname}} {{item.claimant.className || ''}}</text>
            <text wx:if="{{item.message}}" class="ui-meta">特徵：{{item.message}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="filled" data-id="{{item.id}}" data-ok="1" bind:tap="review">{{L.k13}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-ok="0" bind:tap="review">{{L.k14}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 失物管理 -->
      <block wx:elif="{{tab === 'items'}}">
        <view class="filter-row">
          <view wx:for="{{statusFilters}}" wx:key="key" class="chip {{itemStatus === item.key ? 'chip--on' : ''}}"
                data-key="{{item.key}}" bindtap="filterItems">{{item.label}}</view>
        </view>
        <view class="row-actions">
          <pv-button size="sm" type="plain" data-kind="items" bind:tap="openPrint">{{L.k126}}</pv-button>
        </view>
        <view wx:if="{{items.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{items}}" wx:key="id" class="ui-card ui-card--row {{index === items.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.deletedAt ? L.k85 : item.status}}" type="{{item.deletedAt ? 'danger' : 'neutral'}}" />
            </view>
            <text class="ui-meta">{{item.type === 'FOUND' ? L.k86 : L.k87}} · {{item.place}} · {{item.author.nickname}} · 申請 {{item._count.claims}}</text>
            <view class="row-actions">
              <pv-button wx:if="{{item.deletedAt}}" size="sm" type="plain" data-id="{{item.id}}" data-act="RESTORE" bind:tap="moderate">{{L.k15}}</pv-button>
              <pv-button wx:else size="sm" type="plain" data-id="{{item.id}}" data-act="REMOVE" bind:tap="moderate">{{L.k16}}</pv-button>
              <pv-button wx:if="{{!item.deletedAt}}" size="sm" type="plain" data-id="{{item.id}}" data-title="{{item.title}}" bind:tap="removeItem">{{L.k22}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 資源回收桶（W-40） -->
      <block wx:elif="{{tab === 'trash'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">{{L.k145}}</text>
            <text class="ui-meta">{{L.k147}} {{trashCounts.notice}} {{L.k150}} · {{L.k148}} {{trashCounts.item}} {{L.k150}} · {{L.k149}} {{trashCounts.all}} {{L.k150}}</text>
          </view>
          <text class="ui-meta">{{L.k146}}</text>
          <view class="filter-row">
            <view wx:for="{{trashFilters}}" wx:key="key" class="chip {{trashType === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickTrashType">{{item.label}}</view>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!trashRows.length}}" title="{{L.k154}}" desc="{{L.k155}}" />

        <view wx:if="{{trashRows.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{trashRows}}" wx:key="id" class="ui-card ui-card--row {{index === trashRows.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.typeText}}" type="neutral" />
            </view>
            <text class="ui-meta">{{item.subText}} · {{L.k151}} {{item.timeText}}</text>
            <text class="ui-meta">{{L.k152}} {{item.deleterText}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-type="{{item.type}}" data-title="{{item.title}}" bind:tap="restoreTrash">{{L.k153}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 發公告 -->
      <block wx:elif="{{tab === 'notice'}}">
        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k17}}</text>
          <input class="field__input" value="{{notice.title}}" bindinput="onNoticeTitle" maxlength="120" />
          <text class="ui-section ui-mt-2">{{L.k18}}</text>
          <textarea class="field__input field__textarea" value="{{notice.content}}" bindinput="onNoticeContent" maxlength="2000" />
          <text class="ui-section ui-mt-2">{{L.k19}}</text>
          <view class="filter-row">
            <view wx:for="{{kinds}}" wx:key="key" class="chip {{notice.kind === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickKind">{{item.label}}</view>
          </view>
          <view class="switch-row">
            <text class="ui-meta">{{L.k20}}</text>
            <switch checked="{{notice.isPinned}}" bindchange="onPinned" color="{{theme.tint}}" />
          </view>
          <!-- W-58 預約發佈：選日期＝排程，選了才出現時間 -->
          <text class="ui-section ui-mt-2">{{L.k252}}</text>
          <view class="filter-row">
            <picker mode="date" value="{{notice.publishDate}}" start="{{today}}" bindchange="onPublishDate">
              <view class="chip {{notice.publishDate ? 'chip--on' : ''}}">{{notice.publishDate || L.k255}}</view>
            </picker>
            <picker wx:if="{{notice.publishDate}}" mode="time" value="{{notice.publishTime}}" bindchange="onPublishTime">
              <view class="chip chip--on">{{notice.publishTime}}</view>
            </picker>
            <view wx:if="{{notice.publishDate}}" class="chip" bindtap="clearSchedule">{{L.k256}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="publish">{{L.k21}}</pv-button>
          </view>
        </pv-card>

        <text class="ui-section ui-mt-2">既有公告（{{noticeList.length}}）</text>
        <view wx:if="{{noticeList.length}}" class="ui-list ui-list--grouped">
          <block wx:for="{{noticeList}}" wx:key="id">
            <view class="ui-card ui-card--row {{index === noticeList.length - 1 && !(noticeStats && noticeStats.id === item.id) ? 'ui-card--last' : ''}}">
              <view class="ui-row-between">
                <text class="ui-title">{{item.title}}</text>
                <pv-tag text="{{item.kind === 'URGENT' ? L.k88 : item.kind === 'CALENDAR' ? L.k89 : L.k90}}" type="{{item.kind === 'URGENT' ? 'danger' : 'neutral'}}" />
              </view>
              <text wx:if="{{item.scheduled}}" class="ui-meta">{{L.k254}} {{item.publishText}}</text>
              <text class="ui-meta">{{L.k224}} {{item.read}} / {{item.total}}</text>
              <view class="row-actions">
                <pv-button wx:if="{{item.scheduled}}" size="sm" type="plain" data-id="{{item.id}}" data-version="{{item.version}}" bind:tap="publishNoticeNow">{{L.k253}}</pv-button>
                <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="openNoticeStats">{{L.k225}}</pv-button>
                <pv-button size="sm" type="plain" data-id="{{item.id}}" data-title="{{item.title}}" bind:tap="remindNotice">{{L.k226}}</pv-button>
                <pv-button size="sm" type="plain" data-id="{{item.id}}" data-pinned="{{item.isPinned ? '1' : '0'}}" data-version="{{item.version}}" bind:tap="togglePin">
                  {{item.isPinned ? L.k91 : L.k92}}
                </pv-button>
                <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteNotice">{{L.k22}}</pv-button>
              </view>
            </view>
            <view wx:if="{{noticeStats && noticeStats.id === item.id}}" class="ui-card ui-card--row {{index === noticeList.length - 1 ? 'ui-card--last' : ''}}">
              <text class="ui-section">{{L.k224}} {{noticeStats.readText}}</text>
              <text class="ui-meta">{{L.k227}}{{noticeStats.readerText}}</text>
              <text class="ui-meta">{{L.k228}}{{noticeStats.unreadText}}</text>
              <text wx:if="{{noticeStats.moreText}}" class="ui-meta">{{noticeStats.moreText}}</text>
            </view>
          </block>
        </view>
      </block>

      <!-- 活動管理 -->
      <block wx:elif="{{tab === 'events'}}">
        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k23}}</text>
          <input class="field__input" value="{{eventForm.title}}" data-field="title" bindinput="onEventField" placeholder="{{L.k24}}" />
          <input class="field__input field__gap" value="{{eventForm.location}}" data-field="location" bindinput="onEventField" placeholder="{{L.k25}}" />
          <input class="field__input field__gap" value="{{eventForm.date}}" data-field="date" bindinput="onEventField" placeholder="{{L.k26}}" />
          <input class="field__input field__gap" value="{{eventForm.capacity}}" data-field="capacity" bindinput="onEventField" placeholder="{{L.k27}}" />
          <input class="field__input field__gap" value="{{eventForm.groups}}" data-field="groups" bindinput="onEventField" placeholder="{{L.k28}}" />
          <input class="field__input field__gap" value="{{eventForm.signupEnd}}" data-field="signupEnd" bindinput="onEventField" placeholder="{{L.k261}}" />
          <view class="ui-row field__gap" bindtap="toggleEvTeams">
            <text class="ui-section ui-mt-2">{{teamsEnabled ? '☑' : '☐'}}</text>
            <text class="field__hint">{{L.k201}}</text>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingEvent}}" disabled="{{creatingEvent}}" bind:tap="createEvent">{{L.k29}}</pv-button>
            <pv-button size="sm" type="plain" data-type="events" bind:tap="openImport">{{L.k30}}</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{evStats}}">
          <view class="ui-row-between">
            <text class="ui-title">{{evStats.title}}</text>
            <pv-tag text="{{evStats.full ? L.k93 : (evStats.unlimited ? L.k94 : L.k95)}}" type="{{evStats.full ? 'warning' : 'success'}}" />
          </view>
          <view class="stat-row">
            <view class="stat-cell"><text class="stat-cell__num ui-num">{{evStats.signed}}</text><text class="stat-cell__label">{{L.k31}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num ui-num">{{evStats.waitlisted}}</text><text class="stat-cell__label">{{L.k32}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num ui-num">{{evStats.unlimited ? '∞' : evStats.remaining}}</text><text class="stat-cell__label">{{L.k33}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num ui-num">{{evStats.cancelled}}</text><text class="stat-cell__label">{{L.k34}}</text></view>
          </view>
          <text class="ui-meta">近 7 天報名：{{evStats.timeline[0].count}}／{{evStats.timeline[1].count}}／{{evStats.timeline[2].count}}／{{evStats.timeline[3].count}}／{{evStats.timeline[4].count}}／{{evStats.timeline[5].count}}／{{evStats.timeline[6].count}}</text>
          <view wx:if="{{evStats.byGroup.length}}" class="group-stat">
            <view wx:for="{{evStats.byGroup}}" wx:key="groupKey" class="group-stat__row">
              <text class="group-stat__name">{{item.groupKey}}</text>
              <text class="ui-meta">正取 {{item.signed}}｜候補 {{item.waitlisted}}｜出席 {{item.checkedIn}}</text>
            </view>
          </view>
          <text class="ui-meta">出席率 {{evStats.attendanceRate}}%（已簽到 {{evStats.checkedIn}}／正取 {{evStats.signed}}）</text>

          <!-- W-55 活動回饋統計：與報名統計同一張卡，不另開一張 -->
          <view class="fb-box">
            <text class="ui-meta fb-box__line">{{fbFailed ? L.k247 : fbLine}}</text>
            <text wx:if="{{fbDistLine}}" class="ui-meta fb-box__line">{{fbDistLine}}</text>
            <view wx:for="{{fbRecent}}" wx:key="id" class="fb-item">
              <text class="fb-item__stars">{{item.stars}}</text>
              <text class="fb-item__text">{{item.text}}</text>
            </view>
            <!-- W-56 催填回饋：只催已簽到且還沒填的人；按完就地顯示結果 -->
            <view class="fb-box__actions">
              <pv-button size="sm" type="plain" loading="{{fbReminding}}" disabled="{{fbReminding || !fbCanRemind}}" bind:tap="remindFeedback">{{L.k248}}</pv-button>
              <text wx:if="{{fbRemindText}}" class="ui-meta fb-box__hint">{{fbRemindText}}</text>
            </view>
          </view>

          <view class="row-actions">
            <pv-button size="sm" type="filled" bind:tap="promoteAll" disabled="{{evStats.waitlisted === 0}}">{{L.k35}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeEventStats">{{L.k36}}</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{ci}}">
          <view class="ui-row-between">
            <text class="ui-title">現場簽到 · {{ci.title}}</text>
            <pv-tag text="{{ci.active ? L.k96 : L.k97}}" type="{{ci.active ? 'success' : 'neutral'}}" />
          </view>
          <view wx:if="{{ci.active}}" class="ci-box">
            <image class="ci-qr" src="{{ci.qrDataUrl}}" mode="aspectFit" />
            <view class="ci-side">
              <text class="ci-code ui-num">{{ci.code}}</text>
              <text class="ui-meta">已簽到 {{ci.checkedIn}} / 正取 {{ci.signed}}{{ci.rate === null ? '' : '（' + ci.rate + '%）'}}</text>
            </view>
          </view>
          <text wx:else class="ui-meta ci-off">{{L.k37}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" loading="{{ciSending}}" disabled="{{ciSending}}" bind:tap="openCheckin">{{ci.active ? L.k98 : L.k99}}</pv-button>
            <pv-button size="sm" type="plain" disabled="{{ciSending || !ci.active}}" bind:tap="closeCheckin">{{L.k38}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeCheckinPanel">{{L.k36}}</pv-button>
          </view>
          <view wx:if="{{attendance}}" class="ci-list">
            <view wx:for="{{attendance.items}}" wx:key="signupId" class="ci-row">
              <text class="ci-row__name">{{item.nickname || L.k100}}　<text class="ui-meta">{{item.grade || ''}}{{item.className || ''}}</text></text>
              <view class="ci-row__right">
                <pv-tag text="{{item.checkedInAt ? L.k101 : (item.status === 'CONFIRMED' ? L.k102 : L.k103)}}" type="{{item.checkedInAt ? 'success' : 'neutral'}}" />
                <pv-button wx:if="{{item.status === 'CONFIRMED'}}" size="sm" type="plain" data-id="{{item.signupId}}" data-on="{{item.checkedInAt ? '0' : '1'}}" bind:tap="toggleAttendance">{{item.checkedInAt ? L.k104 : L.k105}}</pv-button>
              </view>
            </view>
          </view>
        </pv-card>

        <view wx:if="{{events.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{events}}" wx:key="id" class="ui-card ui-card--row {{index === events.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.status === 'CANCELLED' ? L.k106 : item.status === 'PUBLISHED' ? L.k107 : item.status}}" type="{{item.status === 'CANCELLED' ? 'danger' : 'success'}}" />
            </view>
            <text class="ui-meta">{{item.signedCount}}/{{item.capacity || L.k108}} 人</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventStats">{{L.k39}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventCheckin">{{L.k40}}</pv-button>
              <pv-button size="sm" type="plain" data-kind="event" data-id="{{item.id}}" bind:tap="openPrint">{{L.k127}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-status="{{item.status}}" data-version="{{item.version}}" bind:tap="toggleEventStatus">
                {{item.status === 'CANCELLED' ? L.k109 : L.k110}}
              </pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-title="{{item.title}}" bind:tap="removeEvent">{{L.k22}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 使用者管理 -->
      <block wx:elif="{{tab === 'users'}}">
        <view class="filter-row">
          <view class="chip {{showPerms ? 'chip--on' : ''}}" bindtap="togglePerms">{{L.k41}}</view>
        </view>
        <pv-card wx:if="{{showPerms}}">
          <view wx:for="{{abilities}}" wx:key="key" class="signup-row">
            <text class="signup-row__name">{{item.label}}</text>
            <text class="ui-meta">{{item.allowedText}}</text>
          </view>
        </pv-card>

        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k42}}</text>
          <input class="field__input" value="{{userForm.account}}" data-field="account" bindinput="onUserField" placeholder="{{L.k43}}" />
          <input class="field__input field__gap" value="{{userForm.password}}" data-field="password" bindinput="onUserField" password placeholder="{{L.k44}}" />
          <input class="field__input field__gap" value="{{userForm.nickname}}" data-field="nickname" bindinput="onUserField" placeholder="{{L.k45}}" />
          <view class="filter-row">
            <view wx:for="{{roles}}" wx:key="key" class="chip {{userForm.role === item.key ? 'chip--on' : ''}}"
                  data-role="{{item.key}}" bindtap="pickNewUserRole">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingUser}}" disabled="{{creatingUser}}" bind:tap="createUser">{{L.k46}}</pv-button>
          </view>
        </pv-card>

        <view class="filter-row">
          <input class="field__input" style="flex:1" value="{{userQuery.q}}" bindinput="onUserQuery" placeholder="{{L.k47}}" />
          <pv-button size="sm" type="plain" bind:tap="applyUserQuery">{{L.k48}}</pv-button>
        </view>
        <view class="filter-row">
          <view class="chip {{userQuery.role === '' ? 'chip--on' : ''}}" data-role="" bindtap="filterUsers">{{L.k49}}</view>
          <view wx:for="{{roles}}" wx:key="key" class="chip {{userQuery.role === item.key ? 'chip--on' : ''}}"
                data-role="{{item.key}}" bindtap="filterUsers">{{item.label}}</view>
        </view>

        <view wx:if="{{users.length}}" class="ui-list ui-list--grouped">
        <view wx:for="{{users}}" wx:key="id" class="ui-card ui-card--row {{index === users.length - 1 ? 'ui-card--last' : ''}}">
          <view class="ui-row-between">
            <text class="ui-title">{{item.nickname || item.openid}}</text>
            <pv-tag text="{{item.role}} Lv{{item.level}}" type="{{(item.bannedAt || item.locked) ? 'danger' : 'neutral'}}" />
          </view>
          <text class="ui-meta">{{item.openid}}{{item.bannedAt ? L.k111 : ''}}{{item.locked ? L.k160 : ''}}{{item.lastLoginText ? L.k112 + item.lastLoginText : ''}}</text>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <block wx:for="{{roles}}" wx:for-item="r" wx:key="key">
              <pv-button wx:if="{{item.level > r.level}}" size="sm" type="plain"
                         data-id="{{item.id}}" data-role="{{r.key}}" bind:tap="setRole">設為{{r.label}}</pv-button>
            </block>
          </view>
          <!-- 編輯表單（一次改名稱／帳號／密碼／等級）-->
          <view wx:if="{{editingId === item.id}}" class="edit-box">
            <text class="ui-section ui-mt-2">{{L.k50}}</text>
            <input class="field__input" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditField" />
            <text class="ui-section ui-mt-2">{{L.k51}}</text>
            <input class="field__input" value="{{editForm.account}}" data-field="account" bindinput="onEditField" />
            <text class="ui-section ui-mt-2">{{L.k52}}</text>
            <input class="field__input" value="{{editForm.password}}" data-field="password" bindinput="onEditField" password placeholder="{{L.k53}}" />
