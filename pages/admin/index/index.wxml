<view class="ui-page page-root">
  <pv-navbar title="管理" back="{{true}}" />

  <scroll-view class="tabs-scroll" scroll-x enable-flex show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab--on' : ''}}"
            data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </view>
  </scroll-view>

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="admin-inner">

      <block wx:if="{{tabLoading}}">
        <view class="ui-card"><pv-skeleton rows="2" /></view>
        <view class="ui-card"><pv-skeleton rows="3" /></view>
      </block>

      <block wx:elif="{{failed}}">
        <pv-empty icon="⚠️" title="讀取失敗" desc="{{errorText}}">
          <pv-button size="sm" type="tinted" bind:tap="reloadTab">重試</pv-button>
        </pv-empty>
      </block>

      <!-- 概況 -->
      <block wx:elif="{{tab === 'stats'}}">
        <view class="stat-grid">
          <view class="stat"><text class="stat__num">{{stats.users}}</text><text class="stat__label">使用者</text></view>
          <view class="stat"><text class="stat__num">{{stats.items.open}}</text><text class="stat__label">待認領</text></view>
          <view class="stat"><text class="stat__num">{{stats.claimsPending}}</text><text class="stat__label">待審認領</text></view>
          <view class="stat"><text class="stat__num">{{stats.signups.confirmed}}</text><text class="stat__label">正取報名</text></view>
          <view class="stat"><text class="stat__num">{{stats.signups.waitlist}}</text><text class="stat__label">候補中</text></view>
          <view class="stat"><text class="stat__num">{{stats.noticesActive}}</text><text class="stat__label">有效公告</text></view>
        </view>
        <pv-card>
          <text class="ui-meta">近 7 天新增失物 {{stats.items.added7d}} 筆｜已認領 {{stats.items.claimed}} 筆｜評分 {{stats.ratings.count}} 則（平均 {{stats.ratings.avg}}）</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="logout">登出</pv-button>
          </view>
        </pv-card>
      </block>

      <!-- 待審認領 -->
      <block wx:elif="{{tab === 'claims'}}">
        <pv-empty wx:if="{{!claims.length}}" icon="✅" title="沒有待審申請" desc="學生提出認領後會出現在這裡" />
        <view wx:for="{{claims}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.item.title}}</text>
            <pv-tag text="{{item.item.place}}" plain />
          </view>
          <text class="ui-meta">申請人：{{item.claimant.nickname}} {{item.claimant.className || ''}}</text>
          <text wx:if="{{item.message}}" class="ui-meta">特徵：{{item.message}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" data-id="{{item.id}}" data-ok="1" bind:tap="review">通過</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-ok="0" bind:tap="review">拒絕</pv-button>
          </view>
        </view>
      </block>

      <!-- 失物管理 -->
      <block wx:elif="{{tab === 'items'}}">
        <view class="filter-row">
          <view wx:for="{{statusFilters}}" wx:key="key" class="chip {{itemStatus === item.key ? 'chip--on' : ''}}"
                data-key="{{item.key}}" bindtap="filterItems">{{item.label}}</view>
        </view>
        <view wx:for="{{items}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.title}}</text>
            <pv-tag text="{{item.deletedAt ? '已下架' : item.status}}" type="{{item.deletedAt ? 'danger' : 'neutral'}}" />
          </view>
          <text class="ui-meta">{{item.type === 'FOUND' ? '拾獲' : '遺失'}} · {{item.place}} · {{item.author.nickname}} · 申請 {{item._count.claims}}</text>
          <view class="row-actions">
            <pv-button wx:if="{{item.deletedAt}}" size="sm" type="plain" data-id="{{item.id}}" data-act="RESTORE" bind:tap="moderate">恢復</pv-button>
            <pv-button wx:else size="sm" type="plain" data-id="{{item.id}}" data-act="REMOVE" bind:tap="moderate">下架</pv-button>
          </view>
        </view>
      </block>

      <!-- 發公告 -->
      <block wx:elif="{{tab === 'notice'}}">
        <pv-card>
          <text class="field__label">標題</text>
          <input class="field__input" value="{{notice.title}}" bindinput="onNoticeTitle" maxlength="120" />
          <text class="field__label">內容</text>
          <textarea class="field__input field__textarea" value="{{notice.content}}" bindinput="onNoticeContent" maxlength="2000" />
          <text class="field__label">類型</text>
          <view class="filter-row">
            <view wx:for="{{kinds}}" wx:key="key" class="chip {{notice.kind === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickKind">{{item.label}}</view>
          </view>
          <view class="switch-row">
            <text class="ui-meta">置頂</text>
            <switch checked="{{notice.isPinned}}" bindchange="onPinned" color="#17694a" />
          </view>
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="publish">發布公告</pv-button>
          </view>
        </pv-card>

        <text class="field__label">既有公告（{{noticeList.length}}）</text>
        <view wx:for="{{noticeList}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.title}}</text>
            <pv-tag text="{{item.kind === 'URGENT' ? '緊急' : item.kind === 'CALENDAR' ? '校曆' : '一般'}}" type="{{item.kind === 'URGENT' ? 'danger' : 'neutral'}}" />
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-pinned="{{item.isPinned ? '1' : '0'}}" bind:tap="togglePin">
              {{item.isPinned ? '取消置頂' : '置頂'}}
            </pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteNotice">刪除</pv-button>
          </view>
        </view>
      </block>

      <!-- 活動管理 -->
      <block wx:elif="{{tab === 'events'}}">
        <pv-card>
          <text class="field__label">新增活動</text>
          <input class="field__input" value="{{eventForm.title}}" data-field="title" bindinput="onEventField" placeholder="活動名稱" />
          <input class="field__input field__gap" value="{{eventForm.location}}" data-field="location" bindinput="onEventField" placeholder="地點（可空）" />
          <input class="field__input field__gap" value="{{eventForm.date}}" data-field="date" bindinput="onEventField" placeholder="日期 YYYY-MM-DD" />
          <input class="field__input field__gap" value="{{eventForm.capacity}}" data-field="capacity" bindinput="onEventField" placeholder="名額（0 = 不限）" />
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingEvent}}" disabled="{{creatingEvent}}" bind:tap="createEvent">建立活動</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{evStats}}">
          <view class="ui-row-between">
            <text class="ui-title">{{evStats.title}}</text>
            <pv-tag text="{{evStats.full ? '已滿' : (evStats.unlimited ? '不限名額' : '有名額')}}" type="{{evStats.full ? 'warning' : 'success'}}" />
          </view>
          <view class="stat-row">
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.signed}}</text><text class="stat-cell__label">正取</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.waitlisted}}</text><text class="stat-cell__label">候補</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.unlimited ? '∞' : evStats.remaining}}</text><text class="stat-cell__label">剩餘</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.cancelled}}</text><text class="stat-cell__label">取消</text></view>
          </view>
          <text class="ui-meta">近 7 天報名：{{evStats.timeline[0].count}}／{{evStats.timeline[1].count}}／{{evStats.timeline[2].count}}／{{evStats.timeline[3].count}}／{{evStats.timeline[4].count}}／{{evStats.timeline[5].count}}／{{evStats.timeline[6].count}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" bind:tap="promoteAll" disabled="{{evStats.waitlisted === 0}}">候補全部轉正</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeEventStats">收起</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{ci}}">
          <view class="ui-row-between">
            <text class="ui-title">現場簽到 · {{ci.title}}</text>
            <pv-tag text="{{ci.active ? '開放中' : '未開放'}}" type="{{ci.active ? 'success' : 'neutral'}}" />
          </view>
          <view wx:if="{{ci.active}}" class="ci-box">
            <image class="ci-qr" src="{{ci.qrDataUrl}}" mode="aspectFit" />
            <view class="ci-side">
              <text class="ci-code">{{ci.code}}</text>
              <text class="ui-meta">已簽到 {{ci.checkedIn}} / 正取 {{ci.signed}}{{ci.rate === null ? '' : '（' + ci.rate + '%）'}}</text>
            </view>
          </view>
          <text wx:else class="ui-meta ci-off">按「開始簽到」產生 6 位碼與 QR；學生在小程序掃碼就完成簽到。</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" loading="{{ciSending}}" disabled="{{ciSending}}" bind:tap="openCheckin">{{ci.active ? '換一張新碼' : '開始簽到'}}</pv-button>
            <pv-button size="sm" type="plain" disabled="{{ciSending || !ci.active}}" bind:tap="closeCheckin">結束簽到</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeCheckinPanel">收起</pv-button>
          </view>
          <view wx:if="{{attendance}}" class="ci-list">
            <view wx:for="{{attendance.items}}" wx:key="signupId" class="ci-row">
              <text class="ci-row__name">{{item.nickname || '（未設定）'}}　<text class="ui-meta">{{item.grade || ''}}{{item.className || ''}}</text></text>
              <view class="ci-row__right">
                <pv-tag text="{{item.checkedInAt ? '已簽到' : (item.status === 'CONFIRMED' ? '未簽到' : '候補')}}" type="{{item.checkedInAt ? 'success' : 'neutral'}}" />
                <pv-button wx:if="{{item.status === 'CONFIRMED'}}" size="sm" type="plain" data-id="{{item.signupId}}" data-on="{{item.checkedInAt ? '0' : '1'}}" bind:tap="toggleAttendance">{{item.checkedInAt ? '撤銷' : '代簽'}}</pv-button>
              </view>
            </view>
          </view>
        </pv-card>

        <view wx:for="{{events}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.title}}</text>
            <pv-tag text="{{item.status === 'CANCELLED' ? '已取消' : item.status === 'PUBLISHED' ? '報名中' : item.status}}" type="{{item.status === 'CANCELLED' ? 'danger' : 'success'}}" />
          </view>
          <text class="ui-meta">{{item.signedCount}}/{{item.capacity || '不限'}} 人</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventStats">統計</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventCheckin">簽到</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-status="{{item.status}}" bind:tap="toggleEventStatus">
              {{item.status === 'CANCELLED' ? '恢復' : '取消活動'}}
            </pv-button>
          </view>
        </view>
      </block>

      <!-- 使用者管理 -->
      <block wx:elif="{{tab === 'users'}}">
        <view class="filter-row">
          <view class="chip {{showPerms ? 'chip--on' : ''}}" bindtap="togglePerms">權限說明</view>
        </view>
        <pv-card wx:if="{{showPerms}}">
          <view wx:for="{{abilities}}" wx:key="key" class="signup-row">
            <text class="signup-row__name">{{item.label}}</text>
            <text class="ui-meta">{{item.allowedText}}</text>
          </view>
        </pv-card>

        <pv-card>
          <text class="field__label">新增帳號</text>
          <input class="field__input" value="{{userForm.account}}" data-field="account" bindinput="onUserField" placeholder="帳號（登入用）" />
          <input class="field__input field__gap" value="{{userForm.password}}" data-field="password" bindinput="onUserField" password placeholder="密碼（至少 8 位）" />
          <input class="field__input field__gap" value="{{userForm.nickname}}" data-field="nickname" bindinput="onUserField" placeholder="顯示名稱（可空）" />
          <view class="filter-row">
            <view wx:for="{{roles}}" wx:key="key" class="chip {{userForm.role === item.key ? 'chip--on' : ''}}"
                  data-role="{{item.key}}" bindtap="pickNewUserRole">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingUser}}" disabled="{{creatingUser}}" bind:tap="createUser">建立帳號</pv-button>
          </view>
        </pv-card>

        <view class="filter-row">
          <input class="field__input" style="flex:1" value="{{userQuery.q}}" bindinput="onUserQuery" placeholder="搜尋帳號或名稱" />
          <pv-button size="sm" type="plain" bind:tap="applyUserQuery">搜尋</pv-button>
        </view>
        <view class="filter-row">
          <view class="chip {{userQuery.role === '' ? 'chip--on' : ''}}" data-role="" bindtap="filterUsers">全部</view>
          <view wx:for="{{roles}}" wx:key="key" class="chip {{userQuery.role === item.key ? 'chip--on' : ''}}"
                data-role="{{item.key}}" bindtap="filterUsers">{{item.label}}</view>
        </view>

        <view wx:for="{{users}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.nickname || item.openid}}</text>
            <pv-tag text="{{item.role}} Lv{{item.level}}" type="{{item.bannedAt ? 'danger' : 'neutral'}}" />
          </view>
          <text class="ui-meta">{{item.openid}}{{item.bannedAt ? ' · 已停用' : ''}}{{item.lastLoginAt ? ' · 最後登入 ' + item.lastLoginAt : ''}}</text>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <block wx:for="{{roles}}" wx:for-item="r" wx:key="key">
              <pv-button wx:if="{{item.level > r.level}}" size="sm" type="plain"
                         data-id="{{item.id}}" data-role="{{r.key}}" bind:tap="setRole">設為{{r.label}}</pv-button>
            </block>
          </view>
          <!-- 編輯表單（一次改名稱／帳號／密碼／等級）-->
          <view wx:if="{{editingId === item.id}}" class="edit-box">
            <text class="field__label">名稱</text>
            <input class="field__input" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditField" />
            <text class="field__label">登入帳號</text>
            <input class="field__input" value="{{editForm.account}}" data-field="account" bindinput="onEditField" />
            <text class="field__label">新密碼（不填就不改）</text>
            <input class="field__input" value="{{editForm.password}}" data-field="password" bindinput="onEditField" password placeholder="留空＝維持原密碼" />
            <text class="field__label">等級</text>
            <view class="filter-row">
              <block wx:for="{{roles}}" wx:for-item="r" wx:key="key">
                <view wx:if="{{item.level > r.level || editForm.role === r.key}}"
                      class="chip {{editForm.role === r.key ? 'chip--on' : ''}}"
                      data-role="{{r.key}}" bindtap="pickEditRole">{{r.label}}</view>
              </block>
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="filled" bind:tap="saveEdit">儲存</pv-button>
              <pv-button size="sm" type="plain" bind:tap="cancelEdit">取消</pv-button>
            </view>
          </view>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="startEdit">編輯</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="resetPassword">重設密碼</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-banned="{{item.bannedAt ? '1' : '0'}}" bind:tap="toggleBan">
              {{item.bannedAt ? '恢復' : '停用'}}
            </pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-account="{{item.openid}}" bind:tap="deleteUser">刪除</pv-button>
          </view>
          <text wx:else class="ui-meta">同等或更高權限，只能查看</text>
        </view>
      </block>

      <!-- 家長綁定（P2）-->
      <block wx:elif="{{tab === 'parents'}}">
        <pv-card>
          <text class="field__label">新增綁定</text>
          <input class="field__input" value="{{parentForm.parentAccount}}" data-field="parentAccount" bindinput="onParentField" placeholder="家長帳號（先到使用者分頁把角色設為家長）" />
          <input class="field__input field__gap" value="{{parentForm.studentAccount}}" data-field="studentAccount" bindinput="onParentField" placeholder="學生學號，例如 3201201001" />
          <view class="filter-row">
            <view wx:for="{{relations}}" wx:key="key" class="chip {{parentForm.relation === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickRelation">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingParent}}" disabled="{{creatingParent}}" bind:tap="bindParent">綁定</pv-button>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!parents.length}}" icon="👨‍👩‍👧" title="還沒有任何綁定" desc="上方填家長帳號與學生學號即可建立" />

        <view wx:for="{{parents}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.parent.nickname || item.parent.account}}</text>
            <pv-tag text="{{item.relationLabel}}" type="neutral" />
          </view>
          <text class="ui-meta">家長帳號 {{item.parent.account}}</text>
          <text class="ui-meta">子女：{{item.student.nickname || item.student.account}}（{{item.student.grade || ''}}{{item.student.className || ''}} · {{item.student.account}}）</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-name="{{item.student.nickname || item.student.account}}" bind:tap="unbindParent">解除綁定</pv-button>
          </view>
        </view>
      </block>

      <!-- 檢舉 -->
      <block wx:elif="{{tab === 'reports'}}">
        <pv-empty wx:if="{{!reports.length}}" icon="🛡" title="沒有待處理檢舉" desc="" />
        <view wx:for="{{reports}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.targetType}} · {{item.reason}}</text>
            <pv-tag text="待處理" type="warning" />
          </view>
          <text class="ui-meta">檢舉人：{{item.reporter.nickname || '匿名'}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" data-id="{{item.id}}" data-action="RESOLVE" bind:tap="handleReport">成立並下架</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="DISMISS" bind:tap="handleReport">駁回</pv-button>
          </view>
        </view>
      </block>

      <!-- 錯誤日誌（用戶端上報）-->
      <block wx:elif="{{tab === 'errors'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">待處理 {{errSummary.open || 0}} 種</text>
            <text class="ui-meta">近 24 小時 {{errSummary.last24h || 0}} 次 · 累計 {{errSummary.total || 0}} 次</text>
          </view>
          <view class="filter-row">
            <view wx:for="{{errFilters}}" wx:key="key" class="chip {{errStatus === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickErrStatus">{{item.label}}</view>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!errors.length}}" icon="🐞" title="{{errStatus === 'OPEN' ? '沒有待處理的錯誤' : '沒有已解決的紀錄'}}"
                  desc="使用者手機上的白屏、閃退會自動出現在這裡" />

        <view wx:for="{{errors}}" wx:key="id" class="ui-card">
          <view class="ui-row-between">
            <text class="ui-title">{{item.message}}</text>
            <pv-tag text="{{item.count}} 次" type="{{item.status === 'OPEN' ? 'warning' : 'neutral'}}" />
          </view>
          <text class="ui-meta">{{item.route || '（未記錄頁面）'}}{{item.platform ? ' · ' + item.platform : ''}}</text>
          <text class="ui-meta">最近 {{item.seenText}} · 首次 {{item.firstSeenText}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="{{item.status === 'OPEN' ? 'RESOLVE' : 'REOPEN'}}" bind:tap="toggleErrStatus">
              {{item.status === 'OPEN' ? '標記已解決' : '重新打開'}}
            </pv-button>
          </view>
        </view>
      </block>

      <!-- 審計 -->
      <block wx:elif="{{tab === 'audit'}}">
        <pv-card wx:if="{{audit.length}}">
          <view wx:for="{{audit}}" wx:key="id" class="signup-row">
            <text class="signup-row__name">{{item.action}}</text>
            <text class="ui-meta">{{item.target || ''}}</text>
          </view>
        </pv-card>
        <pv-empty wx:else icon="📜" title="沒有紀錄" desc="" />
      </block>

      <!-- 報名名單 -->
      <block wx:elif="{{tab === 'export'}}">
        <view class="filter-row">
          <view wx:for="{{events}}" wx:key="id" class="chip {{eventId === item.id ? 'chip--on' : ''}}"
                data-id="{{item.id}}" bindtap="pickEvent">{{item.title}}</view>
        </view>
        <pv-card wx:if="{{signups.length}}">
          <view wx:for="{{signups}}" wx:key="index" class="signup-row">
            <text class="signup-row__name">{{item.nickname || '（未設定）'}}</text>
            <text class="ui-meta">{{item.status === 'CONFIRMED' ? '正取' : '候補 ' + item.waitlistPos}}</text>
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="copySignups">複製名單</pv-button>
          </view>
        </pv-card>
        <pv-empty wx:elif="{{eventId}}" icon="🎟" title="這個活動還沒有人報名" desc="" />
      </block>

      <!-- 排菜單 -->
      <block wx:elif="{{tab === 'menu'}}">
        <pv-card>
          <text class="field__label">日期</text>
          <input class="field__input" value="{{menu.date}}" placeholder="YYYY-MM-DD" bindinput="onMenuDate" />
          <text class="field__label">餐別</text>
          <view class="filter-row">
            <view wx:for="{{meals}}" wx:key="key" class="chip {{menu.mealType === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickMeal">{{item.label}}</view>
          </view>
          <text class="field__label">菜名（逗號分隔）</text>
          <input class="field__input" value="{{menu.names}}" placeholder="例：葡式焗雞飯, 番茄蛋炒飯" bindinput="onMenuNames" />
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="saveMenu">排入菜單</pv-button>
          </view>
        </pv-card>

        <text class="field__label">本週已排（{{menuWeekStart}} 起）</text>
        <view wx:for="{{menuEntries}}" wx:key="id" class="signup-row">
          <text class="signup-row__name">{{item.date}} · {{item.mealType === 'LUNCH' ? '午餐' : '小賣部'}} · {{item.dishName}}</text>
          <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteMenuEntry">移除</pv-button>
        </view>
        <pv-empty wx:if="{{!menuEntries.length}}" icon="🍽" title="這週還沒排菜" desc="" />
      </block>

      <text wx:if="{{hint}}" class="ui-meta hint">{{hint}}</text>
    </view>
  </scroll-view>
</view>
