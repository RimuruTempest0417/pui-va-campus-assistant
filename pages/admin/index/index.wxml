<view class="{{themeClass}} ui-page page-root">
  <pv-navbar title="{{L.k01}}" back="{{true}}" />

  <scroll-view class="tabs-scroll" scroll-x enable-flex show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'tab--on' : ''}}"
            data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
    </view>
  </scroll-view>

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="admin-inner">

      <block wx:if="{{tabLoading}}">
        <view class="ui-card"><pv-skeleton rows="2" /></view>
        <view class="ui-card"><pv-skeleton rows="3" /></view>
      </block>

      <block wx:elif="{{failed}}">
        <pv-empty title="{{L.k02}}" desc="{{errorText}}">
          <pv-button size="sm" type="tinted" bind:tap="reloadTab">{{L.k03}}</pv-button>
        </pv-empty>
      </block>

      <!-- 概況 -->
      <block wx:elif="{{tab === 'stats'}}">
        <view class="ov-head">
          <text class="ov-head__title">{{L.k157}}</text>
          <text class="ov-head__hint">{{L.k159}}</text>
        </view>
        <view class="ov-grid">
          <view wx:for="{{ovCards}}" wx:key="key"
                class="ov-card {{ovPressed === index ? 'ov-card--pressed' : ''}}"
                data-key="{{item.target}}" data-i="{{index}}"
                bindtap="switchTab" bindtouchstart="ovDown" bindtouchend="ovUp" bindtouchcancel="ovUp">
            <view class="ov-card__top">
              <text class="ov-card__num">{{item.value}}</text>
              <text class="ov-card__go">›</text>
            </view>
            <text class="ov-card__label">{{item.label}}</text>
          </view>
        </view>

        <text class="ov-section">{{L.k158}}</text>
        <view class="stat-grid">
          <view class="stat"><text class="stat__num">{{stats.users}}</text><text class="stat__label">{{L.k04}}</text></view>
          <view class="stat"><text class="stat__num">{{stats.items.open}}</text><text class="stat__label">{{L.k05}}</text></view>
          <view class="stat"><text class="stat__num">{{stats.claimsPending}}</text><text class="stat__label">{{L.k06}}</text></view>
          <view class="stat"><text class="stat__num">{{stats.signups.confirmed}}</text><text class="stat__label">{{L.k07}}</text></view>
          <view class="stat"><text class="stat__num">{{stats.signups.waitlist}}</text><text class="stat__label">{{L.k08}}</text></view>
          <view class="stat"><text class="stat__num">{{stats.noticesActive}}</text><text class="stat__label">{{L.k09}}</text></view>
        </view>
        <pv-card>
          <text class="ui-meta">近 7 天新增失物 {{stats.items.added7d}} 筆｜已認領 {{stats.items.claimed}} 筆｜評分 {{stats.ratings.count}} 則（平均 {{stats.ratings.avg}}）</text>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="logout">{{L.k10}}</pv-button>
          </view>
        </pv-card>
      </block>

      <!-- 待審認領 -->
      <block wx:elif="{{tab === 'claims'}}">
        <pv-empty wx:if="{{!claims.length}}" title="{{L.k11}}" desc="{{L.k12}}" />
        <view wx:if="{{claims.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{claims}}" wx:key="id" class="ui-card ui-card--row {{index === claims.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.item.title}}</text>
              <pv-tag text="{{item.item.place}}" plain />
            </view>
            <text class="ui-meta">申請人：{{item.claimant.nickname}} {{item.claimant.className || ''}}</text>
            <text wx:if="{{item.message}}" class="ui-meta">特徵：{{item.message}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="filled" data-id="{{item.id}}" data-ok="1" bind:tap="review">{{L.k13}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-ok="0" bind:tap="review">{{L.k14}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 失物管理 -->
      <block wx:elif="{{tab === 'items'}}">
        <view class="filter-row">
          <view wx:for="{{statusFilters}}" wx:key="key" class="chip {{itemStatus === item.key ? 'chip--on' : ''}}"
                data-key="{{item.key}}" bindtap="filterItems">{{item.label}}</view>
        </view>
        <view class="row-actions">
          <pv-button size="sm" type="plain" data-kind="items" bind:tap="openPrint">{{L.k126}}</pv-button>
        </view>
        <view wx:if="{{items.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{items}}" wx:key="id" class="ui-card ui-card--row {{index === items.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.deletedAt ? L.k85 : item.status}}" type="{{item.deletedAt ? 'danger' : 'neutral'}}" />
            </view>
            <text class="ui-meta">{{item.type === 'FOUND' ? L.k86 : L.k87}} · {{item.place}} · {{item.author.nickname}} · 申請 {{item._count.claims}}</text>
            <view class="row-actions">
              <pv-button wx:if="{{item.deletedAt}}" size="sm" type="plain" data-id="{{item.id}}" data-act="RESTORE" bind:tap="moderate">{{L.k15}}</pv-button>
              <pv-button wx:else size="sm" type="plain" data-id="{{item.id}}" data-act="REMOVE" bind:tap="moderate">{{L.k16}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 資源回收桶（W-40） -->
      <block wx:elif="{{tab === 'trash'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">{{L.k145}}</text>
            <text class="ui-meta">{{L.k147}} {{trashCounts.notice}} {{L.k150}} · {{L.k148}} {{trashCounts.item}} {{L.k150}} · {{L.k149}} {{trashCounts.all}} {{L.k150}}</text>
          </view>
          <text class="ui-meta">{{L.k146}}</text>
          <view class="filter-row">
            <view wx:for="{{trashFilters}}" wx:key="key" class="chip {{trashType === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickTrashType">{{item.label}}</view>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!trashRows.length}}" title="{{L.k154}}" desc="{{L.k155}}" />

        <view wx:if="{{trashRows.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{trashRows}}" wx:key="id" class="ui-card ui-card--row {{index === trashRows.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.typeText}}" type="neutral" />
            </view>
            <text class="ui-meta">{{item.subText}} · {{L.k151}} {{item.timeText}}</text>
            <text class="ui-meta">{{L.k152}} {{item.deleterText}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-type="{{item.type}}" data-title="{{item.title}}" bind:tap="restoreTrash">{{L.k153}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 發公告 -->
      <block wx:elif="{{tab === 'notice'}}">
        <pv-card>
          <text class="field__label">{{L.k17}}</text>
          <input class="field__input" value="{{notice.title}}" bindinput="onNoticeTitle" maxlength="120" />
          <text class="field__label">{{L.k18}}</text>
          <textarea class="field__input field__textarea" value="{{notice.content}}" bindinput="onNoticeContent" maxlength="2000" />
          <text class="field__label">{{L.k19}}</text>
          <view class="filter-row">
            <view wx:for="{{kinds}}" wx:key="key" class="chip {{notice.kind === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickKind">{{item.label}}</view>
          </view>
          <view class="switch-row">
            <text class="ui-meta">{{L.k20}}</text>
            <switch checked="{{notice.isPinned}}" bindchange="onPinned" color="{{theme.tint}}" />
          </view>
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="publish">{{L.k21}}</pv-button>
          </view>
        </pv-card>

        <text class="field__label">既有公告（{{noticeList.length}}）</text>
        <view wx:if="{{noticeList.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{noticeList}}" wx:key="id" class="ui-card ui-card--row {{index === noticeList.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.kind === 'URGENT' ? L.k88 : item.kind === 'CALENDAR' ? L.k89 : L.k90}}" type="{{item.kind === 'URGENT' ? 'danger' : 'neutral'}}" />
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-pinned="{{item.isPinned ? '1' : '0'}}" data-version="{{item.version}}" bind:tap="togglePin">
                {{item.isPinned ? L.k91 : L.k92}}
              </pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteNotice">{{L.k22}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 活動管理 -->
      <block wx:elif="{{tab === 'events'}}">
        <pv-card>
          <text class="field__label">{{L.k23}}</text>
          <input class="field__input" value="{{eventForm.title}}" data-field="title" bindinput="onEventField" placeholder="{{L.k24}}" />
          <input class="field__input field__gap" value="{{eventForm.location}}" data-field="location" bindinput="onEventField" placeholder="{{L.k25}}" />
          <input class="field__input field__gap" value="{{eventForm.date}}" data-field="date" bindinput="onEventField" placeholder="{{L.k26}}" />
          <input class="field__input field__gap" value="{{eventForm.capacity}}" data-field="capacity" bindinput="onEventField" placeholder="{{L.k27}}" />
          <input class="field__input field__gap" value="{{eventForm.groups}}" data-field="groups" bindinput="onEventField" placeholder="{{L.k28}}" />
          <view class="ui-row field__gap" bindtap="toggleEvTeams">
            <text class="field__label">{{teamsEnabled ? '☑' : '☐'}}</text>
            <text class="field__hint">{{L.k66}}</text>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingEvent}}" disabled="{{creatingEvent}}" bind:tap="createEvent">{{L.k29}}</pv-button>
            <pv-button size="sm" type="plain" data-type="events" bind:tap="openImport">{{L.k30}}</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{evStats}}">
          <view class="ui-row-between">
            <text class="ui-title">{{evStats.title}}</text>
            <pv-tag text="{{evStats.full ? L.k93 : (evStats.unlimited ? L.k94 : L.k95)}}" type="{{evStats.full ? 'warning' : 'success'}}" />
          </view>
          <view class="stat-row">
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.signed}}</text><text class="stat-cell__label">{{L.k31}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.waitlisted}}</text><text class="stat-cell__label">{{L.k32}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.unlimited ? '∞' : evStats.remaining}}</text><text class="stat-cell__label">{{L.k33}}</text></view>
            <view class="stat-cell"><text class="stat-cell__num">{{evStats.cancelled}}</text><text class="stat-cell__label">{{L.k34}}</text></view>
          </view>
          <text class="ui-meta">近 7 天報名：{{evStats.timeline[0].count}}／{{evStats.timeline[1].count}}／{{evStats.timeline[2].count}}／{{evStats.timeline[3].count}}／{{evStats.timeline[4].count}}／{{evStats.timeline[5].count}}／{{evStats.timeline[6].count}}</text>
          <view wx:if="{{evStats.byGroup.length}}" class="group-stat">
            <view wx:for="{{evStats.byGroup}}" wx:key="groupKey" class="group-stat__row">
              <text class="group-stat__name">{{item.groupKey}}</text>
              <text class="ui-meta">正取 {{item.signed}}｜候補 {{item.waitlisted}}｜出席 {{item.checkedIn}}</text>
            </view>
          </view>
          <text class="ui-meta">出席率 {{evStats.attendanceRate}}%（已簽到 {{evStats.checkedIn}}／正取 {{evStats.signed}}）</text>

          <view class="row-actions">
            <pv-button size="sm" type="filled" bind:tap="promoteAll" disabled="{{evStats.waitlisted === 0}}">{{L.k35}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeEventStats">{{L.k36}}</pv-button>
          </view>
        </pv-card>

        <pv-card wx:if="{{ci}}">
          <view class="ui-row-between">
            <text class="ui-title">現場簽到 · {{ci.title}}</text>
            <pv-tag text="{{ci.active ? L.k96 : L.k97}}" type="{{ci.active ? 'success' : 'neutral'}}" />
          </view>
          <view wx:if="{{ci.active}}" class="ci-box">
            <image class="ci-qr" src="{{ci.qrDataUrl}}" mode="aspectFit" />
            <view class="ci-side">
              <text class="ci-code">{{ci.code}}</text>
              <text class="ui-meta">已簽到 {{ci.checkedIn}} / 正取 {{ci.signed}}{{ci.rate === null ? '' : '（' + ci.rate + '%）'}}</text>
            </view>
          </view>
          <text wx:else class="ui-meta ci-off">{{L.k37}}</text>
          <view class="row-actions">
            <pv-button size="sm" type="filled" loading="{{ciSending}}" disabled="{{ciSending}}" bind:tap="openCheckin">{{ci.active ? L.k98 : L.k99}}</pv-button>
            <pv-button size="sm" type="plain" disabled="{{ciSending || !ci.active}}" bind:tap="closeCheckin">{{L.k38}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="closeCheckinPanel">{{L.k36}}</pv-button>
          </view>
          <view wx:if="{{attendance}}" class="ci-list">
            <view wx:for="{{attendance.items}}" wx:key="signupId" class="ci-row">
              <text class="ci-row__name">{{item.nickname || L.k100}}　<text class="ui-meta">{{item.grade || ''}}{{item.className || ''}}</text></text>
              <view class="ci-row__right">
                <pv-tag text="{{item.checkedInAt ? L.k101 : (item.status === 'CONFIRMED' ? L.k102 : L.k103)}}" type="{{item.checkedInAt ? 'success' : 'neutral'}}" />
                <pv-button wx:if="{{item.status === 'CONFIRMED'}}" size="sm" type="plain" data-id="{{item.signupId}}" data-on="{{item.checkedInAt ? '0' : '1'}}" bind:tap="toggleAttendance">{{item.checkedInAt ? L.k104 : L.k105}}</pv-button>
              </view>
            </view>
          </view>
        </pv-card>

        <view wx:if="{{events.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{events}}" wx:key="id" class="ui-card ui-card--row {{index === events.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <pv-tag text="{{item.status === 'CANCELLED' ? L.k106 : item.status === 'PUBLISHED' ? L.k107 : item.status}}" type="{{item.status === 'CANCELLED' ? 'danger' : 'success'}}" />
            </view>
            <text class="ui-meta">{{item.signedCount}}/{{item.capacity || L.k108}} 人</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventStats">{{L.k39}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="loadEventCheckin">{{L.k40}}</pv-button>
              <pv-button size="sm" type="plain" data-kind="event" data-id="{{item.id}}" bind:tap="openPrint">{{L.k127}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-status="{{item.status}}" data-version="{{item.version}}" bind:tap="toggleEventStatus">
                {{item.status === 'CANCELLED' ? L.k109 : L.k110}}
              </pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 使用者管理 -->
      <block wx:elif="{{tab === 'users'}}">
        <view class="filter-row">
          <view class="chip {{showPerms ? 'chip--on' : ''}}" bindtap="togglePerms">{{L.k41}}</view>
        </view>
        <pv-card wx:if="{{showPerms}}">
          <view wx:for="{{abilities}}" wx:key="key" class="signup-row">
            <text class="signup-row__name">{{item.label}}</text>
            <text class="ui-meta">{{item.allowedText}}</text>
          </view>
        </pv-card>

        <pv-card>
          <text class="field__label">{{L.k42}}</text>
          <input class="field__input" value="{{userForm.account}}" data-field="account" bindinput="onUserField" placeholder="{{L.k43}}" />
          <input class="field__input field__gap" value="{{userForm.password}}" data-field="password" bindinput="onUserField" password placeholder="{{L.k44}}" />
          <input class="field__input field__gap" value="{{userForm.nickname}}" data-field="nickname" bindinput="onUserField" placeholder="{{L.k45}}" />
          <view class="filter-row">
            <view wx:for="{{roles}}" wx:key="key" class="chip {{userForm.role === item.key ? 'chip--on' : ''}}"
                  data-role="{{item.key}}" bindtap="pickNewUserRole">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingUser}}" disabled="{{creatingUser}}" bind:tap="createUser">{{L.k46}}</pv-button>
          </view>
        </pv-card>

        <view class="filter-row">
          <input class="field__input" style="flex:1" value="{{userQuery.q}}" bindinput="onUserQuery" placeholder="{{L.k47}}" />
          <pv-button size="sm" type="plain" bind:tap="applyUserQuery">{{L.k48}}</pv-button>
        </view>
        <view class="filter-row">
          <view class="chip {{userQuery.role === '' ? 'chip--on' : ''}}" data-role="" bindtap="filterUsers">{{L.k49}}</view>
          <view wx:for="{{roles}}" wx:key="key" class="chip {{userQuery.role === item.key ? 'chip--on' : ''}}"
                data-role="{{item.key}}" bindtap="filterUsers">{{item.label}}</view>
        </view>

        <view wx:if="{{users.length}}" class="ui-list ui-list--grouped">
        <view wx:for="{{users}}" wx:key="id" class="ui-card ui-card--row {{index === users.length - 1 ? 'ui-card--last' : ''}}">
          <view class="ui-row-between">
            <text class="ui-title">{{item.nickname || item.openid}}</text>
            <pv-tag text="{{item.role}} Lv{{item.level}}" type="{{(item.bannedAt || item.locked) ? 'danger' : 'neutral'}}" />
          </view>
          <text class="ui-meta">{{item.openid}}{{item.bannedAt ? L.k111 : ''}}{{item.locked ? L.k160 : ''}}{{item.lastLoginText ? L.k112 + item.lastLoginText : ''}}</text>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <block wx:for="{{roles}}" wx:for-item="r" wx:key="key">
              <pv-button wx:if="{{item.level > r.level}}" size="sm" type="plain"
                         data-id="{{item.id}}" data-role="{{r.key}}" bind:tap="setRole">設為{{r.label}}</pv-button>
            </block>
          </view>
          <!-- 編輯表單（一次改名稱／帳號／密碼／等級）-->
          <view wx:if="{{editingId === item.id}}" class="edit-box">
            <text class="field__label">{{L.k50}}</text>
            <input class="field__input" value="{{editForm.nickname}}" data-field="nickname" bindinput="onEditField" />
            <text class="field__label">{{L.k51}}</text>
            <input class="field__input" value="{{editForm.account}}" data-field="account" bindinput="onEditField" />
            <text class="field__label">{{L.k52}}</text>
            <input class="field__input" value="{{editForm.password}}" data-field="password" bindinput="onEditField" password placeholder="{{L.k53}}" />
            <text class="field__label">{{L.k54}}</text>
            <view class="filter-row">
              <block wx:for="{{roles}}" wx:for-item="r" wx:key="key">
                <view wx:if="{{item.level > r.level || editForm.role === r.key}}"
                      class="chip {{editForm.role === r.key ? 'chip--on' : ''}}"
                      data-role="{{r.key}}" bindtap="pickEditRole">{{r.label}}</view>
              </block>
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="filled" bind:tap="saveEdit">{{L.k55}}</pv-button>
              <pv-button size="sm" type="plain" bind:tap="cancelEdit">{{L.k34}}</pv-button>
            </view>
          </view>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="startEdit">{{L.k56}}</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="resetPassword">{{L.k57}}</pv-button>
            <pv-button wx:if="{{item.locked}}" size="sm" type="plain" data-id="{{item.id}}" bind:tap="unlockUser">{{L.k161}}</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-banned="{{item.bannedAt ? '1' : '0'}}" bind:tap="toggleBan">
              {{item.bannedAt ? L.k109 : L.k113}}
            </pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-account="{{item.openid}}" bind:tap="deleteUser">{{L.k22}}</pv-button>
          </view>
          <text wx:else class="ui-meta">{{L.k58}}</text>
        </view>
        </view>
      </block>

      <!-- 家長綁定（P2）-->
      <block wx:elif="{{tab === 'parents'}}">
        <pv-card>
          <text class="field__label">{{L.k59}}</text>
          <input class="field__input" value="{{parentForm.parentAccount}}" data-field="parentAccount" bindinput="onParentField" placeholder="{{L.k60}}" />
          <input class="field__input field__gap" value="{{parentForm.studentAccount}}" data-field="studentAccount" bindinput="onParentField" placeholder="{{L.k61}}" />
          <view class="filter-row">
            <view wx:for="{{relations}}" wx:key="key" class="chip {{parentForm.relation === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickRelation">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingParent}}" disabled="{{creatingParent}}" bind:tap="bindParent">{{L.k62}}</pv-button>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!parents.length}}" title="{{L.k63}}" desc="{{L.k64}}" />

        <view wx:if="{{parents.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{parents}}" wx:key="id" class="ui-card ui-card--row {{index === parents.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.parent.nickname || item.parent.account}}</text>
              <pv-tag text="{{item.relationLabel}}" type="neutral" />
            </view>
            <text class="ui-meta">家長帳號 {{item.parent.account}}</text>
            <text class="ui-meta">子女：{{item.student.nickname || item.student.account}}（{{item.student.grade || ''}}{{item.student.className || ''}} · {{item.student.account}}）</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-name="{{item.student.nickname || item.student.account}}" bind:tap="unbindParent">{{L.k65}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 檢舉 -->
      <block wx:elif="{{tab === 'reports'}}">
        <pv-empty wx:if="{{!reports.length}}" title="{{L.k66}}" desc="" />
        <view wx:if="{{reports.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{reports}}" wx:key="id" class="ui-card ui-card--row {{index === reports.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.targetType}} · {{item.reason}}</text>
              <pv-tag text="{{L.k67}}" type="warning" />
            </view>
            <text class="ui-meta">檢舉人：{{item.reporter.nickname || L.k114}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="filled" data-id="{{item.id}}" data-action="RESOLVE" bind:tap="handleReport">{{L.k68}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="DISMISS" bind:tap="handleReport">{{L.k69}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 錯誤日誌（用戶端上報）-->
      <block wx:elif="{{tab === 'errors'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">待處理 {{errSummary.open || 0}} 種</text>
            <text class="ui-meta">近 24 小時 {{errSummary.last24h || 0}} 次 · 累計 {{errSummary.total || 0}} 次 · 使用者回報 {{errSummary.userReports || 0}} 件</text>
          </view>
          <view class="filter-row">
            <view wx:for="{{errFilters}}" wx:key="key" class="chip {{errStatus === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickErrStatus">{{item.label}}</view>
          </view>
          <view class="filter-row">
            <view wx:for="{{errKindFilters}}" wx:key="key" class="chip {{errKind === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickErrKind">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="cleanupErrors">{{L.k131}}</pv-button>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!errors.length}}" title="{{errStatus === 'OPEN' ? L.k115 : L.k116}}"
                  desc="{{L.k70}}" />

        <view wx:if="{{errors.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{errors}}" wx:key="id" class="ui-card ui-card--row {{index === errors.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.message}}</text>
              <pv-tag text="{{item.count}} 次" type="{{item.status === 'OPEN' ? 'warning' : 'neutral'}}" />
            </view>
            <view class="row-actions">
              <pv-tag text="{{item.kindText}}" type="{{item.isUserReport ? 'tint' : 'neutral'}}" />
            </view>
            <text class="ui-meta">{{item.route || L.k117}}{{item.platform ? ' · ' + item.platform : ''}}</text>
            <text wx:if="{{item.deviceText}}" class="ui-meta">{{item.deviceText}}</text>
            <text class="ui-meta">最近 {{item.seenText}} · 首次 {{item.firstSeenText}}</text>
            <view class="row-actions" wx:if="{{item.similarText}}">
              <pv-tag text="{{item.similarText}}" type="neutral" />
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="{{item.status === 'OPEN' ? 'RESOLVE' : 'REOPEN'}}" bind:tap="toggleErrStatus">
                {{item.status === 'OPEN' ? L.k118 : L.k119}}
              </pv-button>
              <pv-button wx:if="{{item.similar > 1 && item.status === 'OPEN'}}" size="sm" type="plain"
                         data-message="{{item.message}}" bind:tap="resolveSimilarErr">{{L.k128}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 推送紀錄（W-37） -->
      <block wx:elif="{{tab === 'push'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">{{L.k132}}</text>
            <text class="ui-meta">{{L.k133}} {{pushSummary.total || 0}}</text>
          </view>
          <view class="ui-row-between">
            <text class="ui-meta">{{L.k134}} {{pushSummary.ok || 0}} · {{L.k135}} {{pushSummary.failed || 0}}</text>
            <text class="ui-meta">{{L.k136}} {{pushSummary.last24h || 0}}</text>
          </view>
          <text class="ui-meta">{{pushTplHint}}</text>
          <view class="filter-row">
            <view wx:for="{{pushFilters}}" wx:key="key" class="chip {{pushOk === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickPushOk">{{item.label}}</view>
          </view>
          <view class="filter-row">
            <view class="chip {{pushChannel === '' ? 'chip--on' : ''}}" data-key="" bindtap="pickPushChannel">{{L.k137}}</view>
            <view class="chip {{pushChannel === 'INAPP' ? 'chip--on' : ''}}" data-key="INAPP" bindtap="pickPushChannel">{{L.k138}}</view>
            <view class="chip {{pushChannel === 'WX' ? 'chip--on' : ''}}" data-key="WX" bindtap="pickPushChannel">{{L.k139}}</view>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!pushLogs.length}}" title="{{L.k140}}" desc="{{L.k141}}" />

        <view wx:if="{{pushLogs.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{pushLogs}}" wx:key="id" class="ui-card ui-card--row {{index === pushLogs.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.titleText}}</text>
              <pv-tag text="{{item.resultText}}" type="{{item.ok ? 'neutral' : 'warning'}}" />
            </view>
            <text class="ui-meta">{{item.nameText}}{{item.roleText ? ' · ' + item.roleText : ''}}</text>
            <text class="ui-meta">{{item.channelText}}{{item.sceneText ? ' · ' + item.sceneText : ''}} · {{item.timeText}}</text>
            <text wx:if="{{!item.ok}}" class="ui-meta">{{L.k143}}{{item.errorText}}</text>
          </view>
        </view>
      </block>

      <!-- 審計 -->
      <block wx:elif="{{tab === 'audit'}}">
        <pv-card wx:if="{{audit.length}}">
          <view wx:for="{{audit}}" wx:key="id" class="signup-row">
            <text class="signup-row__name">{{item.action}}</text>
            <text class="ui-meta">{{item.target || ''}}</text>
          </view>
        </pv-card>
        <pv-empty wx:else title="{{L.k71}}" desc="" />
      </block>

      <!-- 報名名單 -->
      <block wx:elif="{{tab === 'export'}}">
        <view class="filter-row">
          <view wx:for="{{events}}" wx:key="id" class="chip {{eventId === item.id ? 'chip--on' : ''}}"
                data-id="{{item.id}}" bindtap="pickEvent">{{item.title}}</view>
        </view>
        <pv-card wx:if="{{signups.length}}">
          <view wx:for="{{signups}}" wx:key="index" class="signup-row">
            <text class="signup-row__name">{{item.nickname || L.k100}}</text>
            <text class="ui-meta">{{item.status === 'CONFIRMED' ? L.k120 : L.k121 + item.waitlistPos}}</text>
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="copySignups">{{L.k72}}</pv-button>
          </view>
        </pv-card>
        <pv-empty wx:elif="{{eventId}}" title="{{L.k73}}" desc="" />
      </block>

      <!-- 排菜單 -->
      <block wx:elif="{{tab === 'menu'}}">
        <pv-card>
          <text class="field__label">{{L.k74}}</text>
          <input class="field__input" value="{{menu.date}}" placeholder="YYYY-MM-DD" bindinput="onMenuDate" />
          <text class="field__label">{{L.k75}}</text>
          <view class="filter-row">
            <view wx:for="{{meals}}" wx:key="key" class="chip {{menu.mealType === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickMeal">{{item.label}}</view>
          </view>
          <text class="field__label">{{L.k76}}</text>
          <input class="field__input" value="{{menu.names}}" placeholder="{{L.k77}}" bindinput="onMenuNames" />
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="saveMenu">{{L.k78}}</pv-button>
            <pv-button size="sm" type="plain" data-type="menu" bind:tap="openImport">{{L.k30}}</pv-button>
          </view>
        </pv-card>

        <text class="field__label">本週已排（{{menuWeekStart}} 起）</text>
        <view wx:if="{{menuEntries.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{menuEntries}}" wx:key="id" class="signup-row {{index === menuEntries.length - 1 ? 'signup-row--last' : ''}}">
            <text class="signup-row__name">{{item.date}} · {{item.mealType === 'LUNCH' ? L.k122 : L.k123}} · {{item.dishName}}</text>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteMenuEntry">{{L.k79}}</pv-button>
          </view>
        </view>
        <pv-empty wx:if="{{!menuEntries.length}}" title="{{L.k80}}" desc="" />
      </block>

      <!-- 批次匯入（活動／菜單共用同一塊面板） -->
      <pv-card wx:if="{{importType}}">
        <view class="ui-row-between">
          <text class="ui-title">批次匯入{{importType === 'menu' ? L.k124 : L.k125}}</text>
          <pv-button size="sm" type="plain" bind:tap="closeImport">{{L.k36}}</pv-button>
        </view>
        <text class="ui-meta imp-hint">{{importHint}}</text>
        <textarea
          class="field__input field__textarea field__gap"
          value="{{importCsv}}"
          bindinput="onImportText"
          maxlength="-1"
          placeholder="{{L.k81}}"
        />
        <view class="row-actions">
          <pv-button size="sm" type="plain" bind:tap="pickCsvFile">{{L.k82}}</pv-button>
          <pv-button size="sm" type="plain" loading="{{importBusy}}" disabled="{{importBusy}}" bind:tap="checkImport">{{L.k83}}</pv-button>
          <pv-button size="sm" type="filled" loading="{{importBusy}}" disabled="{{importBusy || !importChecked}}" bind:tap="confirmImport">{{L.k84}}</pv-button>
        </view>
        <view wx:if="{{importResult}}">
          <text class="ui-meta imp-sum">共 {{importResult.total}} 列：可寫入 {{importResult.success}}｜有問題 {{importResult.failed}}</text>
          <view wx:for="{{importResult.rows}}" wx:key="line" class="imp-row">
            <text class="imp-row__line">第 {{item.line}} 列</text>
            <text class="imp-row__msg {{item.ok ? 'imp-row__msg--ok' : 'imp-row__msg--bad'}}">{{item.message}}{{item.label ? '：' + item.label : ''}}</text>
          </view>
        </view>
      </pv-card>

      <text wx:if="{{hint}}" class="ui-meta hint">{{hint}}</text>
    </view>
  </scroll-view>
</view>
