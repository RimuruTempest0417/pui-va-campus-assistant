                      class="chip {{editForm.role === r.key ? 'chip--on' : ''}}"
                      data-role="{{r.key}}" bindtap="pickEditRole">{{r.label}}</view>
              </block>
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="filled" bind:tap="saveEdit">{{L.k55}}</pv-button>
              <pv-button size="sm" type="plain" bind:tap="cancelEdit">{{L.k34}}</pv-button>
            </view>
          </view>

          <view wx:if="{{item.canManage}}" class="row-actions">
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="startEdit">{{L.k56}}</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="resetPassword">{{L.k57}}</pv-button>
            <pv-button wx:if="{{item.locked}}" size="sm" type="plain" data-id="{{item.id}}" bind:tap="unlockUser">{{L.k161}}</pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-banned="{{item.bannedAt ? '1' : '0'}}" bind:tap="toggleBan">
              {{item.bannedAt ? L.k109 : L.k113}}
            </pv-button>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" data-account="{{item.openid}}" bind:tap="deleteUser">{{L.k22}}</pv-button>
          </view>
          <text wx:else class="ui-meta">{{L.k58}}</text>
        </view>
        </view>
      </block>

      <!-- 家長綁定（P2）-->
      <block wx:elif="{{tab === 'parents'}}">
        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k59}}</text>
          <input class="field__input" value="{{parentForm.parentAccount}}" data-field="parentAccount" bindinput="onParentField" placeholder="{{L.k60}}" />
          <input class="field__input field__gap" value="{{parentForm.studentAccount}}" data-field="studentAccount" bindinput="onParentField" placeholder="{{L.k61}}" />
          <view class="filter-row">
            <view wx:for="{{relations}}" wx:key="key" class="chip {{parentForm.relation === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickRelation">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{creatingParent}}" disabled="{{creatingParent}}" bind:tap="bindParent">{{L.k62}}</pv-button>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!parents.length}}" title="{{L.k63}}" desc="{{L.k64}}" />

        <view wx:if="{{parents.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{parents}}" wx:key="id" class="ui-card ui-card--row {{index === parents.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.parent.nickname || item.parent.account}}</text>
              <pv-tag text="{{item.relationLabel}}" type="neutral" />
            </view>
            <text class="ui-meta">家長帳號 {{item.parent.account}}</text>
            <text class="ui-meta">子女：{{item.student.nickname || item.student.account}}（{{item.student.grade || ''}}{{item.student.className || ''}} · {{item.student.account}}）</text>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-name="{{item.student.nickname || item.student.account}}" bind:tap="unbindParent">{{L.k65}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 補登成績與出缺席（W-53 第二階段：老師／職員在小程序內就能補，不必回電腦） -->
      <block wx:elif="{{tab === 'school'}}">
        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k163}}</text>
          <input class="field__input" value="{{scQuery}}" bindinput="onSchoolQuery" bindconfirm="findSchoolStudents" confirm-type="search" placeholder="{{L.k164}}" />
          <view class="row-actions">
            <pv-button size="sm" type="plain" loading="{{scBusy}}" disabled="{{scBusy}}" bind:tap="findSchoolStudents">{{L.k165}}</pv-button>
          </view>
        </pv-card>

        <view wx:if="{{scHits.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{scHits}}" wx:key="id"
                class="ui-card ui-card--row {{index === scHits.length - 1 ? 'ui-card--last' : ''}} {{scPressed === index ? 'ov-card--pressed' : ''}}"
                data-index="{{index}}" data-id="{{item.id}}"
                bindtap="pickSchoolStudent" bindtouchstart="pressHit" bindtouchend="releaseHit">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <text class="ui-meta">{{item.account}}</text>
            </view>
            <text class="ui-meta">{{item.meta}}</text>
          </view>
        </view>

        <pv-card wx:if="{{scPicked}}">
          <view class="ui-row-between">
            <text class="ui-title">{{scPicked.title}}</text>
            <pv-tag text="{{scPicked.account}}" type="neutral" />
          </view>
          <text class="ui-meta">{{scPicked.meta}}</text>
          <view class="filter-row">
            <view wx:for="{{scModes}}" wx:key="key" class="chip {{scMode === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickSchoolMode">{{item.label}}</view>
          </view>
        </pv-card>

        <!-- 成績：補登表單 -->
        <pv-card wx:if="{{scPicked && scMode === 'grade'}}">
          <text class="ui-section">{{L.k173}}</text>
          <input class="field__input" value="{{gForm.courseName}}" data-field="courseName" bindinput="onGradeField" placeholder="{{L.k170}}" />
          <input class="field__input field__gap" value="{{gForm.testType}}" data-field="testType" bindinput="onGradeField" placeholder="{{L.k171}}" />
          <input class="field__input field__gap" type="digit" value="{{gForm.score}}" data-field="score" bindinput="onGradeField" placeholder="{{L.k172}}" />
          <input class="field__input field__gap" value="{{gForm.yearTerm}}" data-field="yearTerm" bindinput="onGradeField" placeholder="{{L.k169}}" />
          <text class="ui-meta">{{L.k188}}</text>
          <view class="filter-row">
            <view wx:for="{{termOptions}}" wx:key="key" class="chip {{gForm.term === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickGradeTerm">{{item.label}}</view>
          </view>
          <picker mode="date" value="{{gForm.testDate}}" bindchange="onGradeDate">
            <view class="field__input field__gap">{{gForm.testDate || L.k187}}</view>
          </picker>
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{scSaving}}" disabled="{{scSaving}}" bind:tap="submitGrade">{{L.k173}}</pv-button>
            <pv-button size="sm" type="plain" bind:tap="toggleGradeBatch">{{L.k202}}</pv-button>
          </view>
        </pv-card>

        <!-- 批次匯入成績（一次貼多筆「科目,類型,日期,分數」；先檢查再匯入） -->
        <pv-card wx:if="{{scPicked && scMode === 'grade' && gBatchOpen}}">
          <view class="ui-row-between">
            <text class="ui-section">{{L.k222}}</text>
            <pv-button size="sm" type="plain" bind:tap="toggleGradeBatch">{{L.k203}}</pv-button>
          </view>
          <text class="ui-meta">{{L.k204}}</text>
          <text wx:if="{{!gForm.yearTerm || !gForm.term}}" class="ui-meta">{{L.k223}}</text>
          <textarea
            class="field__input field__textarea field__gap"
            value="{{gBatchText}}"
            bindinput="onGradeBatchText"
            maxlength="-1"
            placeholder="數學,大測一,2026-10-09,85"
          />
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="fillGradeBatchTemplate">{{L.k206}}</pv-button>
            <pv-button size="sm" type="plain" loading="{{gBatchBusy}}" disabled="{{gBatchBusy}}" bind:tap="checkGradeBatch">{{L.k207}}</pv-button>
            <pv-button size="sm" type="filled" loading="{{gBatchBusy}}" disabled="{{gBatchBusy || !gBatchChecked}}" bind:tap="confirmGradeBatch">{{L.k208}}</pv-button>
          </view>
          <view wx:if="{{gBatchResult}}">
            <text class="ui-meta imp-sum">{{L.k215}}{{gBatchResult.total}}{{L.k216}}{{gBatchResult.success}}{{L.k217}}{{gBatchResult.failed}}</text>
            <view wx:for="{{gBatchResult.rows}}" wx:key="line" class="imp-row">
              <text class="imp-row__line">{{L.k218}}{{item.line}}{{L.k219}}</text>
              <text class="imp-row__msg {{item.ok ? 'imp-row__msg--ok' : 'imp-row__msg--bad'}}">{{item.message}}{{item.label ? '：' + item.label : ''}}</text>
            </view>
          </view>
        </pv-card>

        <!-- 成績：這位學生既有的紀錄 -->
        <pv-empty wx:if="{{scPicked && scMode === 'grade' && !scGrades.length}}" title="{{L.k175}}" desc="" />
        <view wx:if="{{scPicked && scMode === 'grade' && scGrades.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{scGrades}}" wx:key="id" class="ui-card ui-card--row {{index === scGrades.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.title}}</text>
              <text class="ui-num">{{item.scoreText}}</text>
            </view>
            <view class="ui-row-between">
              <text class="ui-meta">{{item.meta}}</text>
              <pv-tag text="{{item.manual ? L.k185 : L.k186}}" type="{{item.manual ? 'warning' : 'neutral'}}" />
            </view>
            <view wx:if="{{item.manual}}" class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-title="{{item.title}}" bind:tap="deleteGrade">{{L.k22}}</pv-button>
            </view>
          </view>
        </view>

        <!-- 出缺席：補登表單 -->
        <pv-card wx:if="{{scPicked && scMode === 'attend'}}">
          <text class="ui-section">{{L.k174}}</text>
          <picker mode="date" value="{{aForm.date}}" bindchange="onAttendDate">
            <view class="field__input">{{aForm.date || L.k187}}</view>
          </picker>
          <text class="ui-meta">{{L.k179}}</text>
          <view class="filter-row">
            <view wx:for="{{attStatuses}}" wx:key="key" class="chip {{aForm.amStatus === item.key ? 'chip--on' : ''}}"
                  data-field="am" data-key="{{item.key}}" bindtap="pickAttendStatus">{{item.label}}</view>
          </view>
          <text class="ui-meta">{{L.k180}}</text>
          <view class="filter-row">
            <view wx:for="{{attStatuses}}" wx:key="key" class="chip {{aForm.pmStatus === item.key ? 'chip--on' : ''}}"
                  data-field="pm" data-key="{{item.key}}" bindtap="pickAttendStatus">{{item.label}}</view>
          </view>
          <input class="field__input field__gap" value="{{aForm.remark}}" bindinput="onAttendRemark" placeholder="{{L.k189}}" />
          <view class="row-actions">
            <pv-button type="filled" size="sm" loading="{{scSaving}}" disabled="{{scSaving}}" bind:tap="submitAttend">{{L.k174}}</pv-button>
          </view>
        </pv-card>

        <!-- 出缺席：這位學生既有的紀錄 -->
        <text wx:if="{{scPicked && scMode === 'attend' && scAttend.length}}" class="ui-meta">{{scSummaryText}}</text>
        <pv-empty wx:if="{{scPicked && scMode === 'attend' && !scAttend.length}}" title="{{L.k176}}" desc="" />
        <view wx:if="{{scPicked && scMode === 'attend' && scAttend.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{scAttend}}" wx:key="id" class="ui-card ui-card--row {{index === scAttend.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.dateText}}</text>
              <pv-tag text="{{item.manual ? L.k185 : L.k186}}" type="{{item.manual ? 'warning' : 'neutral'}}" />
            </view>
            <text class="ui-meta">{{L.k179}} {{item.amText}} · {{L.k180}} {{item.pmText}}</text>
            <text wx:if="{{item.remark}}" class="ui-meta">{{item.remark}}</text>
            <view wx:if="{{item.manual}}" class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-day="{{item.dateText}}" bind:tap="deleteAttend">{{L.k22}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 檢舉 -->
      <block wx:elif="{{tab === 'reports'}}">
        <pv-empty wx:if="{{!reports.length}}" title="{{L.k66}}" desc="" />
        <view wx:if="{{reports.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{reports}}" wx:key="id" class="ui-card ui-card--row {{index === reports.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.targetType}} · {{item.reason}}</text>
              <pv-tag text="{{L.k67}}" type="warning" />
            </view>
            <text class="ui-meta">檢舉人：{{item.reporter.nickname || L.k114}}</text>
            <view class="row-actions">
              <pv-button size="sm" type="filled" data-id="{{item.id}}" data-action="RESOLVE" bind:tap="handleReport">{{L.k68}}</pv-button>
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="DISMISS" bind:tap="handleReport">{{L.k69}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 錯誤日誌（用戶端上報）-->
      <block wx:elif="{{tab === 'errors'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">待處理 {{errSummary.open || 0}} 種</text>
            <text class="ui-meta">近 24 小時 {{errSummary.last24h || 0}} 次 · 累計 {{errSummary.total || 0}} 次 · 使用者回報 {{errSummary.userReports || 0}} 件</text>
          </view>
          <view class="filter-row">
            <view wx:for="{{errFilters}}" wx:key="key" class="chip {{errStatus === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickErrStatus">{{item.label}}</view>
          </view>
          <view class="filter-row">
            <view wx:for="{{errKindFilters}}" wx:key="key" class="chip {{errKind === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickErrKind">{{item.label}}</view>
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="cleanupErrors">{{L.k131}}</pv-button>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!errors.length}}" title="{{errStatus === 'OPEN' ? L.k115 : L.k116}}"
                  desc="{{L.k70}}" />

        <view wx:if="{{errors.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{errors}}" wx:key="id" class="ui-card ui-card--row {{index === errors.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.message}}</text>
              <pv-tag text="{{item.count}} 次" type="{{item.status === 'OPEN' ? 'warning' : 'neutral'}}" />
            </view>
            <view class="row-actions">
              <pv-tag text="{{item.kindText}}" type="{{item.isUserReport ? 'tint' : 'neutral'}}" />
            </view>
            <text class="ui-meta">{{item.route || L.k117}}{{item.platform ? ' · ' + item.platform : ''}}</text>
            <text wx:if="{{item.deviceText}}" class="ui-meta">{{item.deviceText}}</text>
            <text class="ui-meta">最近 {{item.seenText}} · 首次 {{item.firstSeenText}}</text>
            <view class="row-actions" wx:if="{{item.similarText}}">
              <pv-tag text="{{item.similarText}}" type="neutral" />
            </view>
            <view class="row-actions">
              <pv-button size="sm" type="plain" data-id="{{item.id}}" data-action="{{item.status === 'OPEN' ? 'RESOLVE' : 'REOPEN'}}" bind:tap="toggleErrStatus">
                {{item.status === 'OPEN' ? L.k118 : L.k119}}
              </pv-button>
              <pv-button wx:if="{{item.similar > 1 && item.status === 'OPEN'}}" size="sm" type="plain"
                         data-message="{{item.message}}" bind:tap="resolveSimilarErr">{{L.k128}}</pv-button>
            </view>
          </view>
        </view>
      </block>

      <!-- 推送紀錄（W-37） -->
      <block wx:elif="{{tab === 'push'}}">
        <pv-card>
          <view class="ui-row-between">
            <text class="ui-title">{{L.k132}}</text>
            <text class="ui-meta">{{L.k133}} {{pushSummary.total || 0}}</text>
          </view>
          <view class="ui-row-between">
            <text class="ui-meta">{{L.k134}} {{pushSummary.ok || 0}} · {{L.k135}} {{pushSummary.failed || 0}}</text>
            <text class="ui-meta">{{L.k136}} {{pushSummary.last24h || 0}}</text>
          </view>
          <text class="ui-meta">{{pushTplHint}}</text>
          <view class="filter-row">
            <view wx:for="{{pushFilters}}" wx:key="key" class="chip {{pushOk === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickPushOk">{{item.label}}</view>
          </view>
          <view class="filter-row">
            <view class="chip {{pushChannel === '' ? 'chip--on' : ''}}" data-key="" bindtap="pickPushChannel">{{L.k137}}</view>
            <view class="chip {{pushChannel === 'INAPP' ? 'chip--on' : ''}}" data-key="INAPP" bindtap="pickPushChannel">{{L.k138}}</view>
            <view class="chip {{pushChannel === 'WX' ? 'chip--on' : ''}}" data-key="WX" bindtap="pickPushChannel">{{L.k139}}</view>
          </view>
        </pv-card>

        <pv-empty wx:if="{{!pushLogs.length}}" title="{{L.k140}}" desc="{{L.k141}}" />

        <view wx:if="{{pushLogs.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{pushLogs}}" wx:key="id" class="ui-card ui-card--row {{index === pushLogs.length - 1 ? 'ui-card--last' : ''}}">
            <view class="ui-row-between">
              <text class="ui-title">{{item.titleText}}</text>
              <pv-tag text="{{item.resultText}}" type="{{item.ok ? 'neutral' : 'warning'}}" />
            </view>
            <text class="ui-meta">{{item.nameText}}{{item.roleText ? ' · ' + item.roleText : ''}}</text>
            <text class="ui-meta">{{item.channelText}}{{item.sceneText ? ' · ' + item.sceneText : ''}} · {{item.timeText}}</text>
            <text wx:if="{{!item.ok}}" class="ui-meta">{{L.k143}}{{item.errorText}}</text>
          </view>
        </view>
      </block>

      <!-- 審計 -->
      <block wx:elif="{{tab === 'audit'}}">
        <pv-card wx:if="{{audit.length}}">
          <view wx:for="{{audit}}" wx:key="id" class="signup-row">
            <text class="signup-row__name">{{item.action}}</text>
            <text class="ui-meta">{{item.target || ''}}</text>
          </view>
        </pv-card>
        <pv-empty wx:else title="{{L.k71}}" desc="" />
      </block>

      <!-- 報名名單 -->
      <block wx:elif="{{tab === 'export'}}">
        <view class="filter-row">
          <view wx:for="{{events}}" wx:key="id" class="chip {{eventId === item.id ? 'chip--on' : ''}}"
                data-id="{{item.id}}" bindtap="pickEvent">{{item.title}}</view>
        </view>
        <pv-card wx:if="{{signups.length}}">
          <view wx:for="{{signups}}" wx:key="index" class="signup-row">
            <text class="signup-row__name">{{item.nickname || L.k100}}</text>
            <text class="ui-meta">{{item.status === 'CONFIRMED' ? L.k120 : L.k121 + item.waitlistPos}}</text>
          </view>
          <view class="row-actions">
            <pv-button size="sm" type="plain" bind:tap="copySignups">{{L.k72}}</pv-button>
          </view>
        </pv-card>
        <pv-empty wx:elif="{{eventId}}" title="{{L.k73}}" desc="" />
      </block>

      <!-- 排菜單 -->
      <block wx:elif="{{tab === 'menu'}}">
        <pv-card>
          <text class="ui-section ui-mt-2">{{L.k74}}</text>
          <input class="field__input" value="{{menu.date}}" placeholder="YYYY-MM-DD" bindinput="onMenuDate" />
          <text class="ui-section ui-mt-2">{{L.k75}}</text>
          <view class="filter-row">
            <view wx:for="{{meals}}" wx:key="key" class="chip {{menu.mealType === item.key ? 'chip--on' : ''}}"
                  data-key="{{item.key}}" bindtap="pickMeal">{{item.label}}</view>
          </view>
          <text class="ui-section ui-mt-2">{{L.k76}}</text>
          <input class="field__input" value="{{menu.names}}" placeholder="{{L.k77}}" bindinput="onMenuNames" />
          <view class="row-actions">
            <pv-button type="filled" loading="{{sending}}" disabled="{{sending}}" bind:tap="saveMenu">{{L.k78}}</pv-button>
            <pv-button size="sm" type="plain" data-type="menu" bind:tap="openImport">{{L.k30}}</pv-button>
          </view>
        </pv-card>

        <text class="ui-section ui-mt-2">本週已排（{{menuWeekStart}} 起）</text>
        <view wx:if="{{menuEntries.length}}" class="ui-list ui-list--grouped">
          <view wx:for="{{menuEntries}}" wx:key="id" class="signup-row {{index === menuEntries.length - 1 ? 'signup-row--last' : ''}}">
            <text class="signup-row__name">{{item.date}} · {{item.mealType === 'LUNCH' ? L.k122 : L.k123}} · {{item.dishName}}</text>
            <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="deleteMenuEntry">{{L.k79}}</pv-button>
          </view>
        </view>
        <pv-empty wx:if="{{!menuEntries.length}}" title="{{L.k80}}" desc="" />
      </block>

      <!-- 圖書館（W-66）：館藏登記與借閱紀錄兩個子模式 -->
      <block wx:elif="{{tab === 'library'}}">
        <view class="filter-row">
          <view
            wx:for="{{libModes}}"
            wx:key="key"
            class="chip {{libMode === item.key ? 'chip--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchLibMode"
          >{{item.label}}</view>
        </view>

        <block wx:if="{{libMode === 'books'}}">
          <pv-card>
            <view class="ui-row-between">
              <text class="ui-title">{{libForm.id ? L.k273 : L.k272}}</text>
              <pv-button wx:if="{{libForm.id}}" size="sm" type="plain" bind:tap="libResetForm">{{L.k283}}</pv-button>
            </view>

            <text class="ui-section ui-mt-2">{{L.k274}}</text>
            <input class="field__input" value="{{libForm.title}}" data-field="title" bindinput="onLibField" />

            <view class="ui-row-between ui-mt-2">
              <text class="ui-section">{{L.k275}}</text>
              <view class="lib-scan" bindtap="libScan">{{L.k282}}</view>
            </view>
            <input class="field__input" value="{{libForm.isbn}}" data-field="isbn" bindinput="onLibField" />

            <text class="ui-section ui-mt-2">{{L.k276}}</text>
            <input class="field__input" value="{{libForm.author}}" data-field="author" bindinput="onLibField" />

            <view class="lib-two">
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k277}}</text>
                <input class="field__input" value="{{libForm.category}}" data-field="category" bindinput="onLibField" />
              </view>
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k278}}</text>
                <input class="field__input" value="{{libForm.callNumber}}" data-field="callNumber" bindinput="onLibField" />
              </view>
            </view>

            <view class="lib-two">
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k279}}</text>
                <input class="field__input" type="number" value="{{libForm.totalCopies}}" data-field="totalCopies" bindinput="onLibField" />
              </view>
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k280}}</text>
                <input class="field__input" type="number" value="{{libForm.loanDays}}" data-field="loanDays" bindinput="onLibField" />
              </view>
            </view>

            <view class="row-actions">
              <pv-button type="filled" loading="{{libSaving}}" disabled="{{libSaving}}" bind:tap="libSave">{{L.k281}}</pv-button>
            </view>
          </pv-card>

          <view wx:if="{{libBooks.length}}" class="ui-list ui-list--grouped">
            <view wx:for="{{libBooks}}" wx:key="id" class="signup-row {{index === libBooks.length - 1 ? 'signup-row--last' : ''}}">
              <view class="lib-row">
                <view class="lib-row__main">
                  <text class="signup-row__name">{{item.title}}</text>
                  <text class="ui-meta">{{item.stockText}}</text>
                </view>
                <view class="row-actions">
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="libEdit">{{L.k284}}</pv-button>
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" data-archived="{{item.status === 'ACTIVE'}}" bind:tap="libArchive">{{item.status === 'ACTIVE' ? L.k285 : L.k286}}</pv-button>
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" data-title="{{item.title}}" bind:tap="libDelete">{{L.k287}}</pv-button>
                </view>
              </view>
            </view>
          </view>
          <pv-empty wx:else title="{{L.k288}}" desc="{{L.k289}}" />
        </block>

        <block wx:else>
          <view class="ui-row-between">
            <text class="ui-meta">{{L.k290}} {{libSummary.active}} · {{L.k291}} {{libSummary.overdue}}</text>
            <pv-button size="sm" type="tinted" bind:tap="libRemind">{{L.k294}}</pv-button>
          </view>

          <view class="filter-row">
            <view
              wx:for="{{libStatuses}}"
              wx:key="key"
              class="chip {{libStatus === item.key ? 'chip--on' : ''}}"
              data-key="{{item.key}}"
              bindtap="pickLibStatus"
            >{{item.label}}</view>
          </view>

          <view wx:if="{{libLoans.length}}" class="ui-list ui-list--grouped">
            <view wx:for="{{libLoans}}" wx:key="id" class="signup-row {{index === libLoans.length - 1 ? 'signup-row--last' : ''}}">
              <view class="lib-row">
                <view class="lib-row__main">
                  <text class="signup-row__name">{{item.book.title}}</text>
                  <text class="ui-meta">{{item.user.nickname}} · {{item.dueText}}</text>
                  <text class="ui-meta">{{item.statusLabel}}</text>
                </view>
                <view wx:if="{{!item.returnedAt}}" class="row-actions">
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="libReturn">{{L.k293}}</pv-button>
                </view>
              </view>
            </view>
          </view>
          <pv-empty wx:else title="{{L.k296}}" desc="" />
        </block>
      </block>

      <block wx:elif="{{tab === 'giveaways'}}">
        <view class="stat-grid">
          <view class="stat"><text class="stat__num ui-num">{{gvStats.available}}</text><text class="stat__label">{{L.k330}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{gvStats.given}}</text><text class="stat__label">{{L.k335}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{gvStats.closed}}</text><text class="stat__label">{{L.k332}}</text></view>
          <view class="stat"><text class="stat__num ui-num">{{gvStats.pendingRequests}}</text><text class="stat__label">{{L.k334}}</text></view>
        </view>

        <view class="filter-row">
          <view
            wx:for="{{gvStatuses}}"
            wx:key="key"
            class="chip {{gvStatus === item.key ? 'chip--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchGvStatus"
          >{{item.label}}</view>
        </view>

        <view wx:if="{{gvItems.length}}" class="ui-list ui-list--grouped">
          <view
            wx:for="{{gvItems}}"
            wx:key="id"
            class="signup-row {{index === gvItems.length - 1 ? 'signup-row--last' : ''}}"
          >
            <view class="lib-row">
              <view class="lib-row__main">
                <text class="signup-row__name">{{item.title}}</text>
                <text class="ui-meta">{{item.kindText}} · {{item.metaText}}</text>
                <text class="ui-meta">{{item.ownerNickname}}<block wx:if="{{item.ownerClass}}"> · {{item.ownerClass}}</block></text>
                <text class="ui-meta">{{item.applyText}}</text>
              </view>
              <view class="row-actions">
                <pv-tag text="{{item.statusText}}" type="{{item.statusTag}}" />
                <pv-button
                  wx:if="{{item.status !== 'GIVEN'}}"
                  size="sm"
                  type="plain"
                  data-id="{{item.id}}"
                  data-next="{{item.status === 'CLOSED' ? 'AVAILABLE' : 'CLOSED'}}"
                  data-title="{{item.title}}"
                  bind:tap="gvToggle"
                >{{item.status === 'CLOSED' ? L.k332 : L.k331}}</pv-button>
              </view>
            </view>
          </view>
        </view>
        <pv-empty wx:else title="{{L.k333}}" desc="" />
      </block>

      <!-- W-72 假單：待審批優先，一手批／駁；駁回要寫原因（會通知家長與學生） -->
      <block wx:elif="{{tab === 'leaves'}}">
        <view class="filter-row">
          <view
            wx:for="{{leaveStatuses}}"
            wx:key="key"
            class="chip {{leaveStatus === item.key ? 'chip--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchLeaveStatus"
          >{{item.label}}{{item.key === 'PENDING' && leaveCounts.PENDING ? ' ' + leaveCounts.PENDING : ''}}</view>
        </view>

        <view wx:if="{{leaveItems.length}}" class="ui-list ui-list--grouped">
          <view
            wx:for="{{leaveItems}}"
            wx:key="id"
            class="signup-row {{index === leaveItems.length - 1 ? 'signup-row--last' : ''}}"
          >
            <view class="lib-row">
              <view class="lib-row__main">
                <text class="signup-row__name">{{item.student.nickname}} · {{item.kindText}}</text>
                <text class="ui-meta">{{item.dateText}} · {{item.days}} {{L.k345}}</text>
                <text wx:if="{{item.createdById !== item.studentId}}" class="ui-meta">{{L.k346}}</text>
                <text class="ui-meta">{{item.reason}}</text>
                <text wx:if="{{item.rejectReason}}" class="ui-meta">{{item.rejectReason}}</text>
              </view>
              <view wx:if="{{item.status === 'PENDING'}}" class="row-actions">
                <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="leaveApprove">{{L.k303}}</pv-button>
                <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="leaveReject">{{L.k304}}</pv-button>
              </view>
              <pv-tag wx:else text="{{item.statusText}}" type="{{item.statusTone}}" />
            </view>
          </view>
        </view>
        <pv-empty wx:else title="{{L.k337}}" desc="{{L.k338}}" />
      </block>

      <block wx:elif="{{tab === 'venues'}}">
        <view class="filter-row">
          <view
            wx:for="{{venModes}}"
            wx:key="key"
            class="chip {{venMode === item.key ? 'chip--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="switchVenMode"
          >{{item.label}}</view>
        </view>

        <block wx:if="{{venMode === 'pending'}}">
          <view wx:if="{{venPending.length}}" class="ui-list ui-list--grouped">
            <view
              wx:for="{{venPending}}"
              wx:key="id"
              class="signup-row {{index === venPending.length - 1 ? 'signup-row--last' : ''}}"
            >
              <view class="lib-row">
                <view class="lib-row__main">
                  <text class="signup-row__name">{{item.resource.name}}</text>
                  <text class="ui-meta">{{item.dateText}} {{item.timeText}}</text>
                  <text class="ui-meta">{{L.k302}} {{item.user.nickname}}</text>
                  <text class="ui-meta">{{L.k328}} {{item.purpose}}</text>
                </view>
                <view class="row-actions">
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="venApprove">{{L.k303}}</pv-button>
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="venReject">{{L.k304}}</pv-button>
                </view>
              </view>
            </view>
          </view>
          <pv-empty wx:else title="{{L.k305}}" desc="" />

          <block wx:if="{{venHandled.length}}">
            <text class="group-sub">{{L.k306}}</text>
            <view class="ui-list ui-list--grouped">
              <view
                wx:for="{{venHandled}}"
                wx:key="id"
                class="signup-row {{index === venHandled.length - 1 ? 'signup-row--last' : ''}}"
              >
                <view class="lib-row">
                  <view class="lib-row__main">
                    <text class="signup-row__name">{{item.resource.name}}</text>
                    <text class="ui-meta">{{item.dateText}} {{item.timeText}} · {{item.user.nickname}}</text>
                    <text wx:if="{{item.rejectReason}}" class="ui-meta">{{item.rejectReason}}</text>
                  </view>
                  <pv-tag text="{{item.statusLabel}}" type="{{item.status === 'APPROVED' ? 'success' : 'neutral'}}" />
                </view>
              </view>
            </view>
          </block>
        </block>

        <block wx:else>
          <pv-card>
            <view class="ui-row-between">
              <text class="ui-title">{{venForm.id ? L.k308 : L.k307}}</text>
              <pv-button wx:if="{{venForm.id}}" size="sm" type="plain" bind:tap="venResetForm">{{L.k307}}</pv-button>
            </view>

            <view class="filter-row filter-row--tight">
              <picker mode="selector" range="{{venKindLabels}}" value="{{venForm.kind === 'EQUIPMENT' ? 1 : 0}}" bindchange="venKindChange">
                <view class="chip chip--on">{{venForm.kind === 'EQUIPMENT' ? L.k327 : L.k326}}</view>
              </picker>
            </view>

            <text class="ui-section ui-mt-2">{{L.k309}}</text>
            <input class="field__input" value="{{venForm.name}}" data-field="name" bindinput="onVenField" />

            <text class="ui-section ui-mt-2">{{L.k310}}</text>
            <input class="field__input" value="{{venForm.location}}" data-field="location" bindinput="onVenField" />

            <view class="lib-two">
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k311}}</text>
                <input class="field__input" value="{{venForm.openFrom}}" data-field="openFrom" bindinput="onVenField" />
              </view>
              <view class="lib-two__col">
                <text class="ui-section ui-mt-2">{{L.k312}}</text>
                <input class="field__input" type="number" value="{{venForm.maxHours}}" data-field="maxHours" bindinput="onVenField" />
              </view>
            </view>

            <text class="ui-section ui-mt-2">{{L.k311}}</text>
            <input class="field__input" value="{{venForm.openTo}}" data-field="openTo" bindinput="onVenField" />

            <view class="filter-row filter-row--tight">
              <view class="chip {{venForm.needsApproval ? 'chip--on' : ''}}" data-v="1" bindtap="venSetApproval">{{L.k313}}</view>
              <view class="chip {{!venForm.needsApproval ? 'chip--on' : ''}}" data-v="0" bindtap="venSetApproval">{{L.k329}}</view>
            </view>

            <view class="row-actions">
              <pv-button type="filled" loading="{{venSaving}}" disabled="{{venSaving}}" bind:tap="venSave">{{L.k299}}</pv-button>
            </view>
          </pv-card>

          <view wx:if="{{venResources.length}}" class="ui-list ui-list--grouped">
            <view
              wx:for="{{venResources}}"
              wx:key="id"
              class="signup-row {{index === venResources.length - 1 ? 'signup-row--last' : ''}}"
            >
              <view class="lib-row">
                <view class="lib-row__main">
                  <text class="signup-row__name">{{item.name}}</text>
                  <text class="ui-meta">{{item.kindLabel}} · {{item.hoursText}} · {{L.k312}} {{item.maxHours}}</text>
                  <text class="ui-meta">{{item.needsApproval ? L.k313 : L.k329}}</text>
                </view>
                <view class="row-actions">
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" bind:tap="venEdit">{{L.k308}}</pv-button>
                  <pv-button size="sm" type="plain" data-id="{{item.id}}" data-name="{{item.name}}" bind:tap="venArchive">{{L.k314}}</pv-button>
                </view>
              </view>
            </view>
          </view>
          <pv-empty wx:else title="{{L.k315}}" desc="{{L.k316}}" />
        </block>
      </block>

      <!-- 批次匯入（活動／菜單共用同一塊面板） -->
      <pv-card wx:if="{{importType}}">
        <view class="ui-row-between">
          <text class="ui-title">批次匯入{{importType === 'menu' ? L.k124 : L.k125}}</text>
          <pv-button size="sm" type="plain" bind:tap="closeImport">{{L.k36}}</pv-button>
        </view>
        <text class="ui-meta imp-hint">{{importHint}}</text>
        <textarea
          class="field__input field__textarea field__gap"
          value="{{importCsv}}"
          bindinput="onImportText"
          maxlength="-1"
          placeholder="{{L.k81}}"
        />
        <view class="row-actions">
          <pv-button size="sm" type="plain" bind:tap="pickCsvFile">{{L.k82}}</pv-button>
          <pv-button size="sm" type="plain" loading="{{importBusy}}" disabled="{{importBusy}}" bind:tap="checkImport">{{L.k83}}</pv-button>
          <pv-button size="sm" type="filled" loading="{{importBusy}}" disabled="{{importBusy || !importChecked}}" bind:tap="confirmImport">{{L.k84}}</pv-button>
        </view>
        <view wx:if="{{importResult}}">
          <text class="ui-meta imp-sum">共 {{importResult.total}} 列：可寫入 {{importResult.success}}｜有問題 {{importResult.failed}}</text>
          <view wx:for="{{importResult.rows}}" wx:key="line" class="imp-row">
            <text class="imp-row__line">第 {{item.line}} 列</text>
            <text class="imp-row__msg {{item.ok ? 'imp-row__msg--ok' : 'imp-row__msg--bad'}}">{{item.message}}{{item.label ? '：' + item.label : ''}}</text>
          </view>
        </view>
      </pv-card>

      <text wx:if="{{hint}}" class="ui-meta hint">{{hint}}</text>
    </view>
  </scroll-view>
</view>
