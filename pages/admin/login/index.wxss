@import "../../../styles/tokens.wxss";
@import "../../../styles/ui.wxss";

.login-inner { padding: var(--pv-sp-4) var(--pv-sp-3) var(--pv-sp-6); }
.login-head { margin-bottom: var(--pv-sp-3); }
.login-title { display: block; font-size: var(--pv-fs-title-1); font-weight: 700; letter-spacing: var(--pv-ls-title); }
.field { margin-bottom: var(--pv-sp-2); }
.field__label { display: block; font-size: var(--pv-fs-footnote); color: var(--pv-label-2); margin-bottom: 6rpx; }
.field__input {
  padding: 20rpx var(--pv-sp-3);
  background: var(--pv-fill);
  border-radius: var(--pv-r-sm);
  font-size: var(--pv-fs-body);
}
.login-actions { margin-top: var(--pv-sp-3); }
.login-error { display: block; margin-top: var(--pv-sp-2); color: var(--pv-danger); font-size: var(--pv-fs-subhead); }
.login-current {
  display: flex; flex-direction: row; align-items: center; justify-content: space-between;
  margin-top: var(--pv-sp-3); padding: 0 var(--pv-sp-2);
}
