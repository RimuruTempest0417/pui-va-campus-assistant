<view class="ui-page page-root">
  <pv-navbar title="登入" back="{{true}}" />

  <scroll-view class="page-scroll" scroll-y bounces show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="login-inner">
      <view class="login-head">
        <text class="login-title">培華校園助手</text>
      </view>

      <pv-card>
        <!-- 用原生 form + 原生 button：不再經過自訂組件的 tap，也不用靠 bindinput 把值搬進 data
             （Skyline 下自訂組件偶發收不到 tap／受控 input 值不同步，兩者都會讓「登入」看起來沒反應） -->
        <form bindsubmit="onSubmit">
          <view class="field">
            <text class="field__label">帳號</text>
            <input class="field__input" name="account" value="{{account}}" placeholder="例如 3201201001" bindinput="onAccount" />
          </view>
          <view class="field">
            <text class="field__label">密碼</text>
            <input class="field__input" name="password" value="{{password}}" password placeholder="請輸入密碼"
                   bindinput="onPassword" bindconfirm="submit" confirm-type="done" />
          </view>

          <view class="login-actions">
            <button class="login-btn" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">
              {{submitting ? '登入中…' : '登入'}}
            </button>
          </view>
        </form>

        <text wx:if="{{error}}" class="login-error">{{error}}</text>
      </pv-card>

      <view wx:if="{{currentRole}}" class="login-current">
        <text class="ui-meta">目前身分：{{currentName}}（{{currentRole}}）</text>
        <pv-button type="plain" size="sm" bind:tap="logout">登出</pv-button>
      </view>
    </view>
  </scroll-view>
</view>
